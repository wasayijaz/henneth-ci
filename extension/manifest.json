{
  "manifest_version": 3,
  "name": "Henneth Desk Companion",
  "version": "0.2.0",
  "description": "PSX research companion - the desk's read for the ticker you're looking at. Research only, never places orders.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Henneth Desk Companion"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://desk.henneth.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://desk.henneth.app/*"
      ],
      "js": [
        "auth.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tradingview.com/*",
        "https://in.tradingview.com/*",
        "https://dps.psx.com.pk/*",
        "https://www.dawn.com/*",
        "https://profit.pk/*",
        "https://www.brecorder.com/*",
        "https://tribune.com.pk/*",
        "https://mettisglobal.com/*",
        "https://www.thenews.com.pk/*"
      ],
      "js": [
        "detector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
