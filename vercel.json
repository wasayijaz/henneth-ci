{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo no-deps",
  "buildCommand": "sh scripts/vercel_build.sh",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- dashboard/ state/ api/ middleware.js scripts/vercel_build.sh vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/today", "dest": "/index.html" },
    { "src": "/board", "dest": "/index.html" },
    { "src": "/watchlist", "dest": "/index.html" },
    { "src": "/portfolio", "dest": "/index.html" },
    { "src": "/settings", "dest": "/index.html" },
    { "src": "/practice", "dest": "/index.html" },
    { "src": "/strategies", "dest": "/index.html" },
    { "src": "/value", "dest": "/index.html" },
    { "src": "/screener", "dest": "/index.html" },
    { "src": "/compare", "dest": "/index.html" },
    { "src": "/scenarios", "dest": "/index.html" },
    { "src": "/research", "dest": "/index.html" },
    { "src": "/sectors", "dest": "/index.html" },
    { "src": "/leaderboard", "dest": "/index.html" },
    { "src": "/news", "dest": "/index.html" },
    { "src": "/macro", "dest": "/index.html" },
    { "src": "/dividends", "dest": "/index.html" },
    { "src": "/calendar", "dest": "/index.html" },
    { "src": "/astro", "dest": "/index.html" },
    { "src": "/market", "dest": "/index.html" },
    { "src": "/tools", "dest": "/index.html" },
    { "src": "/ask", "dest": "/index.html" },
    { "src": "/learn", "dest": "/index.html" },
    { "src": "/plans", "dest": "/index.html" },
    { "src": "/cast", "dest": "/index.html" },
    { "src": "/mychart", "dest": "/index.html" },
    { "src": "/glossary", "dest": "/index.html" },
    { "src": "/shipped", "dest": "/index.html" },
    { "src": "/unsubscribe", "dest": "/index.html" },
    { "src": "/ticker/([^/]+)", "dest": "/index.html" },
    { "src": "/legal/([^/]+)", "dest": "/index.html" },
    { "handle": "filesystem" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/state/(.*)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=900" }]
    }
  ]
}
