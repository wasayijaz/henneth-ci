{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo no-deps",
  "buildCommand": "sh scripts/vercel_build.sh",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- dashboard/ state/ api/ middleware.js scripts/vercel_build.sh vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/today", "destination": "/index.html" },
    { "source": "/board", "destination": "/index.html" },
    { "source": "/watchlist", "destination": "/index.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/practice", "destination": "/index.html" },
    { "source": "/strategies", "destination": "/index.html" },
    { "source": "/value", "destination": "/index.html" },
    { "source": "/screener", "destination": "/index.html" },
    { "source": "/compare", "destination": "/index.html" },
    { "source": "/scenarios", "destination": "/index.html" },
    { "source": "/research", "destination": "/index.html" },
    { "source": "/sectors", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/news", "destination": "/index.html" },
    { "source": "/macro", "destination": "/index.html" },
    { "source": "/dividends", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/astro", "destination": "/index.html" },
    { "source": "/market", "destination": "/index.html" },
    { "source": "/tools", "destination": "/index.html" },
    { "source": "/ask", "destination": "/index.html" },
    { "source": "/learn", "destination": "/index.html" },
    { "source": "/plans", "destination": "/index.html" },
    { "source": "/cast", "destination": "/index.html" },
    { "source": "/mychart", "destination": "/index.html" },
    { "source": "/glossary", "destination": "/index.html" },
    { "source": "/shipped", "destination": "/index.html" },
    { "source": "/unsubscribe", "destination": "/index.html" },
    { "source": "/ticker/:symbol", "destination": "/index.html" },
    { "source": "/legal/:document", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    {
      "source": "/(.*)\\.(png|svg|ico|webmanifest)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/state/(.*)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=900" }]
    }
  ]
}
