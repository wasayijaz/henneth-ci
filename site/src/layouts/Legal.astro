---
import Base from './Base.astro';
import { site } from '../site.config.ts';

interface Props { title: string; tab: 'terms' | 'privacy' | 'disclosures'; path: string }
const { title, tab, path } = Astro.props;

const tabs = [
  { k: 'terms', label: 'Terms of service', href: '/legal/terms' },
  { k: 'privacy', label: 'Privacy policy', href: '/legal/privacy' },
  { k: 'disclosures', label: 'Disclosures', href: '/legal/disclosures' },
];
---

<Base title={title} path={path} noindex={true} description={`${title} — ${site.name}.`}>
  <section class="section-tight">
    <div class="wrap">
      <p class="kicker">Legal</p>
      <h1>{title}</h1>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap lg-grid">
      <nav class="lg-rail" aria-label="Legal sections">
        {tabs.map((t) => (
          <a href={t.href} class:list={['lg-tab', { on: t.k === tab }]}>{t.label}</a>
        ))}
      </nav>

      <div class="lg-body">
        <div class="lg-callout">
          <b>Draft — pending legal review.</b> This document is a placeholder. Final wording will be
          reviewed by a Pakistan-licensed lawyer before any paid plan opens.
        </div>
        <slot />
        <p class="lg-contact muted">
          Questions: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .lg-grid { display: grid; grid-template-columns: 240px 1fr; gap: 40px; align-items: start; }
  .lg-rail { position: sticky; top: 76px; border: var(--rule); background: var(--panel); }
  .lg-tab {
    display: block; padding: 13px 14px; font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.07em; text-decoration: none; border-bottom: 1px dotted var(--hair);
  }
  .lg-tab:last-child { border-bottom: 0; }
  .lg-tab:hover { background: var(--panel-2); }
  .lg-tab.on { background: var(--ink-1); color: var(--bg); font-weight: 700; }

  .lg-body { border: var(--rule); background: var(--panel); padding: 26px; max-width: 760px; }
  .lg-callout {
    border-left: 1.5px solid var(--dn); padding: 12px 14px; margin-bottom: 24px;
    background: var(--panel-2); font-size: 11px; line-height: 1.7;
  }
  .lg-body :global(h2) { font-size: 13px; margin: 26px 0 8px; }
  .lg-body :global(h2:first-of-type) { margin-top: 0; }
  .lg-body :global(p) { font-size: 11.5px; line-height: 1.8; color: var(--ink-2); }
  .lg-contact { font-size: 10.5px; margin-top: 28px; }

  @media (max-width: 860px) {
    .lg-grid { grid-template-columns: 1fr; }
    .lg-rail { position: static; }
  }
</style>
