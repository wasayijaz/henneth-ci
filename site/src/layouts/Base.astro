---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  active?: string;
}

const {
  title,
  description = site.description,
  path = '',
  noindex = false,
  active = '',
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(path, site.url).href;
// PNG, not the old og-default.svg: no social scraper renders SVG. X, WhatsApp, LinkedIn and
// Slack all silently dropped the card and showed a bare link. 1200x630 is the 1.91:1 that
// summary_large_image crops to, so nothing is cut off.
const ogImage = new URL('/og.png', site.url).href;
const ogImageAlt = `${site.appName} — a retro terminal displaying H_, above the wordmark ${site.appName} and the line "Research. Not advice."`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  // `logo` is what Google reads for the knowledge panel / rich-result brand mark. It wants a
  // real raster it can crop, so this points at the icon PNG rather than the SVG wordmark.
  logo: new URL('/icon-512.png', site.url).href,
  image: ogImage,
  email: site.contactEmail,
  sameAs: [site.social.x],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description: site.description,
  url: site.appUrl,
  image: ogImage,
  // Price 0 is accurate only while site.earlyAccess is true. If that flag flips and this stays,
  // the structured data advertises a free product that now charges — a rich-result penalty and,
  // more importantly, a false claim to anyone reading the card.
  offers: site.earlyAccess
    ? { '@type': 'Offer', price: '0', priceCurrency: 'PKR', availability: 'https://schema.org/InStock' }
    : undefined,
  // Named plainly in the structured data too, not only in the page copy — the desk is research
  // tooling, and nothing in the machine-readable layer should imply advice.
  disambiguatingDescription:
    'Educational research and analytics tooling. Not an investment adviser; provides no personalised advice and places no orders.',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* max-image-preview:large is what lets Google show the OG card in Discover and rich results
        instead of a thumbnail; the unreviewed legal drafts still opt out entirely via noindex. */}
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Dimensions are not decoration: without them a scraper must fetch the image before it can
        lay the card out, and several (WhatsApp especially) give up first and render no preview. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MWasayI" />
    <meta name="twitter:creator" content="@MWasayI" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons. SVG first (sharp at every size, dark-mode aware); the PNGs are for the clients
         that ignore it — Safari's home screen and the web-app manifest. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#151515" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Pixelify+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />

    {/* Google tag (gtag.js) — production builds only, so `npm run dev` traffic
        never reaches the property. `is:inline` is required: without it Astro
        bundles the tags, which breaks gtag's global + script ordering.
        `window.gtag = gtag` is deliberate: define:vars wraps the body in an
        IIFE, so gtag would otherwise be function-scoped and later conversion
        events would throw. Keep the body free of `//` comments — the output is
        minified onto one line, so a line comment silently kills everything
        after it. */}
    {
      import.meta.env.PROD && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4}`}
          />
          <script is:inline define:vars={{ gaId: site.analytics.ga4 }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
