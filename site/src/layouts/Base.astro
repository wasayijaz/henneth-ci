---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import PostHog from '../components/posthog.astro';
import { site } from '../site.config.ts';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  active?: string;
  /** 'article' on blog posts so the OG card renders as an article, not a product page. */
  ogType?: string;
  /**
   * Question/answer pairs that appear VERBATIM in the page body. Emits FAQPage schema.
   * Google's guideline is explicit that the marked-up answer must be the visible answer, so a page
   * may only pass this if it actually renders the same text — schema written for the crawler alone
   * is a manual-action risk, not a shortcut.
   */
  faq?: { q: string; a: string }[];
  /**
   * Overrides the last breadcrumb's name. Needed where `title` is a long search-facing title
   * ("Position Size Calculator PSX — Shares by Risk and Stop Loss") but the trail should end in the
   * short label a reader sees in the <h1>.
   */
  crumbLeaf?: string;
}

const {
  title,
  description = site.description,
  path = '',
  noindex = false,
  active = '',
  ogType = 'website',
  faq,
  crumbLeaf,
} = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;

// Astro builds directory-style (`/blog/` → `blog/index.html`) and @astrojs/sitemap emits those
// URLs WITH a trailing slash. A canonical without one is therefore a different URL than the one
// we submit, which Search Console reports as "Alternate page with proper canonical tag" and which
// splits signals between the two forms. Normalising here keeps canonical == sitemap == served URL.
// The root is already '/' and must not become '//'.
const canonicalUrl = new URL(path, site.url);
if (!canonicalUrl.pathname.endsWith('/')) canonicalUrl.pathname += '/';
const canonical = canonicalUrl.href;
// PNG, not the old og-default.svg: no social scraper renders SVG. X, WhatsApp, LinkedIn and
// Slack all silently dropped the card and showed a bare link. 1200x630 is the 1.91:1 that
// summary_large_image crops to, so nothing is cut off.
/* JPEG, not PNG. The brand card is 1200x630 of photographic artwork: as a PNG it weighs 668 KB,
   as a q90 JPEG 88 KB with no visible loss. That matters because several scrapers — WhatsApp
   most strictly — quietly skip a preview image over a few hundred KB, so the heavier file was
   costing exactly the previews this is for. og.png is left in place, same artwork, so anything
   that already cached the old URL still resolves. */
const ogImage = new URL('/og.jpg', site.url).href;
const ogImageAlt = `${site.appName} — a retro terminal displaying H_, above the wordmark ${site.appName} and the line "Research. Not advice."`;

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  description: site.description,
  // `logo` is what Google reads for the knowledge panel / rich-result brand mark. It wants a
  // real raster it can crop, so this points at the icon PNG rather than the SVG wordmark.
  logo: new URL('/icon-512.png', site.url).href,
  image: ogImage,
  email: site.contactEmail,
  sameAs: [site.social.x],
  // Ties the brand entity to the person behind it, which is the same link the article bylines
  // make. Without it the two are unrelated nodes and neither reinforces the other.
  founder: { '@type': 'Person', name: site.author.name, url: site.author.url },
  // What this entity is actually about. Cheap, true, and it is the field that disambiguates a
  // five-letter invented brand name from every other thing called Henneth.
  knowsAbout: [
    'Pakistan Stock Exchange',
    'KSE-100 Index',
    'Equity research',
    'Dividend investing',
    'Fundamental analysis',
    'Technical analysis',
    'Backtesting',
  ],
};
const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  description: site.description,
  url: site.appUrl,
  image: ogImage,
  // Price 0 is accurate only while site.earlyAccess is true. If that flag flips and this stays,
  // the structured data advertises a free product that now charges — a rich-result penalty and,
  // more importantly, a false claim to anyone reading the card.
  offers: site.earlyAccess
    ? { '@type': 'Offer', price: '0', priceCurrency: 'PKR', availability: 'https://schema.org/InStock' }
    : undefined,
  // Named plainly in the structured data too, not only in the page copy — the desk is research
  // tooling, and nothing in the machine-readable layer should imply advice.
  disambiguatingDescription:
    'Educational research and analytics tooling. Not an investment adviser; provides no personalised advice and places no orders.',
};

/* BREADCRUMBS — derived from `path`, never hand-written per page.
   Two reasons it lives here rather than in each page: a breadcrumb that disagrees with the URL is
   worse than none (Google drops the whole trail), and the site already has three nested families
   (/solutions/*, /tools/*, /legal/*) that would each have to remember. Deriving it means a new page
   gets the trail by existing.
   The visible <nav> is NOT emitted — the trail is short and the header carries the same hierarchy —
   but the crumb NAMES are the words already on screen (the nav label for a section, the page's own
   <title> for the leaf), so the markup still describes what a reader sees. */
const CRUMB_LABELS: Record<string, string> = {
  solutions: 'Solutions',
  tools: 'Calculators',
  legal: 'Legal',
  blog: 'Blog',
  research: 'Research',
  features: 'Features',
  plans: 'Plans',
  psx: 'PSX companies',
};
/* Slug → words, with the acronyms this desk uses left upper-case. Without this, "psx-screener"
   becomes "Psx screener", which reads as a typo in a rich result. */
const ACRONYMS: Record<string, string> = { psx: 'PSX', us: 'US', sip: 'SIP', cgt: 'CGT', etf: 'ETF' };
const prettify = (slug: string): string =>
  slug
    .split('-')
    .map((w, i) => ACRONYMS[w] ?? (i === 0 ? w.charAt(0).toUpperCase() + w.slice(1) : w))
    .join(' ');
const segments = canonicalUrl.pathname.split('/').filter(Boolean);
const breadcrumbLd = segments.length && !noindex
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site.url).href },
        ...segments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          // The leaf takes `crumbLeaf` if given, else the page's own title, so the trail ends in
          // words a reader has seen rather than a de-slugged guess. Ancestors take the nav label.
          name:
            i === segments.length - 1 && (crumbLeaf || title)
              ? crumbLeaf || title
              : (CRUMB_LABELS[seg] ?? prettify(seg)),
          item: new URL(segments.slice(0, i + 1).join('/') + '/', site.url).href,
        })),
      ],
    }
  : undefined;

const faqLd = faq?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* max-image-preview:large is what lets Google show the OG card in Discover and rich results
        instead of a thumbnail; the unreviewed legal drafts still opt out entirely via noindex. */}
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* Dimensions are not decoration: without them a scraper must fetch the image before it can
        lay the card out, and several (WhatsApp especially) give up first and render no preview. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MWasayI" />
    <meta name="twitter:creator" content="@MWasayI" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Icons. SVG first (sharp at every size, dark-mode aware); the PNGs are for the clients
         that ignore it — Safari's home screen and the web-app manifest. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#151515" />
    <meta name="apple-mobile-web-app-title" content={site.name} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Pixelify+Sans:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

    {/* Google tag (gtag.js). `is:inline` is required: without it Astro bundles the tag, which
        breaks gtag's global + script ordering. `window.gtag = gtag` is deliberate: define:vars
        wraps the body in an IIFE, so gtag would otherwise be function-scoped and the conversion
        events below would throw. Keep the body free of `//` comments — the output can be
        collapsed onto one line, and a line comment would silently kill everything after it.

        TWO guards, because `import.meta.env.PROD` alone was not enough. It is a BUILD-time flag,
        true for every production build regardless of where that build ends up running — so the
        tag also fired on `npm run preview`, on any locally served `dist/`, and, most expensively,
        on every Vercel preview deployment (*.vercel.app builds in production mode). All of that
        landed in the same property as real traffic and quietly inflated it.
        The hostname check is the runtime half: hits count only from the live domain. Same guard
        the desk uses, for the same reason. gtag.js is injected rather than written as a <script
        src> so the request itself is skipped too, not just the config call. */}
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ gaId: site.analytics.ga4, liveHost: new URL(site.url).hostname }}>
          if (location.hostname === liveHost || location.hostname === 'www.' + liveHost) {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
            document.head.appendChild(s);
            window.dataLayer = window.dataLayer || [];
            window.gtag = function(){dataLayer.push(arguments);};
            gtag('js', new Date());
            gtag('config', gaId, { transport_type: 'beacon' });
          }
        </script>
      )
    }

    {import.meta.env.PROD && <PostHog />}

    {/* Conversion tracking. Defined in EVERY build, not just PROD: `window.hTrack` has to exist
        in dev too, otherwise a page that calls it throws a ReferenceError locally and the failure
        only shows up in production. It no-ops when gtag is absent, which is exactly dev.

        The click handler is delegated off document rather than bound per element so that links
        rendered later (the mobile drawer, plan cards) are covered without every component having
        to remember to wire itself up. Three things are tracked:
          - any link into the desk           -> `desk_click`, carrying the ?plan= intent
          - any mailto:                      -> `contact_click`
          - anything with data-ev="name"     -> that event, with data-ev-* as parameters
        `desk_click` is the one that matters: it is the last thing we can see before the visitor
        crosses to desk.henneth.app, so it is the closest proxy to a signup that the marketing
        property can measure on its own.

        BOUND ON `pointerdown` AS WELL AS `click`, which is not belt-and-braces — it is the fix
        for a real miss. A click on a desk link starts navigating immediately, and the hit was
        dying with the page before gtag could dispatch it: GA4 logged 24 page_views and zero
        desk_clicks over the same two days. `pointerdown` fires earlier in the interaction, before
        the browser begins tearing the page down, which is what buys gtag the time to send.
        `click` is kept because pointerdown never fires for keyboard activation, and a visitor
        tabbing to a link and pressing Enter is still a conversion. `lastEl`/`lastAt` dedupe the
        two so one interaction is one event, not two.

        Same `//`-comment hazard as the gtag block above — this is minified onto one line, so a
        line comment would silently kill everything after it. Block comments only. */}
    <script is:inline define:vars={{ deskOrigin: site.appUrl }}>
      window.hTrack = function (name, params) {
        if (typeof window.gtag === 'function') window.gtag('event', name, params || {});
      };
      var lastEl = null, lastAt = 0;
      function hHandle(e) {
        var a = e.target && e.target.closest ? e.target.closest('a, button') : null;
        if (!a) return;
        var now = Date.now();
        if (a === lastEl && now - lastAt < 1000) return;
        lastEl = a; lastAt = now;
        if (a.dataset && a.dataset.ev) {
          var p = {};
          for (var k in a.dataset) if (k.indexOf('ev') === 0 && k !== 'ev') p[k.slice(2).toLowerCase()] = a.dataset[k];
          window.hTrack(a.dataset.ev, p);
          return;
        }
        var href = a.getAttribute ? a.getAttribute('href') : null;
        if (!href) return;
        if (href.indexOf('mailto:') === 0) {
          window.hTrack('contact_click', { link_url: href });
          return;
        }
        if (href.indexOf(deskOrigin) === 0) {
          var plan = '';
          try { plan = new URL(href).searchParams.get('plan') || ''; } catch (err) { plan = ''; }
          window.hTrack('desk_click', { plan: plan, link_url: href, page_path: location.pathname });
        }
      }
      document.addEventListener('pointerdown', hHandle);
      document.addEventListener('click', hHandle);
    </script>

    <slot name="head" />
  </head>
  <body>
    {/* The icon sprite, once per page, before anything that references it. It is display:none,
        so it costs no layout — only the handful of <use> refs on the page actually paint. */}
    <IconSprite />
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
