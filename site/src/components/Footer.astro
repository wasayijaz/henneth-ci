---
import { site } from '../site.config.ts';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/solutions', label: 'Solutions' },
      /* Sits under Product, not Resources: global coverage is part of what the subscription is,
         not a reading-room extra. It is also the only site-wide link to /global-markets/ — the nav
         deliberately stays at seven items, so the footer carries the crawl path. */
      { href: '/global-markets', label: 'Global coverage' },
      { href: '/plans', label: 'Plans' },
    ],
  },
  /* The use-case pages are listed here AND in the Solutions nav, deliberately. A page built to
     rank but reachable only from a footer is the doorway pattern Google targets — if it is worth
     ranking it is worth navigating to. This column also does the internal-linking job: it points
     site-wide authority at the pages that actually convert. */
  {
    title: 'Use cases',
    links: [
      { href: '/solutions/psx-research-for-new-investors', label: 'New investors' },
      { href: '/solutions/psx-screener-and-strategies', label: 'Screener & strategies' },
      { href: '/solutions/psx-dividend-calendar-and-yields', label: 'Dividend calendar & yields' },
      { href: '/solutions/psx-broker-research-scorecard', label: 'Brokers & institutions' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/research', label: 'Research' },
      { href: '/financial-astrology', label: 'Financial astrology' },
      { href: '/blog', label: 'Blog' },
      { href: '/tools', label: 'Calculators' },
      /* Deep-linked past /tools on purpose. It is the one free page that demonstrates a house rule
         (Rule 4 sizing) rather than describing one, so it is the highest-intent entry point on the
         site for someone who has not signed up. */
      { href: '/tools/position-size-calculator', label: 'Position size calculator' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/legal/terms', label: 'Terms' },
      { href: '/legal/privacy', label: 'Privacy' },
      { href: '/legal/disclosures', label: 'Disclosures' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap ft-in">
    <div class="ft-brand">
      <a href="/" class="wordmark">
        <span class="wm-1">HENNETH</span>
      </a>
      <p class="ft-blurb">
        A research &amp; analytics desk that covers the Pakistan Stock Exchange in depth and the
        global tape for context. Plain-English company reads, backtested strategies, and analysts
        who debate every name in the open — published on a schedule.
      </p>
      <a href="/plans" class="btn ft-cta">Get started</a>
    </div>

    {cols.map((c) => (
      <div class="ft-col">
        <div class="ft-h">{c.title}</div>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap ft-base">
    <p>
      {site.name} is an educational research &amp; analytics tool — not an investment adviser, not a
      broker. Nothing here is personalised advice, a recommendation, or a promise of returns. Past
      performance does not predict future results. Investing in the Pakistan Stock Exchange carries
      risk, including the loss of capital. You make your own decisions.
    </p>
    <p class="ft-copy">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .ft { background: var(--ink-1); color: var(--bg); padding: 56px 0 24px; }
  .ft-in {
    display: grid;
    /* Brand + four link columns. Was 1.5fr and three; a fourth column was added for the use-case
       pages, and without widening this the last column wrapped. */
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
  }
  .wordmark { display: flex; align-items: baseline; gap: 8px; color: var(--bg); text-decoration: none; }
  .wm-1 { font-weight: 800; font-size: 15px; letter-spacing: 0.14em; }
  .ft-blurb { margin: 14px 0 18px; font-size: 11.5px; line-height: 1.7; color: #a8a8a0; max-width: 320px; }
  .ft-cta { padding: 10px 16px; }

  .ft-h {
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 700;
    color: #8f8f88;
    margin-bottom: 14px;
  }
  .ft-col ul { list-style: none; margin: 0; padding: 0; }
  .ft-col li { margin-bottom: 10px; }
  .ft-col a {
    color: #cfcfc8;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  /* var(--bg), not #fff: the site's paper white is not pure white, and one hover state that jumps
     past it is the kind of half-degree difference that reads as a rendering bug. */
  @media (hover: hover) {
    .ft-col a:hover { color: var(--bg); }
  }

  .ft-base { border-top: 1px solid #2a2a27; padding-top: 20px; }
  /* #8f8f88, not #7a7a72. This paragraph is the risk disclaimer — the one block on the site that
     has to be legible on principle, and it was the least legible thing on it. */
  .ft-base p { font-size: 10px; line-height: 1.7; color: #8f8f88; margin: 0 0 8px; max-width: 900px; }
  .ft-copy { margin: 0; }

  @media (max-width: 860px) {
    /* Five items into two columns leaves Legal alone on a row with a hole beside it. The brand
       block takes the full width instead, so the four link columns pair off 2 + 2. */
    .ft-in { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
    .ft-blurb { max-width: 60ch; }
  }
  @media (max-width: 520px) {
    .ft-in { grid-template-columns: 1fr; gap: 26px; }
  }

  /* The footer carries seventeen links, and on a phone every one of them was an 11px word 14px
     tall — the densest cluster of unhittable targets on the site. Each link becomes its own 44px
     row instead, which is why the li margin goes to zero: the row supplies the spacing now. */
  @media (max-width: 720px) {
    .ft { padding: 44px 0 24px; }
    .ft-h { font-size: 11px; margin-bottom: 6px; }
    .ft-blurb { font-size: 13px; }
    .ft-col li { margin-bottom: 0; }
    .ft-col a {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: 12px;
    }
    .ft-base p { font-size: 11.5px; }
    /* Stacked, the wordmark becomes a full-width row — so it reads as a big target while actually
       being 25px of it. align-self keeps the box from stretching to the column width it does not
       need; the height is what was missing. */
    .wordmark { min-height: 44px; align-items: center; align-self: start; }
  }
</style>
