---
import { site } from '../site.config.ts';
const year = new Date().getFullYear();

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features', label: 'Features' },
      { href: '/solutions', label: 'Solutions' },
      { href: '/plans', label: 'Plans' },
    ],
  },
  /* The use-case pages are listed here AND in the Solutions nav, deliberately. A page built to
     rank but reachable only from a footer is the doorway pattern Google targets — if it is worth
     ranking it is worth navigating to. This column also does the internal-linking job: it points
     site-wide authority at the pages that actually convert. */
  {
    title: 'Use cases',
    links: [
      { href: '/solutions/psx-research-for-new-investors', label: 'New investors' },
      { href: '/solutions/psx-screener-and-strategies', label: 'Screener & strategies' },
      { href: '/solutions/psx-dividend-calendar-and-yields', label: 'Dividend calendar & yields' },
      { href: '/solutions/psx-broker-research-scorecard', label: 'Brokers & institutions' },
    ],
  },
  {
    title: 'Resources',
    links: [
      { href: '/research', label: 'Research' },
      { href: '/financial-astrology', label: 'Financial astrology' },
      { href: '/blog', label: 'Blog' },
      { href: '/tools', label: 'Calculators' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/legal/terms', label: 'Terms' },
      { href: '/legal/privacy', label: 'Privacy' },
      { href: '/legal/disclosures', label: 'Disclosures' },
    ],
  },
];
---

<footer class="ft">
  <div class="wrap ft-in">
    <div class="ft-brand">
      <a href="/" class="wordmark">
        <span class="wm-1">HENNETH</span>
      </a>
      <p class="ft-blurb">
        A research &amp; analytics desk for the Pakistan Stock Exchange. Plain-English company reads,
        tested strategies, and analysts who debate every name in the open.
      </p>
      <a href="/plans" class="btn ft-cta">Get started</a>
    </div>

    {cols.map((c) => (
      <div class="ft-col">
        <div class="ft-h">{c.title}</div>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="wrap ft-base">
    <p>
      {site.name} is an educational research &amp; analytics tool — not an investment adviser, not a
      broker. Nothing here is personalised advice, a recommendation, or a promise of returns. Past
      performance does not predict future results. Investing in the Pakistan Stock Exchange carries
      risk, including the loss of capital. You make your own decisions.
    </p>
    <p class="ft-copy">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .ft { background: var(--ink-1); color: var(--bg); padding: 56px 0 24px; }
  .ft-in {
    display: grid;
    /* Brand + four link columns. Was 1.5fr and three; a fourth column was added for the use-case
       pages, and without widening this the last column wrapped. */
    grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
  }
  .wordmark { display: flex; align-items: baseline; gap: 8px; color: var(--bg); text-decoration: none; }
  .wm-1 { font-weight: 800; font-size: 15px; letter-spacing: 0.14em; }
  .wm-2 { font-weight: 500; font-size: 12px; letter-spacing: 0.14em; color: #a8a8a0; text-transform: uppercase; }
  .ft-blurb { margin: 14px 0 18px; font-size: 11.5px; line-height: 1.7; color: #a8a8a0; max-width: 320px; }
  .ft-cta { padding: 10px 16px; }

  .ft-h {
    font-size: 9.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 700;
    color: #7a7a72;
    margin-bottom: 14px;
  }
  .ft-col ul { list-style: none; margin: 0; padding: 0; }
  .ft-col li { margin-bottom: 10px; }
  .ft-col a {
    color: #cfcfc8;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ft-col a:hover { color: #fff; }

  .ft-base { border-top: 1px solid #2a2a27; padding-top: 20px; }
  .ft-base p { font-size: 10px; line-height: 1.7; color: #7a7a72; margin: 0 0 8px; max-width: 900px; }
  .ft-copy { margin: 0; }

  @media (max-width: 860px) {
    .ft-in { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .ft-in { grid-template-columns: 1fr; gap: 26px; }
  }
</style>
