---
import { site } from '../site.config.ts';
const nav = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<header class="site-header">
  <div class="wrap hdr">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="hdr-nav" aria-label="Primary">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>

    <div class="hdr-cta">
      <a href="#waitlist" class="btn btn-ghost hdr-btn">Get early access</a>
      <a href={site.appUrl} class="btn btn-primary hdr-btn" rel="noopener">Launch the desk</a>
    </div>

    <button class="hdr-menu" id="hdrMenu" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="hdr-drawer" id="hdrDrawer" hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <a href="#waitlist">Get early access</a>
    <a href={site.appUrl} class="drawer-primary" rel="noopener">Launch the desk →</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 250, 247, 0.82);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .hdr {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.16rem;
    letter-spacing: -0.02em;
  }
  .brand:hover { text-decoration: none; }
  .brand-mark {
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: linear-gradient(135deg, var(--primary) 0%, #0f9c78 100%);
    box-shadow: 0 2px 6px var(--primary-glow);
    position: relative;
  }
  .brand-mark::after {
    content: '';
    position: absolute;
    inset: 6px 6px auto 6px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: 0 6px 0 rgba(255, 255, 255, 0.55);
  }
  .hdr-nav {
    display: flex;
    gap: 26px;
    margin-left: 8px;
  }
  .hdr-nav a {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: 0.96rem;
  }
  .hdr-nav a:hover { color: var(--ink); text-decoration: none; }
  .hdr-cta { display: flex; gap: 10px; margin-left: auto; }
  .hdr-btn { padding: 9px 16px; font-size: 0.92rem; }
  .hdr-menu {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
  }
  .hdr-menu span {
    width: 22px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }
  .hdr-drawer {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 24px 20px;
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .hdr-drawer a {
    padding: 12px 4px;
    color: var(--ink-soft);
    font-weight: 500;
    border-bottom: 1px solid var(--line);
  }
  .hdr-drawer a:hover { text-decoration: none; color: var(--ink); }
  .hdr-drawer .drawer-primary { color: var(--primary-ink); font-weight: 600; border-bottom: 0; }

  @media (max-width: 860px) {
    .hdr-nav, .hdr-cta { display: none; }
    .hdr-menu { display: flex; }
    .hdr-drawer:not([hidden]) { display: flex; }
  }
</style>

<script>
  const btn = document.getElementById('hdrMenu');
  const drawer = document.getElementById('hdrDrawer');
  btn?.addEventListener('click', () => {
    const open = drawer?.hasAttribute('hidden');
    if (open) drawer?.removeAttribute('hidden');
    else drawer?.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(!!open));
  });
  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      drawer.setAttribute('hidden', '');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
