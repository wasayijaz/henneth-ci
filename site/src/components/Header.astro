---
import { site } from '../site.config.ts';
interface Props { active?: string }
const { active = '' } = Astro.props;

const links = [
  { k: 'features', label: 'Features', href: '/features' },
  { k: 'solutions', label: 'Solutions', href: '/solutions' },
  { k: 'research', label: 'Research', href: '/research' },
  { k: 'plans', label: 'Plans', href: '/plans' },
  { k: 'blog', label: 'Blog', href: '/blog' },
];
---

<header class="nav">
  <div class="nav-in">
    <a href="/" class="wordmark" aria-label={`${site.name} home`}>
      {/* Inlined rather than <img src="/logo.svg"> on purpose: the header inverts to a dark bar,
          and only an inline SVG can inherit currentColor. An <img> would need a second, light
          copy of the file kept in sync with the first. aria-hidden because the anchor already
          carries the accessible name — otherwise a screen reader announces the brand twice. */}
      <svg class="wm-mark" viewBox="0 0 512 353" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M446.573 0.355469C462.334 0.310732 480.506 -2.13 494.124 6.42676C515.224 19.6807 511.024 45.4941 511.024 66.7852L511.006 142.461L511.018 260.86L511.012 298.175C511.012 304.311 511.232 313.267 510.785 319.226C510.283 325.342 508.171 331.219 504.675 336.26C498.405 345.475 489.783 350.251 479.068 352.388C470.472 353.024 458.954 352.688 450.131 352.682L400.289 352.657L242.442 352.651H102.525L57.7666 352.712C43.5759 352.73 30.1047 354.672 17.5703 346.933C-3.9062 333.67 0.339434 308.3 0.34375 286.578L0.333984 213.933L0.326172 95.8223C0.326171 75.6603 -0.0841016 55.2226 0.603516 35.1035C1.25022 16.1744 14.9868 4.61197 32.3105 0.597656C38.706 0.0416886 49.539 0.340435 56.2842 0.344727L97.9756 0.37793L231.101 0.369141L395.721 0.389648L446.573 0.355469ZM92.1426 20.5342C76.2281 20.5317 49.3452 19.7353 34.1748 20.7842C23.4972 24.4972 19.8398 30.1121 19.7559 41.2998C19.6328 57.6813 19.842 74.0674 19.8652 90.4502L19.79 182.468L19.7979 265.617C19.7636 281.348 19.1673 297.307 19.79 313.015C19.9076 315.981 20.1934 318.934 21.2998 321.716C23.1998 326.495 27.0734 330.059 31.8633 331.859C38.3989 334.313 143.303 332.901 157.877 332.899L386.721 332.881L446.824 332.919C453.511 332.931 471.929 333.364 477.52 332.366C486.673 329.006 491.155 323.81 491.29 313.722C491.498 297.837 491.401 281.941 491.395 266.054L491.382 175.863L491.327 83.8887C491.321 75.0501 492.392 37.9815 490.139 32.0557C488.418 27.6461 485.05 24.0785 480.752 22.1094C477.458 20.637 474.292 20.6141 470.717 20.6006C440.61 20.4861 410.423 20.5281 380.316 20.5293L205.364 20.5371L92.1426 20.5342ZM367.838 247.697C367.856 252.087 368.156 266.172 367.458 269.656C333.671 269.233 297.343 269.345 263.617 269.694L263.679 247.67L367.838 247.697ZM211.999 90.3945C212.582 128.764 212.047 168.85 212.05 207.324L212.007 244.719C211.988 248.62 212.133 258.941 211.614 262.192L210.447 262.653L189.397 262.713L189.38 185.877C166.304 185.513 142.355 185.847 119.209 185.851L119.167 262.646C111.817 262.61 104.348 262.728 96.9883 262.78L96.9375 90.3994L119.216 90.3984L119.124 163.954L189.371 163.976C189.12 139.678 189.222 114.718 189.397 90.4189L211.999 90.3945Z"/>
      </svg>
      <span class="wm-1">HENNETH</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { on: l.k === active }]}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-right">
      <span class="badge"><span class="dot"></span>Research · not advice</span>
      <a href={site.appUrl} class="nav-signin" rel="noopener">Sign in</a>
      <a href="/plans" class="btn nav-cta">Get started</a>
    </div>

    <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-drawer" id="navDrawer" hidden>
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
    <a href={site.appUrl} rel="noopener">Sign in</a>
    <a href="/plans" class="drawer-cta">Get started →</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--ink-1);
    color: var(--bg);
    border-bottom: var(--rule);
  }
  .nav-in {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .wordmark {
    display: flex;
    /* center, not baseline: an inline SVG's baseline sits on its bottom edge, so `baseline`
       hangs the mark below the cap-height of HENNETH instead of aligning with it. */
    align-items: center;
    gap: 9px;
    color: var(--bg);
    text-decoration: none;
  }
  /* Width follows from the 512:353 viewBox — set height only so the aspect can never skew. */
  .wm-mark { height: 17px; width: auto; display: block; flex: none; }
  .wm-1 { font-weight: 800; font-size: 15px; letter-spacing: 0.14em; }
  .wm-2 {
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: #a8a8a0;
    text-transform: uppercase;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    margin-left: 14px;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .nav-link { color: #cfcfc8; text-decoration: none; }
  .nav-link:hover { color: #fff; }
  .nav-link.on { color: #fff; font-weight: 700; }

  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .nav-signin {
    color: #cfcfc8;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .nav-signin:hover { color: #fff; }
  .nav-cta {
    background: var(--bg);
    color: var(--ink-1);
    border-color: var(--bg);
    padding: 9px 15px;
    font-size: 11px;
  }
  .nav-cta:hover { background: #fff; color: var(--ink-1); }

  .nav-burger {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 8px;
  }
  .nav-burger span { width: 20px; height: 2px; background: var(--bg); }

  .nav-drawer {
    display: none;
    flex-direction: column;
    background: var(--ink-1);
    border-top: 1px solid #2a2a27;
    padding: 8px 24px 18px;
  }
  .nav-drawer a {
    color: #cfcfc8;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 13px 0;
    border-bottom: 1px dotted #2f2f2c;
  }
  .nav-drawer a:hover { color: #fff; }
  .nav-drawer .drawer-cta { color: #fff; font-weight: 700; border-bottom: 0; }

  @media (max-width: 900px) {
    .nav-links, .nav-right { display: none; }
    .nav-burger { display: flex; }
    .nav-drawer:not([hidden]) { display: flex; }
  }
</style>

<script>
  const b = document.getElementById('navBurger');
  const d = document.getElementById('navDrawer');
  b?.addEventListener('click', () => {
    const willOpen = d?.hasAttribute('hidden');
    if (willOpen) d?.removeAttribute('hidden');
    else d?.setAttribute('hidden', '');
    b.setAttribute('aria-expanded', String(!!willOpen));
  });
</script>
