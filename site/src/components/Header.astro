---
import { site } from '../site.config.ts';
interface Props { active?: string; mode?: 'default' | 'immersive' }
const { active = '', mode = 'default' } = Astro.props;
const links = [
  { k: 'features', label: 'Features', href: '/features/' },
  { k: 'solutions', label: 'Solutions', href: '/solutions/' },
  { k: 'research', label: 'Research', href: '/research/' },
  { k: 'astro', label: 'Astro', href: '/financial-astrology/' },
  { k: 'tools', label: 'Tools', href: '/tools/' },
  { k: 'plans', label: 'Plans', href: '/plans/' },
  { k: 'blog', label: 'Blog', href: '/blog/' },
];
const current = (key: string) => key === active ? 'page' : undefined;
---

<header class:list={['nav', { 'nav--immersive': mode === 'immersive' }]} data-nav-root>
  <div class="nav-in">
    <button class="nav-burger" type="button" data-nav-toggle aria-controls="navDrawer" aria-expanded="false" aria-label="Open menu"><span></span><span></span><span></span></button>
    <a href="/" class="wordmark" aria-label={`${site.name} home`}><img src="/logo.svg" class="wm-mark" alt="" /><span class="wm-1">HENNETH</span></a>
    <nav class="nav-links" aria-label="Primary navigation">{links.map((l) => <a href={l.href} class:list={['nav-link', { on: l.k === active }]} aria-current={current(l.k)}>{l.label}</a>)}</nav>
    <div class="nav-right"><a href={site.appUrl} class="nav-signin" data-nav-cta="Log in" rel="noopener">Log in</a><a href="/plans/" class="btn nav-cta" data-nav-cta="Sign up free">Sign up free ›</a></div>
    <div class="nav-mobile-auth" aria-label="Account links"><a href={site.appUrl} class="nav-signin" data-nav-cta="Log in" rel="noopener">Log in</a><a href="/plans/" class="btn nav-cta" data-nav-cta="Sign up free">Sign up free</a></div>
  </div>
</header>
<div class="nav-drawer" id="navDrawer" data-state="closed" hidden inert aria-hidden="true" role="dialog" aria-modal="true" aria-label="Navigation menu">
  <button class="nav-scrim" type="button" data-nav-close tabindex="-1" aria-label="Close menu"></button>
  <div class="nav-drawer-panel"><div class="nav-drawer-head"><span class="drawer-wordmark"><img src="/logo.svg" class="drawer-mark" alt="" />HENNETH</span><button class="nav-close" type="button" data-nav-close aria-label="Close menu">×</button></div><nav aria-label="Mobile navigation">{links.map((l) => <a href={l.href} class:list={{ on: l.k === active }} aria-current={current(l.k)}>{l.label}</a>)}</nav><div class="drawer-actions"><a href="/plans/" class="drawer-main" data-nav-cta="Get started">Get started →</a><a href={site.appUrl} class="drawer-login" data-nav-cta="Sign in" rel="noopener">Sign in</a></div></div>
</div>
<div class="nav-pill" data-nav-pill inert aria-hidden="true"><a href="/" class="pill-wordmark" aria-label={`${site.name} home`}><img src="/logo.svg" class="pill-mark" alt="" /><span>HENNETH</span></a><nav aria-label="Quick navigation">{links.map((l) => <a href={l.href} class:list={{ on: l.k === active }} aria-current={current(l.k)}>{l.label}</a>)}</nav><a href="/plans/" class="pill-cta" data-nav-cta="Sign up free">Sign up free ›</a></div>
<div class="nav-mobile-spacer" aria-hidden="true"></div>

<style>
  .nav { position: relative; z-index: 45; background: rgba(255,255,255,.84); color: var(--ink-1); border-bottom: 1px solid var(--line); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); }
  .nav--immersive { position: absolute; top: 34px; left: 50%; width: min(100%, var(--maxw)); transform: translateX(-50%); background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .nav--immersive .nav-in { min-height: 0; padding: 18px 44px; }
  .nav--immersive .wm-mark { height: 22px; }
  .nav--immersive .nav-cta { line-height: 1.1; }
  .nav-in { max-width: var(--maxw); min-height: 64px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 24px; }
  .wordmark, .pill-wordmark { display: flex; align-items: center; gap: 9px; color: var(--ink-1); text-decoration: none; white-space: nowrap; }
  .wm-mark { width: auto; height: 17px; display: block; flex: none; } .wm-1 { font-weight: 800; font-size: 15px; letter-spacing: .14em; }
  .nav-links { display: flex; gap: 22px; margin-left: 14px; font: 500 11px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .nav-link { color: var(--ink-3); text-decoration: none; transition: color .25s ease; } .nav-link:hover, .nav-link.on { color: var(--ink-1); } .nav-link.on { font-weight: 700; }
  .nav-right { margin-left: auto; display: flex; align-items: center; gap: 18px; }
  .nav-signin { color: var(--ink-3); text-decoration: none; font: 500 11px var(--font-mono); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; } .nav-signin:hover { color: var(--ink-1); }
  .nav-cta { background: var(--ink-1); color: var(--bg); border-color: var(--ink-1); padding: 9px 15px; font-size: 11px; } .nav-cta:hover { background: var(--panel); color: var(--ink-1); } .nav-mobile-auth, .nav-burger { display: none; }
  .nav-pill { position: fixed; top: 16px; left: 50%; transform: translateX(-50%) translateY(-90px); z-index: 50; opacity: 0; display: flex; align-items: center; gap: 26px; pointer-events: none; background: rgba(255,255,255,.62); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); border: 1px solid rgba(17,17,17,.1); box-shadow: 0 10px 34px rgba(10,10,10,.14); padding: 9px 12px 9px 20px; transition: transform .35s cubic-bezier(.2,.8,.2,1), opacity .35s ease, box-shadow .35s ease; } .nav-pill.is-visible { transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: auto; }
  .nav-mobile-spacer { display: none; }
  .pill-wordmark { gap: 8px; font: 700 13px var(--font-mono); letter-spacing: .12em; } .pill-mark { width: 16px; height: 16px; display: block; object-fit: contain; } .nav-pill nav { display: flex; gap: 14px; font: 500 10px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; } .nav-pill nav a { color: var(--ink-3); text-decoration: none; white-space: nowrap; } .nav-pill nav a:hover, .nav-pill nav a.on { color: var(--ink-1); } .pill-cta { display: inline-flex; align-items: center; background: var(--ink-1); color: var(--panel); padding: 8px 16px; font: 700 10px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; text-decoration: none; white-space: nowrap; }
  .nav-drawer { position: fixed; inset: 0; z-index: 80; pointer-events: none; } .nav-drawer[data-state='open'] { pointer-events: auto; } .nav-scrim { position: absolute; inset: 0 0 0 min(300px, 84vw); width: auto; height: auto; border: 0; background: rgba(10,10,10,.48); opacity: 0; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); transition: opacity .22s cubic-bezier(.23,1,.32,1); } .nav-drawer[data-state='open'] .nav-scrim { opacity: 1; } .nav-drawer-panel { position: absolute; top: 0; bottom: 0; left: 0; width: min(300px, 84vw); display: flex; flex-direction: column; padding: 22px 22px max(30px, env(safe-area-inset-bottom)); background: var(--ink-1); color: var(--bg); box-shadow: 16px 0 40px rgba(0,0,0,.35); overflow-y: auto; overscroll-behavior: contain; opacity: .98; transform: translateX(-100%); transition: transform .26s cubic-bezier(.32,.72,0,1), opacity .2s cubic-bezier(.23,1,.32,1); will-change: transform; } .nav-drawer[data-state='open'] .nav-drawer-panel { opacity: 1; transform: translateX(0); } .nav-drawer-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; } .drawer-wordmark { display: inline-flex; align-items: center; gap: 8px; font: 700 12px var(--font-mono); letter-spacing: .12em; } .drawer-mark { width: 18px; height: 18px; object-fit: contain; filter: invert(1); } .nav-close { width: 44px; height: 44px; margin: -10px -10px 0 0; border: 0; background: none; color: rgba(242,242,238,.7); font-size: 26px; line-height: 1; cursor: pointer; }
  .nav-drawer-panel nav { display: flex; flex-direction: column; gap: 2px; } .nav-drawer-panel nav a { display: flex; align-items: center; min-height: 46px; color: var(--bg); border-bottom: 1px solid rgba(242,242,238,.12); text-decoration: none; font: 700 15px var(--font-mono); } .nav-drawer-panel nav a:hover, .nav-drawer-panel nav a.on { color: #fff; } .nav-drawer-panel nav a.on { border-left: 2px solid var(--accent); padding-left: 10px; } .drawer-actions { display: flex; flex-direction: column; gap: 9px; margin-top: auto; padding-top: 22px; } .drawer-main, .drawer-login { min-height: 46px; display: flex; align-items: center; justify-content: center; text-decoration: none; font: 700 10px var(--font-mono); letter-spacing: .06em; text-transform: uppercase; } .drawer-main { background: var(--bg); color: var(--ink-1); } .drawer-login { border: 1.5px solid rgba(242,242,238,.28); color: var(--bg); }
  :where(a, button):focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 1100px) { .nav-links { gap: 10px; margin-left: 4px; font-size: 10px; } .nav-in { gap: 14px; } .nav-right { gap: 8px; } .nav-cta { padding-inline: 11px; } }
  @media (max-width: 900px) { .nav-pill { gap: 12px; padding: 8px 10px; } .nav-pill nav { gap: 8px; font-size: 9px; } .pill-cta { padding-inline: 11px; font-size: 9px; } }
  @media (min-width: 761px) and (max-width: 920px) { .nav--immersive { top: 0; } }
  @media (max-width: 760px) { .nav, .nav--immersive { position: fixed; inset: 0 0 auto; width: 100%; transform: none; background: rgba(255,255,255,.7); border-bottom: 1px solid var(--line); backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); transition: box-shadow .28s cubic-bezier(.23,1,.32,1), background .28s cubic-bezier(.23,1,.32,1); } .nav.is-compact { background: rgba(255,255,255,.5); box-shadow: 0 10px 30px rgba(10,10,10,.18); } .nav-in, .nav--immersive .nav-in { min-height: 58px; padding: 14px 18px; gap: 12px; } .nav-mobile-spacer { display: block; height: 73px; } .nav-links, .nav-right { display: none; } .nav-burger { display: flex; flex: none; width: 44px; height: 44px; align-items: center; justify-content: center; flex-direction: column; gap: 4px; margin-left: -8px; padding: 0; border: 0; background: none; color: var(--ink-1); cursor: pointer; } .nav-burger span { width: 20px; height: 2px; background: currentColor; transition: transform .28s cubic-bezier(.23,1,.32,1), opacity .2s cubic-bezier(.23,1,.32,1); } .nav-burger[aria-expanded='true'] span:first-child { transform: translateY(6px) rotate(45deg); } .nav-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; } .nav-burger[aria-expanded='true'] span:last-child { transform: translateY(-6px) rotate(-45deg); } .wordmark { gap: 7px; } .wm-mark, .nav--immersive .wm-mark { height: 18px; } .wm-1 { font-size: 13px; letter-spacing: .1em; } .nav-mobile-auth { margin-left: auto; display: flex; align-items: center; gap: 8px; min-width: 0; } .nav-mobile-auth .nav-signin { padding: 7px 10px; border: 1.5px solid var(--ink-1); color: var(--ink-1); font-size: 9px; } .nav-mobile-auth .nav-cta { padding: 8px 11px; font-size: 9px; } .nav-pill { display: none; } }
  @media (prefers-reduced-motion: reduce) { .nav, .nav-in, .nav-pill, .nav-burger span { transition: none !important; } .nav-scrim { transition-duration: .12s !important; } .nav-drawer-panel { transform: none; transition: opacity .12s cubic-bezier(.23,1,.32,1) !important; } }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-nav-root]'); const toggle = root?.querySelector('[data-nav-toggle]'); const drawer = document.querySelector('#navDrawer'); const pill = document.querySelector('[data-nav-pill]');
    if (!root || !toggle || !drawer) return; let isOpen = false; let scrollLocked = false; let closeTimer = 0; let openFrame = 0; let restoreFocus = null; let restoreHtmlOverflow = ''; let restoreBodyOverflow = ''; const mobile = () => window.matchMedia('(max-width: 760px)').matches; const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finishClose = () => { if (isOpen) return; drawer.setAttribute('hidden', ''); if (scrollLocked) { document.documentElement.style.overflow = restoreHtmlOverflow; document.body.style.overflow = restoreBodyOverflow; scrollLocked = false; } };
    const setOpen = (open) => { if (open === isOpen) return; isOpen = open; window.clearTimeout(closeTimer); window.cancelAnimationFrame(openFrame); toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); if (open) { restoreFocus = document.activeElement; if (!scrollLocked) { restoreHtmlOverflow = document.documentElement.style.overflow; restoreBodyOverflow = document.body.style.overflow; scrollLocked = true; } document.documentElement.style.overflow = 'hidden'; document.body.style.overflow = 'hidden'; drawer.removeAttribute('hidden'); drawer.removeAttribute('inert'); drawer.setAttribute('aria-hidden', 'false'); drawer.dataset.state = 'closed'; openFrame = window.requestAnimationFrame(() => { if (!isOpen) return; drawer.dataset.state = 'open'; drawer.querySelector('.nav-close, a')?.focus(); }); window.posthog?.capture('mobile_nav_opened'); } else { drawer.dataset.state = 'closed'; drawer.setAttribute('aria-hidden', 'true'); drawer.setAttribute('inert', ''); if (restoreFocus instanceof HTMLElement) restoreFocus.focus(); closeTimer = window.setTimeout(finishClose, reduceMotion() ? 120 : 260); } };
    toggle.addEventListener('click', () => setOpen(!isOpen)); drawer.addEventListener('click', (event) => { const source = event.target; if (source instanceof Element && (source.closest('[data-nav-close]') || source.closest('a'))) setOpen(false); }); document.addEventListener('keydown', (event) => { if (!isOpen) return; if (event.key === 'Escape') { setOpen(false); return; } if (event.key !== 'Tab') return; const focusable = Array.from(drawer.querySelectorAll('.nav-drawer-panel a, .nav-drawer-panel button')).filter((el) => !el.hasAttribute('disabled')); if (!focusable.length) return; const first = focusable[0]; const last = focusable[focusable.length - 1]; if (!drawer.contains(document.activeElement)) { event.preventDefault(); first.focus(); } else if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); } }); window.addEventListener('resize', () => { if (!mobile() && isOpen) setOpen(false); }, { passive: true });
    const onScroll = () => { const y = window.scrollY || 0; root.classList.toggle('is-compact', mobile() && y > 24); if (pill && !mobile()) { const visible = y > 320; pill.classList.toggle('is-visible', visible); pill.toggleAttribute('inert', !visible); pill.setAttribute('aria-hidden', String(!visible)); } }; window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
    document.addEventListener('click', (event) => { const source = event.target; const target = source instanceof Element ? source.closest('[data-nav-cta]') : null; if (target) window.posthog?.capture('nav_cta_clicked', { cta_label: target.dataset.navCta || target.textContent.trim() }); });
  })();
</script>
