---
/* The visible half of FAQPage schema.
 *
 * A page that emits FAQ structured data MUST show the same answers to a human — Google's guideline
 * says so, and it is also the only honest version: markup written for a crawler alone is a claim
 * made to a machine and hidden from the reader. So the pattern here is deliberately one array:
 *
 *   const faq = [{ q: '…', a: '…' }];
 *   <Base faq={faq}> … <Faq items={faq} /> … </Base>
 *
 * One source, rendered once and marked up once. They cannot drift.
 *
 * <details> rather than a JS accordion: it is open-by-default-able, keyboard operable, findable by
 * the browser's own in-page search when closed (Chrome expands a hidden <details> to reach a hit),
 * and it needs no script — which matters on a page whose whole point is that it loads fast for
 * organic traffic.
 */
import Icon from './Icon.astro';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  kicker?: string;
  /** Surface to sit on. The FAQ lands in a different position in every page's band cadence, so the
      component cannot pick one — the page knows what precedes it, the component does not. */
  band?: 'bg' | 'panel';
}
const {
  items,
  heading = 'Questions the desk gets asked',
  kicker = 'FAQ',
  band = 'bg',
} = Astro.props;
---

{
  items.length > 0 && (
    <section class:list={['section', 'faq-sec', band === 'panel' && 'band-panel']}>
      <div class="wrap">
        <div class="sec-head">
          <p class="kicker">
            <Icon name="ask" size={14} /> {kicker}
          </p>
          <h2>{heading}</h2>
        </div>

        <div class="faq-list">
          {items.map((f, i) => (
            <details class="faq-item" open={i === 0}>
              <summary>
                <span class="faq-q">{f.q}</span>
                <span class="faq-mk" aria-hidden="true" />
              </summary>
              <div class="faq-a">
                <p>{f.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  /* Single-column rules rather than the .tilegrid pattern: an FAQ is read top to bottom, and the
     grid's 1.5px gap-as-rule trick would leave an orphan cell whenever the count is odd. */
  .faq-list { border: var(--rule); background: var(--panel); }
  .faq-item + .faq-item { border-top: var(--rule); }

  /* An open row gets a spine. The mark already changes; the row did not, so an opened answer read
     as loose text under a list rather than as the thing you asked for. Same device .fa-straddle
     uses — a left rule in the site's own weight — which makes it a shared idiom, not a one-off. */
  .faq-item { border-left: 1.5px solid transparent; transition: border-left-color 0.18s ease, background 0.18s ease; }
  .faq-item[open] { border-left-color: var(--ink-1); background: var(--panel-2); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 18px;
    cursor: pointer;
    list-style: none;
  }
  /* Safari still paints its own triangle without this. */
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--ink-1); outline-offset: -2px; }

  .faq-q {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.5;
    color: var(--ink-1);
  }

  /* A drawn plus/minus, not a rotating chevron: the mark is two 1.5px rules, the same weight as
     every other line on the site, so it reads as part of the grid rather than an icon dropped on
     top of it. The vertical stroke is the ::after and simply disappears when open. */
  .faq-mk {
    position: relative;
    flex: 0 0 auto;
    width: 11px;
    height: 11px;
  }
  .faq-mk::before,
  .faq-mk::after {
    content: '';
    position: absolute;
    background: var(--ink-3);
    transition: opacity 0.18s ease, background 0.18s ease;
  }
  .faq-mk::before { left: 0; right: 0; top: 50%; height: 1.5px; transform: translateY(-50%); }
  .faq-mk::after { top: 0; bottom: 0; left: 50%; width: 1.5px; transform: translateX(-50%); }
  .faq-item[open] .faq-mk::after { opacity: 0; }
  .faq-item[open] .faq-mk::before { background: var(--ink-1); }

  .faq-a { padding: 0 18px 18px; }
  .faq-a p {
    margin: 0;
    max-width: 74ch;
    font-size: 12px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  @media (hover: hover) {
    summary:hover .faq-q { color: var(--ink-1); }
    summary:hover .faq-mk::before,
    summary:hover .faq-mk::after { background: var(--ink-1); }
  }

  @media (max-width: 520px) {
    summary { padding: 14px; }
    .faq-a { padding: 0 14px 14px; }
  }
</style>

{/* Same event name the plans page already fires, so both surfaces land in one PostHog funnel
    rather than two half-populated ones. Which question a visitor opens is the cheapest read there
    is on what they actually came to find out — it tells us which objection to answer higher up
    the page. `toggle` rather than `click`: it fires for keyboard opens too. */}
<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.faq-item').forEach(function (el) {
      el.addEventListener('toggle', function () {
        if (!el.open) return;
        var q = (el.querySelector('.faq-q') || {}).textContent || '';
        window.posthog?.capture('faq_expanded', { question: q.trim() });
        window.hTrack?.('faq_expanded', { question: q.trim() });
      });
    });
  });
</script>
