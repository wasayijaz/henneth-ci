---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config.ts';

/* =============================================================================================
   The shell for a use-case landing page at /solutions/<slug>/.

   WHY THESE EXIST, AND WHAT THEY ARE NOT.

   They are NOT a way to manufacture backlinks. A link from henneth.app to desk.henneth.app is an
   internal link on the same root domain — Google reads it as site structure, not as a vote. Only
   another domain linking here creates a backlink, and no page we build can produce one.

   What they genuinely do:
     1. Catch COMMERCIAL-intent queries ("PSX screener", "Pakistan stock analysis tool") that the
        blog deliberately does not target. The blog answers questions; these answer "which product".
        Different intent, different page, so the two compound instead of competing.
     2. Concentrate internal link equity on pages that convert, rather than leaving it spread
        across informational posts.

   Each one must earn its URL with content that is genuinely specific to that audience. Four thin
   variants of the same page is a doorway pattern, which Google targets explicitly — and it is the
   reason these are linked from the main nav and the footer rather than hidden. A page worth
   ranking is worth navigating to.
   ============================================================================================= */

export interface Feature {
  title: string;
  body: string;
  icon: string;
}
export interface Faq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  kicker: string;
  icon: string;
  lead: string;
  /** The problem this audience actually has, in their words. */
  problem: string;
  features: Feature[];
  faqs?: Faq[];
  /** Entitlement key for the desk sign-up, or null for a contact CTA. */
  appPlan?: string | null;
  ctaLabel?: string;
}

const {
  title,
  h1,
  description,
  path,
  kicker,
  icon,
  lead,
  problem,
  features,
  faqs = [],
  appPlan = null,
  ctaLabel = 'Get started',
} = Astro.props;

const url = new URL(path, site.url).href;
const href = appPlan ? `${site.appUrl}/?plan=${appPlan}&auth=signup` : '/contact';

const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: new URL('/solutions/', site.url).href },
    { '@type': 'ListItem', position: 3, name: h1, item: url },
  ],
};

const faqLd = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Base title={title} description={description} path={path} active="solutions">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(crumbLd)} />
    {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </Fragment>

  <section class="section-tight">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/solutions">Solutions</a>
      </nav>
      <p class="kicker"><Icon name={icon} size={14} /> {kicker}</p>
      <h1 class="sp-h1">{h1}</h1>
      <p class="lead sp-lead">{lead}</p>
      <div class="sp-cta">
        <a class="btn btn-solid btn-lg" href={href} rel="noopener">{ctaLabel}</a>
        <a class="btn btn-lg" href="/plans">See plans</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="sp-prob">
        <p class="kicker">The problem</p>
        <p class="sp-prob-b">{problem}</p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="tilegrid sp-f">
        {
          features.map((f) => (
            <div class="tile sp-fi">
              <span class="tile-i"><Icon name={f.icon} size={20} /></span>
              <h2>{f.title}</h2>
              <p class="muted">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <slot />
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <h2 class="sp-fh">Common questions</h2>
          <div class="faqs">
            {faqs.map((f) => (
              <details class="faq">
                <summary>{f.q}</summary>
                <p set:html={f.a} />
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section band-dark">
    <div class="wrap sp-end">
      <div>
        <p class="kicker dr-kicker">Research, not advice</p>
        <h2>Every number on the desk is sourced</h2>
        <p class="lead sp-end-l">
          Prices, filings and dividends come from the data layer, dated and checkable. Where the
          desk does not know, it says so.
        </p>
      </div>
      <a class="btn" href={href} rel="noopener">{ctaLabel}</a>
    </div>
  </section>
</Base>

<style>
  .crumbs { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--ink-1); }
  .crumbs span { margin: 0 6px; }

  .sp-h1 { max-width: 20ch; }
  .sp-lead { max-width: 60ch; margin-top: 12px; }
  .sp-cta { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }

  .sp-prob { border-left: 3px solid var(--ink-1); padding-left: 20px; max-width: 68ch; }
  .sp-prob-b { font-size: 15px; line-height: 1.7; margin: 8px 0 0; }

  .sp-f { grid-template-columns: repeat(3, 1fr); }
  .sp-fi h2 { font-size: 13px; margin: 0 0 6px; }
  .sp-fi p { font-size: 11.5px; margin: 0; line-height: 1.65; }

  .sp-fh { font-size: 16px; margin-bottom: 16px; }
  .faqs { border: var(--rule); background: var(--line); display: grid; gap: 1.5px; max-width: 68ch; }
  .faq { background: var(--panel); }
  .faq summary { cursor: pointer; padding: 14px 18px; font-size: 12.5px; font-weight: 600; list-style: none; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; float: right; font-family: var(--font-mono); color: var(--ink-3); }
  .faq[open] summary::after { content: '−'; }
  .faq p { margin: 0; padding: 0 18px 16px; font-size: 12.5px; line-height: 1.7; color: var(--ink-2); }

  .sp-end { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
  .dr-kicker { color: #8f8f88; }
  .sp-end-l { color: #c8c8c0; margin: 0; max-width: 52ch; }

  @media (max-width: 900px) { .sp-f { grid-template-columns: 1fr; } .sp-end { grid-template-columns: 1fr; } }
</style>
