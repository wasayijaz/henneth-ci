---
// The PRICED plans page. Rendered by /plans when site.earlyAccess is false.
// Kept whole and working so flipping the flag restores it in one line — do not
// let this drift from the tier data in site.config.ts.
import { site } from '../site.config.ts';

const { currency, monthsFreeOnAnnual } = site.billing;
const D = site.trialDays;
const fmt = (n: number) => n.toLocaleString('en-PK');

const enter = (appPlan: string | null, trial: boolean) =>
  appPlan ? `${site.appUrl}/?plan=${appPlan}${trial ? `&trial=${D}` : ''}` : '#';

const faqs = [
  [`How does the ${D}-day trial work?`, `Start on Investor or Pro and you get ${D} days of the full plan, no card required. At the end you choose whether to continue — nothing is charged automatically, and you are never locked out of the free desk.`],
  ['Is this financial advice?', 'No. Henneth is an educational research and analytics tool. It never gives personalised advice, never says buy or sell, and never places orders. You make your own decisions.'],
  ['What does annual actually save me?', `Annual is priced at ten months instead of twelve, so you get ${monthsFreeOnAnnual} months free. Investor works out at ${currency} 2,500 a month, Pro at ${currency} 6,667.`],
  ['Can I change or cancel my plan?', 'Yes. You can move between plans or stop at any time, and you keep access to the free desk either way.'],
  ['Where does the data come from?', 'Prices come from the exchange’s published end-of-day data, with a long price history used for backtests, and fundamentals from public filings. Every figure traces to that data layer — nothing is quoted from memory.'],
  ['Do you show your losses?', 'Yes. Every dated call is scored against what prices actually did, and the misses stay on the record. A track record that only shows wins isn’t one.'],
];
---

<section class="section-tight ph">
  <div class="wrap center">
    <p class="kicker">Plans</p>
    <h1>One desk. Two ways in.</h1>
    <p class="lead ph-lead">
      Investor and Pro — each with a {D}-day trial, no card required. Plus a Broker tier for desks
      and institutions.
    </p>
    <div class="tg-wrap">
      <div class="toggle" role="group" aria-label="Billing period">
        <button class="tg on" data-b="monthly" id="tgM">Monthly</button>
        <button class="tg" data-b="annual" id="tgA">Annual</button>
      </div>
      <span class="tg-save">{monthsFreeOnAnnual} months free</span>
    </div>
  </div>
</section>

<section class="section-tight">
  <div class="wrap">
    <div class="tiers">
      {site.plans.map((p) => (
        <div class="tier" data-featured={p.featured} data-soon={p.soon}>
          {p.tag && <div class="ribbon" data-soon={p.soon}>{p.tag}</div>}
          <div class="tier-in">
            <h3 class="tier-n">{p.name}</h3>
            {p.priceMonthly ? (
              <>
                <div class="tier-price">
                  <span class="cur">{currency}</span>
                  <span class="amt" data-monthly={p.priceMonthly} data-annual={Math.round(p.priceAnnual / 12)}>
                    {fmt(p.priceMonthly)}
                  </span>
                  <span class="per">/mo</span>
                </div>
                <p class="tier-billed" data-billed data-annual-total={p.priceAnnual}>billed monthly</p>
                <p class="tier-save" data-save hidden>
                  Save {currency} {fmt(p.priceMonthly * 12 - p.priceAnnual)} a year
                </p>
              </>
            ) : (
              <>
                <div class="tier-price"><span class="amt soon-amt">—</span></div>
                <p class="tier-billed">in build</p>
              </>
            )}
            <p class="tier-blurb">{p.blurb}</p>
            {p.soon ? (
              <button class="btn tier-cta" disabled>{p.cta}</button>
            ) : (
              <a href={enter(p.appPlan, p.trial)} class="btn tier-cta" rel="noopener">{p.cta}</a>
            )}
            {p.trial && <p class="tier-fine">{D} days free · no card required</p>}
            <ul class="tier-feats">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section band-panel">
  <div class="wrap faq-wrap">
    <p class="kicker">Questions</p>
    <h2>Before you start</h2>
    <div class="faq">
      {faqs.map(([q, a]) => (
        <details class="fq">
          <summary><span>{q}</span><i>+</i></summary>
          <p class="muted">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .center { text-align: center; }
  .ph-lead { max-width: 600px; margin: 0 auto 24px; }
  .tg-wrap { display: inline-flex; align-items: center; gap: 12px; }
  .toggle { display: inline-flex; border: var(--rule); }
  .tg {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
    text-transform: uppercase; font-weight: 700; padding: 9px 18px;
    background: var(--panel); color: var(--ink-1); border: 0; cursor: pointer;
  }
  .tg + .tg { border-left: var(--rule); }
  .tg.on { background: var(--ink-1); color: var(--bg); }
  .tg-save {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em;
    text-transform: uppercase; font-weight: 700; color: var(--up);
    border: 1px solid var(--up); padding: 5px 9px;
  }

  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--ink-1); border: var(--rule); }
  .tier { background: var(--panel); position: relative; }
  .tier[data-featured='true'] { background: var(--ink-1); color: var(--bg); }
  .tier[data-soon='true'] { background: var(--panel-2); }
  .tier-in { padding: 26px 20px; display: flex; flex-direction: column; height: 100%; }
  .ribbon {
    position: absolute; top: 0; right: 0; background: var(--up); color: #fff;
    font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase;
    font-weight: 700; padding: 5px 10px;
  }
  .ribbon[data-soon='true'] { background: var(--ink-3); }
  .tier-n { font-size: 14px; margin-bottom: 16px; }
  .tier-price { display: flex; align-items: baseline; gap: 5px; font-family: var(--font-mono); }
  .cur { font-size: 12px; font-weight: 500; color: var(--ink-3); }
  .amt {
    font-family: var(--font-mono); font-size: 36px; font-weight: 800;
    letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1;
  }
  .soon-amt { color: var(--ink-3); }
  .per { font-size: 11px; color: var(--ink-3); }
  .tier[data-featured='true'] .cur, .tier[data-featured='true'] .per { color: #9a9a92; }
  .tier-billed {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3); margin: 8px 0 0;
  }
  .tier[data-featured='true'] .tier-billed { color: #9a9a92; }
  .tier-save {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; font-weight: 700; color: var(--up); margin: 6px 0 0;
  }
  .tier-blurb { font-size: 11.5px; margin: 16px 0 18px; flex: 1; color: var(--ink-2); }
  .tier[data-featured='true'] .tier-blurb { color: #c8c8c0; }
  .tier-cta { justify-content: center; width: 100%; }
  .tier[data-featured='true'] .tier-cta { background: var(--bg); color: var(--ink-1); border-color: var(--bg); }
  .tier-fine {
    font-size: 9.5px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--ink-3); margin: 8px 0 0; text-align: center;
  }
  .tier[data-featured='true'] .tier-fine { color: #9a9a92; }
  .tier-feats { list-style: none; padding: 0; margin: 22px 0 0; }
  .tier-feats li {
    font-size: 11px; padding: 8px 0 8px 18px; position: relative;
    border-top: 1px dotted var(--hair); color: var(--ink-2);
  }
  .tier[data-featured='true'] .tier-feats li { border-color: #2f2f2c; color: #c8c8c0; }
  .tier-feats li::before { content: '✓'; position: absolute; left: 0; color: var(--up); font-weight: 700; }

  .faq-wrap { max-width: 800px; }
  .faq { margin-top: 20px; border-top: var(--rule); }
  .fq { border-bottom: var(--rule); }
  .fq summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; cursor: pointer; list-style: none;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary i { font-style: normal; font-size: 18px; transition: transform 0.2s ease; }
  .fq[open] summary i { transform: rotate(45deg); }
  .fq p { font-size: 11.5px; padding: 0 0 16px; margin: 0; max-width: 680px; }

  @media (max-width: 900px) { .tiers { grid-template-columns: 1fr; } }
</style>

<script>
  const m = document.getElementById('tgM');
  const a = document.getElementById('tgA');
  const nf = new Intl.NumberFormat('en-PK');
  const set = (mode) => {
    const annual = mode === 'annual';
    m?.classList.toggle('on', !annual);
    a?.classList.toggle('on', annual);
    document.querySelectorAll('[data-monthly]').forEach((el) => {
      const e = el as HTMLElement;
      const v = annual ? e.dataset.annual : e.dataset.monthly;
      if (v) e.textContent = nf.format(Number(v));
    });
    document.querySelectorAll('[data-billed]').forEach((el) => {
      const e = el as HTMLElement;
      const total = e.dataset.annualTotal;
      e.textContent = annual && total ? `billed annually · Rs ${nf.format(Number(total))}` : 'billed monthly';
    });
    document.querySelectorAll('[data-save]').forEach((el) => {
      if (annual) el.removeAttribute('hidden');
      else el.setAttribute('hidden', '');
    });
  };
  m?.addEventListener('click', () => set('monthly'));
  a?.addEventListener('click', () => set('annual'));
</script>
