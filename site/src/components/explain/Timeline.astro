---
/* =============================================================================================
   TIMELINE — a settlement cycle drawn, not described.

   Built as real DOM rather than a generated image on purpose. An AI-generated diagram of a
   settlement timeline would be plausible and wrong, on the one page whose entire value is being
   right; and a raster is invisible to search, unreadable to a screen reader, and blurry on a
   retina phone. This is ~1KB of markup, uses the site's own tokens, and its labels are indexable
   text.

   Two rows compare an old cycle against a new one. Pass one row for a plain timeline.
   ============================================================================================= */

export interface Step {
  /** Short marker, e.g. "T" or "T+1". */
  d: string;
  /** What happens on that day. */
  label: string;
  /** true = the day the trade is struck; rendered filled. */
  trade?: boolean;
  /** true = the day settlement completes; rendered as the outcome. */
  settle?: boolean;
}

export interface Row {
  name: string;
  steps: Step[];
  /** 'old' greys the row out — the superseded cycle. */
  tone?: 'old' | 'new';
  note?: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption } = Astro.props;
const span = Math.max(...rows.map((r) => r.steps.length));
---

<figure class="tl">
  {
    rows.map((r) => (
      <div class:list={['tl-row', r.tone]}>
        <div class="tl-name">
          {r.name}
          {r.note && <i>{r.note}</i>}
        </div>
        <div class="tl-track" style={`--span:${span}`}>
          {r.steps.map((s) => (
            <div class:list={['tl-step', { trade: s.trade, settle: s.settle }]}>
              <span class="tl-dot" aria-hidden="true" />
              <span class="tl-d">{s.d}</span>
              <span class="tl-l">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    ))
  }
  {caption && <figcaption class="tl-cap">{caption}</figcaption>}
</figure>

<style>
  .tl { margin: 0 0 28px; border: var(--rule); background: var(--panel); padding: 20px 18px 6px; }

  .tl-row { display: grid; grid-template-columns: 128px 1fr; gap: 16px; align-items: start; margin-bottom: 22px; }
  .tl-row.old { opacity: 0.55; }

  .tl-name {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 700; padding-top: 2px;
  }
  .tl-name i { display: block; font-style: normal; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink-3); font-size: 10px; margin-top: 3px; }

  /* The track is a grid of `span` columns so both rows align on the same day scale — a two-day
     cycle must visibly occupy twice the width of a one-day cycle, or the comparison lies. */
  .tl-track { display: grid; grid-template-columns: repeat(var(--span), 1fr); position: relative; }
  .tl-track::before {
    content: ''; position: absolute; left: 0; right: 0; top: 5px;
    border-top: 1.5px dotted var(--line);
  }

  .tl-step { position: relative; padding-right: 10px; }
  .tl-dot {
    display: block; width: 11px; height: 11px; border: 1.5px solid var(--ink-1);
    background: var(--panel); position: relative; z-index: 1;
  }
  .tl-step.trade .tl-dot { background: var(--ink-1); }
  .tl-step.settle .tl-dot { background: var(--up); border-color: var(--up); }

  .tl-d {
    display: block; font-family: var(--font-mono); font-size: 11px; font-weight: 800;
    margin-top: 8px; letter-spacing: 0.04em;
  }
  .tl-step.settle .tl-d { color: var(--up); }
  .tl-l { display: block; font-size: 10.5px; color: var(--ink-3); line-height: 1.45; margin-top: 2px; }

  .tl-cap {
    font-size: 10.5px; color: var(--ink-3); line-height: 1.6; border-top: var(--rule);
    padding-top: 12px; margin-top: 4px;
  }

  @media (max-width: 640px) {
    .tl-row { grid-template-columns: 1fr; gap: 10px; }
  }
  /* The step labels used to be pushed DOWN to 9.5px here, on the theory that narrower columns
     need smaller text. They do not: the track columns are 1fr, so a longer label wraps and the
     row grows taller, which costs nothing on a page that already scrolls. Everything goes up. */
  @media (max-width: 720px) {
    .tl-name, .tl-name i { font-size: 11px; }
    .tl-d { font-size: 12px; }
    .tl-l { font-size: 11.5px; }
    .tl-cap { font-size: 12.5px; }
  }
</style>
