---
import ctx from '../../data/public/context.json';
import Icon from '../Icon.astro';

/* =============================================================================================
   DESK PEEK — a terminal-window mockup showing what the desk actually surfaced.

   The "show the product" block for landing pages. Same honesty constraint as TickerTape: the
   symbols, closes and day moves are REAL, read from the committed public slice at build time.
   A mocked-up screenshot with invented numbers beside real listed companies would be a false
   claim about those companies, and it is also the thing every competitor does — so being real
   here is both the safe option and the differentiated one.

   What is decorative: the window chrome, the boot-in stagger, the pulsing live dot. What is
   load-bearing: the figures and the date stamp. The two are kept visually distinct so nobody
   mistakes the frame for a live feed.

   Mobile-first. The rows are a two-column grid that stays legible at 320px, and every animation
   is suppressed under `prefers-reduced-motion` — the stagger is an entrance flourish, never the
   thing that makes content appear, so a reduced-motion visitor sees the full panel immediately.
   ============================================================================================= */

interface Props {
  title?: string;
  /** Signals to show; the slice carries 4. */
  limit?: number;
}
const { title = 'What the desk flagged', limit = 4 } = Astro.props;

type Sig = { sym: string; name: string; tag: string; close: number; pct: number };
const signals = (((ctx as any)?.signals ?? []) as Sig[]).slice(0, limit);
const macro = (ctx as any)?.macro ?? {};
const breadth = (ctx as any)?.breadth_pct ?? null;
const asOf = (ctx as any)?.as_of ?? (ctx as any)?.generated ?? null;

const fmt = (n: number) => new Intl.NumberFormat('en-PK', { minimumFractionDigits: 2 }).format(n);
---

{
  signals.length > 0 && (
    <figure class="dp">
      <div class="dp-bar">
        <span class="dp-dots" aria-hidden="true"><i /><i /><i /></span>
        <span class="dp-t">{title}</span>
        <span class="dp-live">
          <span class="dp-pulse" aria-hidden="true" />
          {macro.regime ? macro.regime : 'live'}
        </span>
      </div>

      <div class="dp-body">
        {signals.map((s, i) => (
          <div class="dp-row" style={`--i:${i}`}>
            <div class="dp-l">
              <b class="dp-sym">{s.sym}</b>
              <span class="dp-name">{s.name}</span>
            </div>
            <div class="dp-r">
              <span class="dp-tag">{s.tag}</span>
              <span class="dp-px">{fmt(s.close)}</span>
              <span class={`dp-pct ${s.pct > 0 ? 'up' : s.pct < 0 ? 'dn' : ''}`}>
                {s.pct > 0 ? '+' : ''}
                {s.pct.toFixed(2)}%
              </span>
            </div>
          </div>
        ))}
      </div>

      <figcaption class="dp-foot">
        <span class="dp-meta">
          {macro.sbp_rate != null && <em>SBP {macro.sbp_rate}%</em>}
          {macro.cpi_yoy != null && <em>CPI {macro.cpi_yoy}%</em>}
          {breadth != null && <em>Breadth {breadth}%</em>}
        </span>
        <span class="dp-as">
          <Icon name="method" size={11} />
          Real figures, {asOf ? `as of ${asOf}` : 'refreshed each deploy'} — not a live feed
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .dp { margin: 0; border: var(--rule); background: var(--panel); overflow: hidden; }

  .dp-bar {
    display: flex; align-items: center; gap: 10px; padding: 9px 12px;
    background: var(--ink-1); color: var(--bg);
  }
  .dp-dots { display: flex; gap: 4px; flex: none; }
  .dp-dots i { width: 7px; height: 7px; background: #3a3a37; display: block; }
  .dp-t {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em;
    text-transform: uppercase; font-weight: 700; flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .dp-live {
    display: inline-flex; align-items: center; gap: 5px; flex: none;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em;
    text-transform: uppercase; color: #8f8f88;
  }
  .dp-pulse { width: 6px; height: 6px; background: #4ec38a; display: block; }

  .dp-body { display: grid; }
  /* Rows are VISIBLE BY DEFAULT and the entrance is added only where motion is welcome.
     The obvious way round — `animation: dpin .5s both` with `opacity: 0` in the from-state — makes
     the content invisible whenever the animation does not actually run: a paused compositor, a
     crawler or social scraper that renders without animating, or any environment that strips
     animation. The panel then serves an empty white box containing the real figures. Progressive
     enhancement is the only safe direction here. */
  .dp-row {
    display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center;
    padding: 12px 14px; border-bottom: 1px dotted var(--hair);
  }
  .dp-row:last-child { border-bottom: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .dp-row { animation: dpin 0.5s ease backwards; animation-delay: calc(var(--i) * 90ms); }
    .dp-pulse { animation: dppulse 2.4s ease-in-out infinite; }
  }

  .dp-l { min-width: 0; }
  .dp-sym { font-family: var(--font-mono); font-size: 13px; font-weight: 800; display: block; }
  .dp-name {
    font-size: 10px; color: var(--ink-3); display: block; margin-top: 2px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }

  .dp-r { display: flex; align-items: center; gap: 10px; flex: none; }
  .dp-tag {
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.09em; font-weight: 700;
    text-transform: uppercase; background: var(--panel-2); border: 1px solid var(--line);
    padding: 3px 6px; color: var(--ink-2);
  }
  .dp-px { font-family: var(--font-mono); font-size: 12px; font-weight: 700; }
  .dp-pct { font-family: var(--font-mono); font-size: 11px; min-width: 52px; text-align: right; }
  .dp-pct.up { color: var(--up); }
  .dp-pct.dn { color: var(--dn); }

  .dp-foot {
    display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-top: var(--rule); background: var(--panel-2);
  }
  .dp-meta { display: flex; gap: 12px; flex-wrap: wrap; }
  .dp-meta em {
    font-style: normal; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em;
    text-transform: uppercase; color: var(--ink-2);
  }
  .dp-as {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 9.5px; color: var(--ink-3);
  }

  @keyframes dppulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

  /* TRANSFORM ONLY — no opacity. An opacity fade needs a from-state of 0, and every fill mode
     that makes the delay look right (`both`, `backwards`) also paints that 0 before the animation
     starts. Anything that renders without advancing the animation then sees an empty panel. A
     slide with no fade cannot fail that way: the worst case is content sitting in its final
     position, which is exactly what we want. */
  @keyframes dpin { from { transform: translateY(7px); } to { transform: none; } }

  @media (max-width: 420px) {
    .dp-name { display: none; }
    .dp-tag { display: none; }
    .dp-r { gap: 8px; }
  }

  /* No reduce-branch needed: the no-preference block above is the only place animation is added,
     so reduced-motion and "animation never ran" both land on the same fully-visible default. */
</style>
