---
import ctx from '../../data/public/context.json';

/* =============================================================================================
   TICKER TAPE — a scrolling board of REAL PSX symbols and REAL day moves.

   Real data, not a mockup, and that is deliberate rather than precious. CLAUDE.md Rule 2 forbids
   a price that came from memory, and inventing a move next to a real listed symbol is a false
   claim about a real company — the exact thing the desk exists not to do. The public slice
   (`scripts/build_public_slice.py`) already carries the board, so an honest version costs nothing.

   It refreshes per deploy, not live, which is why the strip is stamped with the date it came
   from. That stamp is load-bearing: without it a stale build quietly implies real-time prices.

   CSS-only marquee: the track holds two copies of the row and translates -50%, so the loop is
   seamless with no JS, no layout thrash and nothing to hydrate. Under
   `prefers-reduced-motion` it stops and becomes a plain scrollable strip — motion is decoration
   here, and the data must survive without it.
   ============================================================================================= */

interface Props {
  /** Rows to show. The slice carries 15; fewer reads calmer on a landing page. */
  limit?: number;
}
const { limit = 15 } = Astro.props;

const board = ((ctx as any)?.board ?? []).slice(0, limit) as { sym: string; pct: number }[];
const asOf = (ctx as any)?.as_of ?? (ctx as any)?.generated ?? null;

// Two copies for the seamless loop. `aria-hidden` on the duplicate so a screen reader reads the
// list once rather than twice.
const rows = board.length ? board : [];
---

{
  rows.length > 0 && (
    <div class="tape" role="group" aria-label="Recent PSX moves from the desk's data layer">
      <div class="tape-track">
        {[0, 1].map((copy) => (
          <div class="tape-row" aria-hidden={copy === 1 ? 'true' : undefined}>
            {rows.map((r) => (
              <span class="tape-i">
                <b>{r.sym}</b>
                <i class={r.pct > 0 ? 'up' : r.pct < 0 ? 'dn' : ''}>
                  {r.pct > 0 ? '+' : ''}
                  {r.pct.toFixed(2)}%
                </i>
              </span>
            ))}
          </div>
        ))}
      </div>
      {asOf && <p class="tape-s">Real closes from the desk's data layer · {asOf}</p>}
    </div>
  )
}

<style>
  .tape { border: var(--rule); background: var(--ink-1); overflow: hidden; }
  .tape-track { display: flex; width: max-content; animation: tape 44s linear infinite; }
  .tape-row { display: flex; }
  .tape-i {
    display: inline-flex; align-items: baseline; gap: 7px; padding: 11px 16px;
    border-right: 1px solid #2a2a28; white-space: nowrap;
  }
  .tape-i b {
    font-family: var(--font-mono); font-size: 11px; font-weight: 800; color: var(--bg);
    letter-spacing: 0.04em;
  }
  .tape-i i { font-style: normal; font-family: var(--font-mono); font-size: 10.5px; color: #8f8f88; }
  /* Brighter than the light-mode tokens: --up/--dn are tuned for a pale background and go muddy
     on near-black. These are the same hues lifted for contrast on --ink-1. */
  .tape-i i.up { color: #4ec38a; }
  .tape-i i.dn { color: #ef7d63; }

  /* #8f8f88, not #6f6f72: this is the one line under the tape that says the numbers are real, and
     against #101314 the darker grey landed at about 4:1 — under AA for text this small. Same muted
     tone every other dark surface on the site uses. */
  .tape-s {
    margin: 0; padding: 7px 16px; border-top: 1px solid #2a2a28; background: #101314;
    font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.08em;
    text-transform: uppercase; color: #8f8f88;
  }

  /* The caption is provenance, not part of the marquee it sits under — the tape can stay
     decorative at 10.5px, but "real closes from the desk's data layer" is the sentence that makes
     the whole component mean anything. It wraps freely, so width is not a constraint. */
  @media (max-width: 720px) {
    .tape-s { font-size: 11px; letter-spacing: 0.06em; }
  }

  @keyframes tape {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tape-track { animation: none; width: 100%; overflow-x: auto; }
    .tape-row[aria-hidden='true'] { display: none; }
  }
</style>
