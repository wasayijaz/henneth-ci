---
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import { site } from '../site.config.ts';

/* =============================================================================================
   The shell every public calculator sits in.

   ONE CALCULATOR PER URL, deliberately. The desk puts all seven behind tabs on a single route,
   which is right for an app and wrong for search: seven tools on one URL means one title, one H1
   and one description competing across seven different queries, so the page ranks for none of
   them. Each tool here gets its own URL, its own H1 matching the query it targets, and its own
   FAQ block.

   Every page also carries real explanatory prose under the tool (the `<slot />`). A bare widget
   with no text is the other common way calculator pages fail — there is nothing for Google to
   read, and nothing that earns the visitor's trust in the number.
   ============================================================================================= */

export interface Field {
  field: string;
  label: string;
  value: number;
  step?: number;
  prefix?: string;
  suffix?: string;
}
export interface Faq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  h1: string;
  description: string;
  path: string;
  lead: string;
  calc: string;
  fields: Field[];
  faqs?: Faq[];
  /** ISO date the page's figures/method were last checked. Shown, and used in schema. */
  updated: string;
  related?: { href: string; label: string }[];
}

const { title, h1, description, path, lead, calc, fields, faqs = [], updated, related = [] } =
  Astro.props;

const url = new URL(path, site.url).href;

/* BreadcrumbList and FAQPage are NOT built here — Base emits both, derived from `path` and from the
   `faq` prop below. Two blocks of the same type on one page is a conflict Google resolves by
   ignoring the trail, and the hand-written version here had already drifted (it labelled the middle
   crumb "Tools" while the header calls that section Calculators). `crumbLeaf={h1}` keeps the trail
   ending in the short on-page heading rather than the long search-facing <title>. */

// WebApplication rather than Article: the primary thing on the page is a working tool, and that
// is what the result should describe. `price: 0` is true and stays true — these are free forever,
// unlike the desk itself, so this claim does not depend on site.earlyAccess the way the app's does.
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: h1,
  url,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  browserRequirements: 'Requires JavaScript',
  description,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
  dateModified: updated,
};

const updatedLabel = new Date(updated).toLocaleDateString('en-PK', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={title}
  description={description}
  path={path}
  active="tools"
  crumbLeaf={h1}
  faq={faqs.length ? faqs : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
  </Fragment>

  <section class="section-tight">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span> <a href="/tools/">Tools</a>
      </nav>
      <h1 class="tool-h1">{h1}</h1>
      <p class="lead tool-lead">{lead}</p>
      <p class="muted upd">Last checked {updatedLabel} · free, no sign-up</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="calcwrap" data-calc={calc}>
        <div class="calcin">
          {
            fields.map((f) => (
              <label class="cfield">
                <span class="cflabel">{f.label}</span>
                <span class="cfin">
                  {f.prefix && <i class="cfaffix">{f.prefix}</i>}
                  <input
                    type="number"
                    inputmode="decimal"
                    data-field={f.field}
                    value={f.value}
                    step={f.step ?? 1}
                    min="0"
                  />
                  {f.suffix && <i class="cfaffix">{f.suffix}</i>}
                </span>
              </label>
            ))
          }
        </div>
        <div class="calcout" data-out>
          <noscript>This calculator needs JavaScript enabled.</noscript>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <div class="toolprose">
        <slot />
      </div>
    </div>
  </section>

  {/* The shared <Faq>, not a local copy. Two FAQ treatments on one site is two things to keep in
      step, and only one of them fired the faq_expanded event — which question a visitor opens is
      the cheapest read there is on why they came. */}
  <Faq items={faqs} heading="Common questions" />

  {
    related.length > 0 && (
      <section class="section-tight">
        <div class="wrap">
          <h2 class="faq-h">Other calculators</h2>
          <div class="rel">
            {related.map((r) => (
              <a class="relx" href={r.href}>
                {r.label}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section band-dark">
    <div class="wrap tool-cta">
      <div>
        <p class="kicker dr-kicker">The desk</p>
        <h2>These numbers are the easy part</h2>
        <p class="lead tool-cta-lead">
          Henneth reads PSX companies in plain English — what the business earns, what it's worth,
          what changed this week. Research, not advice.
        </p>
      </div>
      <a class="btn" href={`${site.appUrl}/?auth=signup`} rel="noopener">Get started</a>
    </div>
  </section>
</Base>

<style>
  .crumbs { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  @media (hover: hover) {
    .crumbs a:hover { color: var(--ink-1); }
  }
  .crumbs span { margin: 0 6px; }

  .tool-h1 { max-width: 22ch; }
  .tool-lead { max-width: 62ch; margin-top: 12px; }
  .upd { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 14px; }

  .calcwrap { display: grid; grid-template-columns: 300px 1fr; gap: 1.5px; background: var(--line); border: var(--rule); }
  .calcin { background: var(--panel-2); padding: 22px; display: flex; flex-direction: column; gap: 16px; }
  .calcout { background: var(--panel); padding: 22px; }

  .cfield { display: block; }
  .cflabel { display: block; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 6px; }
  .cfin { display: flex; align-items: center; border: 1.5px solid var(--line); background: var(--panel); }
  .cfin:focus-within { border-color: var(--ink-1); }
  .cfaffix { font-family: var(--font-mono); font-size: 11px; color: var(--ink-3); padding: 0 10px; font-style: normal; }
  .cfin input { font-family: var(--font-mono); font-size: 13px; font-weight: 600; padding: 11px 10px; border: 0; background: none; width: 100%; color: var(--ink-1); }
  .cfin input:focus { outline: none; }

  /* Result tiles. Class names match the desk's (sumstrip/sumtile/tnote) so the two implementations
     stay visually recognisable as the same tool. */
  .calcout :global(.sumstrip) { display: grid; gap: 1.5px; background: var(--line); border: var(--rule); }
  .calcout :global(.sumstrip.s3) { grid-template-columns: repeat(3, 1fr); }
  .calcout :global(.sumstrip.s4) { grid-template-columns: repeat(4, 1fr); }
  .calcout :global(.sumtile) { background: var(--panel); padding: 14px; display: flex; flex-direction: column; gap: 5px; }
  .calcout :global(.sumtile .sk) { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); }
  .calcout :global(.sumtile b) { font-family: var(--font-mono); font-size: 17px; font-weight: 800; }
  .calcout :global(.sumtile b.up) { color: var(--up); }
  .calcout :global(.sumtile b.dn) { color: var(--dn); }
  .calcout :global(.sumtile i) { font-style: normal; font-size: 10.5px; color: var(--ink-3); }

  .calcout :global(.tnote) { margin-top: 16px; font-size: 12px; line-height: 1.7; color: var(--ink-2); border-left: var(--rule); padding-left: 14px; }
  .calcout :global(.tnote.warn) { border-left-color: var(--warn); }

  .calcout :global(.tbars) { display: flex; align-items: flex-end; gap: 3px; height: 120px; margin-top: 18px; }
  .calcout :global(.tbar) { position: relative; flex: 1; height: 100%; display: flex; align-items: flex-end; }
  .calcout :global(.tb-grow) { position: absolute; bottom: 0; width: 100%; background: var(--up-soft); }
  .calcout :global(.tb-put) { position: absolute; bottom: 0; width: 100%; background: var(--ink-1); }
  .calcout :global(.tbar i) { position: absolute; bottom: -16px; width: 100%; text-align: center; font-family: var(--font-mono); font-size: 8px; color: var(--ink-3); font-style: normal; }
  .calcout :global(.tlegend) { display: flex; gap: 16px; margin-top: 24px; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); }
  .calcout :global(.tlegend .sw) { display: inline-block; width: 9px; height: 9px; margin-right: 5px; vertical-align: -1px; }
  .calcout :global(.tlegend .sw.put) { background: var(--ink-1); }
  .calcout :global(.tlegend .sw.grow) { background: var(--up-soft); }

  .toolprose { max-width: 68ch; }
  .toolprose :global(h2) { margin: 36px 0 12px; font-size: 16px; }
  .toolprose :global(h2:first-child) { margin-top: 0; }
  .toolprose :global(p) { margin: 0 0 15px; font-size: 13px; line-height: 1.75; color: var(--ink-2); }
  .toolprose :global(ul) { margin: 0 0 15px; padding-left: 20px; font-size: 13px; line-height: 1.75; color: var(--ink-2); }
  .toolprose :global(li) { margin-bottom: 6px; }
  .toolprose :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .toolprose :global(strong) { color: var(--ink-1); }


  /* Outline-as-rule, not the gap-as-rule trick the strips use. This is a WRAPPING flex row: the
     moment it wraps, the trailing space on the short row is container background — i.e. a bar of
     --line hanging off the end of the last chip. Each chip drawing its own 1.5px outline against a
     1.5px gap puts adjacent outlines exactly on top of each other, and an unfilled tail is page. */
  .rel { display: flex; flex-wrap: wrap; gap: 1.5px; width: fit-content; }
  .relx { background: var(--panel); padding: 11px 16px; font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; text-decoration: none; outline: 1.5px solid var(--line); outline-offset: 0; }
  @media (hover: hover) {
    .relx { transition: background 0.16s ease, outline-color 0.16s ease; }
    .relx:hover { background: var(--panel-2); outline-color: var(--ink-1); position: relative; z-index: 1; }
  }

  .tool-cta { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
  .dr-kicker { color: #8f8f88; }
  .tool-cta-lead { color: #c8c8c0; margin: 0; max-width: 52ch; }

  @media (max-width: 900px) {
    .calcwrap { grid-template-columns: 1fr; }
    /* s4 halves cleanly; s3 does NOT. .sumstrip draws its rules with the gap over a --line
       background, so three tiles in two columns leave the fourth slot painting as a solid grey
       block. A three-up strip goes straight to one column instead. */
    .calcout :global(.sumstrip.s4) { grid-template-columns: repeat(2, 1fr); }
    .calcout :global(.sumstrip.s3) { grid-template-columns: 1fr; }
    .tool-cta { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .calcout :global(.sumstrip.s3), .calcout :global(.sumstrip.s4) { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { mountCalculators } from '../scripts/calculators.ts';
  // Anchors are injected per page by the build (see tools/*.astro) when the tool needs a real
  // Pakistani figure. Absent anchors are handled by each calculator, not faked here.
  mountCalculators((window as any).__hAnchors || {});
</script>
