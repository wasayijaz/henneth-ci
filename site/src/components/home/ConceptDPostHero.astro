          </button>
          <div style="display:grid;grid-template-rows:1fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="display:grid;grid-template-rows:&#123;&#123; whoRows0 &#125;&#125;;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)">
            <div style="overflow:hidden;min-height:0">
              <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:1;transform:translateY(0px);transition:opacity .35s ease .12s,transform .4s cubic-bezier(.22,1,.36,1) .12s" data-tpl-style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:&#123;&#123; whoOpacity0 &#125;&#125;;transform:translateY(&#123;&#123; whoTranslate0 &#125;&#125;px);transition:opacity .35s ease &#123;&#123; whoDelay0 &#125;&#125;,transform .4s cubic-bezier(.22,1,.36,1) &#123;&#123; whoDelay0 &#125;&#125;">
                <div></div>
                 <div style="font-size:12.5px;line-height:1.8;color:rgba(242,242,238,.62);max-width:560px">Start with Today and the 14-lesson Learn path: plain-English macro, what moved and why, and questions worth asking before making a decision.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="hn-who-row" style="border-bottom:1px solid rgba(242,242,238,.14);background:transparent;transition:background .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="border-bottom:1px solid rgba(242,242,238,.14);background:&#123;&#123; whoRowBg1 &#125;&#125;;transition:background .45s cubic-bezier(.22,1,.36,1)">
          <button type="button" class="hn-as-btn" data-who-row="1" aria-expanded="false" style="display:grid;grid-template-columns:70px 1fr 30px;gap:20px;align-items:center;padding:22px 4px;cursor:pointer;margin:0 -4px;transition:padding .3s cubic-bezier(.22,1,.36,1)">
            <span style="font-size:10px;letter-spacing:.08em;color:rgba(242,242,238,.4);transition:color .3s ease">(002)</span>
             <span style="font-size:19px;font-weight:700;letter-spacing:-0.01em">Active</span>
            <span style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(0deg)" data-tpl-style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(&#123;&#123; whoRot1 &#125;&#125;deg)">+</span>
          </button>
          <div style="display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="display:grid;grid-template-rows:&#123;&#123; whoRows1 &#125;&#125;;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)">
            <div style="overflow:hidden;min-height:0">
              <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:0;transform:translateY(-6px);transition:opacity .35s ease 0s,transform .4s cubic-bezier(.22,1,.36,1) 0s" data-tpl-style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:&#123;&#123; whoOpacity1 &#125;&#125;;transform:translateY(&#123;&#123; whoTranslate1 &#125;&#125;px);transition:opacity .35s ease &#123;&#123; whoDelay1 &#125;&#125;,transform .4s cubic-bezier(.22,1,.36,1) &#123;&#123; whoDelay1 &#125;&#125;">
                <div></div>
                 <div style="font-size:12.5px;line-height:1.8;color:rgba(242,242,238,.62);max-width:560px">Use the screener and backtester on names you already follow. About 52 rule-based strategies, long histories and a position-size calculator you drive. The desk shows behaviour; you decide what to do.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="hn-who-row" style="border-bottom:1px solid rgba(242,242,238,.14);background:transparent;transition:background .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="border-bottom:1px solid rgba(242,242,238,.14);background:&#123;&#123; whoRowBg2 &#125;&#125;;transition:background .45s cubic-bezier(.22,1,.36,1)">
          <button type="button" class="hn-as-btn" data-who-row="2" aria-expanded="false" style="display:grid;grid-template-columns:70px 1fr 30px;gap:20px;align-items:center;padding:22px 4px;cursor:pointer;margin:0 -4px;transition:padding .3s cubic-bezier(.22,1,.36,1)">
            <span style="font-size:10px;letter-spacing:.08em;color:rgba(242,242,238,.4);transition:color .3s ease">(003)</span>
             <span style="font-size:19px;font-weight:700;letter-spacing:-0.01em">Long-term</span>
            <span style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(0deg)" data-tpl-style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(&#123;&#123; whoRot2 &#125;&#125;deg)">+</span>
          </button>
          <div style="display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="display:grid;grid-template-rows:&#123;&#123; whoRows2 &#125;&#125;;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)">
            <div style="overflow:hidden;min-height:0">
              <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:0;transform:translateY(-6px);transition:opacity .35s ease 0s,transform .4s cubic-bezier(.22,1,.36,1) 0s" data-tpl-style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:&#123;&#123; whoOpacity2 &#125;&#125;;transform:translateY(&#123;&#123; whoTranslate2 &#125;&#125;px);transition:opacity .35s ease &#123;&#123; whoDelay2 &#125;&#125;,transform .4s cubic-bezier(.22,1,.36,1) &#123;&#123; whoDelay2 &#125;&#125;">
                <div></div>
                 <div style="font-size:12.5px;line-height:1.8;color:rgba(242,242,238,.62);max-width:560px">Open Value and the dividend calendar. Four valuation methods per name with the working expandable, ex-dates tracked, and a portfolio X-ray that works from what you already hold.</div>
              </div>
            </div>
          </div>
        </div>
        <div class="hn-who-row" style="border-bottom:1px solid rgba(242,242,238,.14);background:transparent;transition:background .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="border-bottom:1px solid rgba(242,242,238,.14);background:&#123;&#123; whoRowBg3 &#125;&#125;;transition:background .45s cubic-bezier(.22,1,.36,1)">
          <button type="button" class="hn-as-btn" data-who-row="3" aria-expanded="false" style="display:grid;grid-template-columns:70px 1fr 30px;gap:20px;align-items:center;padding:22px 4px;cursor:pointer;margin:0 -4px;transition:padding .3s cubic-bezier(.22,1,.36,1)">
            <span style="font-size:10px;letter-spacing:.08em;color:rgba(242,242,238,.4);transition:color .3s ease">(004)</span>
             <span style="font-size:19px;font-weight:700;letter-spacing:-0.01em">Astro</span>
            <span style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(0deg)" data-tpl-style="font-size:17px;text-align:right;color:rgba(242,242,238,.6);display:inline-block;transition:transform .4s cubic-bezier(.22,1,.36,1),color .3s ease;transform:rotate(&#123;&#123; whoRot3 &#125;&#125;deg)">+</span>
          </button>
          <div style="display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="display:grid;grid-template-rows:&#123;&#123; whoRows3 &#125;&#125;;transition:grid-template-rows .45s cubic-bezier(.22,1,.36,1)">
            <div style="overflow:hidden;min-height:0">
              <div style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:0;transform:translateY(-6px);transition:opacity .35s ease 0s,transform .4s cubic-bezier(.22,1,.36,1) 0s" data-tpl-style="display:grid;grid-template-columns:70px 1fr;gap:20px;padding-bottom:24px;opacity:&#123;&#123; whoOpacity3 &#125;&#125;;transform:translateY(&#123;&#123; whoTranslate3 &#125;&#125;px);transition:opacity .35s ease &#123;&#123; whoDelay3 &#125;&#125;,transform .4s cubic-bezier(.22,1,.36,1) &#123;&#123; whoDelay3 &#125;&#125;">
                <div></div>
                 <div style="font-size:12.5px;line-height:1.8;color:rgba(242,242,238,.62);max-width:560px">Optional and educational. The sidereal lens is computed and backtested like every other rule; 2,589 tested hypotheses produced zero survivors after correction. Cast a chart for context, never a forecast or instruction.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- THE ENGINE: inputs feeding one production line -->
    <div class="hn-rv hn-rv-r" style="padding:0 44px 56px">
      <div style="display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:26px">
        <div style="font-size:30px;font-weight:700;letter-spacing:-0.015em;max-width:640px;line-height:1.15">One desk. One published edition.</div>
        <div style="min-width:210px;text-align:right">
          <div style="font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:6px">Next edition</div>
          <div style="height:5px;background:var(--hair);position:relative;overflow:hidden"><div style="position:absolute;left:0;top:0;bottom:0;background:var(--accent);animation:hnEditionProgress 6s linear infinite"></div></div>
          <div style="font-size:8px;letter-spacing:.06em;color:var(--ink3);margin-top:6px;animation:hnEditionLabel 6s steps(1) infinite">Preparing…</div>
        </div>
      </div>

      <div style="font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink3);margin-bottom:10px">Inputs feeding the line</div>
      <div style="font-size:11.5px;line-height:1.7;color:var(--ink3);margin:-2px 0 18px;max-width:640px">Before the market opens, the desk reads covered PSX names, global index and sector context, the macro calendar and the optional astro lens. Intraday cycles monitor; the Desk Room publishes on a weekly rotation. <span style="color:var(--ink1);font-weight:700">23 global index/sector-ETF markets for context — no US stock picks or signals.</span></div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:0">
        <div style="border:1.5px solid var(--line);background:var(--panel);padding:18px 16px;position:relative;overflow:hidden">
          <div style="position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);opacity:.9;animation:hnFeedPulse 6s ease-in-out infinite;animation-delay:0s"></div>
          <div style="font-family:'Pixelify Sans',monospace;font-size:26px;line-height:1;margin-bottom:6px">550+</div>
          <div style="font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3)">PSX names covered</div>
        </div>
        <div style="border:1.5px solid var(--line);background:var(--panel);padding:18px 16px;position:relative;overflow:hidden">
          <div style="position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);opacity:.9;animation:hnFeedPulse 6s ease-in-out infinite;animation-delay:1.5s"></div>
          <div style="font-family:'Pixelify Sans',monospace;font-size:26px;line-height:1;margin-bottom:6px">{globalCount}</div>
          <div style="font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3)">Global markets tracked</div>
        </div>
        <div style="border:1.5px solid var(--line);background:var(--panel);padding:18px 16px;position:relative;overflow:hidden">
          <div style="position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);opacity:.9;animation:hnFeedPulse 6s ease-in-out infinite;animation-delay:3s"></div>
          <div style="font-family:'Pixelify Sans',monospace;font-size:26px;line-height:1;margin-bottom:6px">19yrs</div>
          <div style="font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3)">Of price history tested</div>
        </div>
        <div style="border:1.5px solid var(--line);background:var(--panel);padding:18px 16px;position:relative;overflow:hidden">
          <div style="position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent);opacity:.9;animation:hnFeedPulse 6s ease-in-out infinite;animation-delay:4.5s"></div>
          <div style="font-family:'Pixelify Sans',monospace;font-size:26px;line-height:1;margin-bottom:6px">2,589</div>
          <div style="font-size:8.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--ink3)">Astro hypotheses tested</div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:14px">
        <div style="display:flex;justify-content:center"><div style="width:1px;height:26px;background:var(--hair)"></div></div>
        <div style="display:flex;justify-content:center"><div style="width:1px;height:26px;background:var(--hair)"></div></div>
        <div style="display:flex;justify-content:center"><div style="width:1px;height:26px;background:var(--hair)"></div></div>
        <div style="display:flex;justify-content:center"><div style="width:1px;height:26px;background:var(--hair)"></div></div>
      </div>
      <div style="height:1px;background:var(--line);margin-bottom:26px;position:relative">
        <div style="position:absolute;top:-2px;width:6px;height:5px;background:var(--accent);animation:hnSpinePulse 6s linear infinite"></div>
      </div>

      <div class="hn-stage-row" role="region" aria-label="Pipeline stages" tabindex="0" style="display:flex;align-items:stretch;gap:8px">
        <div class="hn-stage" style="flex:1.35;border:1.5px solid var(--line);background:var(--panel);color:var(--ink1);padding:16px 12px;position:relative;overflow:hidden;transition:background .3s ease">
          <div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(184,134,11,.16),transparent);animation:hnStageSweep 6s linear infinite;animation-delay:0s"></div>
          <div style="position:relative">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
              <span style="font-size:8px;letter-spacing:.08em;color:var(--ink3)">01</span>
              <span style="width:4px;height:4px;background:var(--hair);animation:hnLedBlink 2.4s ease-in-out infinite;animation-delay:0s"></span>
            </div>
            <div style="font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;margin-bottom:8px;white-space:nowrap">Universe</div>
            <div style="font-size:7.5px;letter-spacing:.04em;color:var(--ink3);height:10px;overflow:hidden">
              <div style="animation:hnMicroRoll 6s steps(1) infinite;animation-delay:0s">+23 in · 14 out</div>
            </div>
          </div>
        </div>
        <div class="hn-stage" style="flex:.9;border:1.5px solid var(--line);background:var(--panel);color:var(--ink1);padding:16px 12px;position:relative;overflow:hidden;transition:background .3s ease">
          <div style="position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(184,134,11,.16),transparent);animation:hnStageSweep 6s linear infinite;animation-delay:.8s"></div>
          <div style="position:relative">
