            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:var(--ink1);border:1px solid var(--line);padding:4px 10px;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:0s">MARKET DATA</div>
            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:var(--ink1);border:1px solid var(--line);padding:4px 10px;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:.9s">VALUATION</div>
            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:var(--ink1);border:1px solid var(--line);padding:4px 10px;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:1.8s">TECHNICAL + FUNDAMENTAL</div>
            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:var(--accent);border:1px solid rgba(184,134,11,.5);padding:4px 10px;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:2.7s">ASTROLOGY</div>
            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:var(--ink1);border:1px solid var(--line);padding:4px 10px;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:3.6s">DEBATE</div>
            <div class="hn-eng-stage" style="font-size:8px;letter-spacing:.06em;color:#f4f4f0;background:var(--ink1);padding:5px 12px;font-weight:700;animation:hnEngPulse 7s ease-in-out infinite;animation-delay:4.5s">PUBLISHED</div>
          </div>
          <div style="position:absolute;left:50%;top:34px;bottom:14px;width:1px;background:var(--hair);transform:translateX(-50%)"></div>
          <div style="position:absolute;left:50%;top:34px;width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#b8860b;box-shadow:0 0 6px rgba(184,134,11,.6);animation:hnEngTravel 7s linear infinite"></div>
        </div>
        <div style="padding-bottom:14px">
          <div style="font-size:13.5px;line-height:1.8;color:var(--ink3);max-width:520px"><span style="color:var(--ink1);font-weight:700">No tips, just published research.</span> Covered PSX names are valued four ways, tested on long histories, and debated in the open. The desk does the homework and leaves the argument on the record.</div>
        </div>
      </div>
    </div>
    <!-- WHO IT'S FOR -->
    <div data-who-section class="hn-rv hn-rv-r" style="padding:0 44px 56px">
      <div style="background:var(--dark);color:#f2f2ee;border:1.5px solid var(--line);padding:52px 44px 44px">
        <div style="display:flex;align-items:end;justify-content:space-between;margin-bottom:36px;gap:40px">
          <div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px"><div style="width:11px;height:11px;border:1.5px solid var(--accent);display:flex;align-items:center;justify-content:center"><div style="width:3px;height:3px;background:var(--accent)"></div></div><span style="font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:rgba(242,242,238,.6)">Where do you start</span></div>
             <h2 style="font-size:34px;line-height:1.15;font-weight:700;margin:0;letter-spacing:-0.015em">Choose your starting point</h2>
          </div>
           <div style="font-size:11.5px;line-height:1.7;color:rgba(242,242,238,.5);max-width:270px;text-align:right">Four ways into the same publication — begin with what you need today.</div>
        </div>
        <div class="hn-who-row" style="border-bottom:1px solid rgba(242,242,238,.14);background:rgba(242,242,238,.055);transition:background .45s cubic-bezier(.22,1,.36,1)" data-tpl-style="border-bottom:1px solid rgba(242,242,238,.14);background:&#123;&#123; whoRowBg0 &#125;&#125;;transition:background .45s cubic-bezier(.22,1,.36,1)">
          <button type="button" class="hn-as-btn" data-who-row="0" aria-expanded="true" style="display:grid;grid-template-columns:70px 1fr 30px;gap:20px;align-items:center;padding:22px 4px;cursor:pointer;margin:0 -4px;transition:padding .3s cubic-bezier(.22,1,.36,1)">
            <span style="font-size:10px;letter-spacing:.08em;color:rgba(242,242,238,.4);transition:color .3s ease">(001)</span>
