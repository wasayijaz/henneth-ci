---
import '../../styles/home-concept-d-posthero.css';
interface Props { appUrl?: string; globalCount?: number; faqs?: { q: string; a: string }[]; plans?: { name?: string; href?: string; featured?: boolean; soon?: boolean }[] }
const { appUrl = '/research/', globalCount = 23, faqs = [], plans = [] } = Astro.props;
const faqDefaults = [{"q":"Does the desk tell me what to buy?","a":"No — and it never will. Henneth Desk publishes research, not advice: no buy or sell calls, no price targets, no stop levels on named stocks. It shows the valuation working, the historical behaviour, and both sides of the argument. The decision, and the order, are always yours."},{"q":"Is this regulated investment advice?","a":"No. Henneth Desk publishes general market and sector commentary, statistical summaries of reported financials, education, and tools you run yourself — the category set out in Regulation 2(h) of the SECP Research Analyst Regulations 2015. It is not personalised advice, we are not registered as a research analyst or adviser, and we are not affiliated with the Pakistan Stock Exchange or the SECP."},{"q":"Why is astrology in a research product?","a":"Because it is testable, and almost nobody tests it. The desk computes sidereal positions to the degree, writes down what tradition claims each one governs, then backtests it against nineteen years of PSX prices on the same bar as every other strategy. So far 2,589 hypotheses, none survived correction — and the desk publishes that result rather than burying it."},{"q":"What does it actually cost?","a":"Nothing right now. The whole desk is open in early access — no card, no trial timer. When billing switches on the free tier stays, and we will tell you before anything changes."},{"q":"How current is the data?","a":"The desk is daily-timeframe and end-of-day driven, re-read every cycle. Data comes from third parties and can be delayed or wrong, so check any number against your broker before acting on it. Nothing is quoted from memory: if the data layer does not have a number, the copy says unknown rather than guessing."}];
const faqList = faqs.length ? faqs.slice(0, 5) : faqDefaults;
const planName = (i: number, fallback: string) => plans[i]?.name ?? fallback;
const planPrice = (i: number) => (plans[i]?.soon ? '—' : 'Free');
const planHref = (i: number) => (!plans[i] || plans[i].soon ? undefined : (plans[i].href || appUrl));
---
<div class="cd-posthero" data-cd-posthero style="display:flex;flex-direction:column">
    <!-- STATEMENT -->
    <div class="hn-rv hn-rv-l" style="padding:64px 44px 56px;border-top:1px solid var(--hair)">
      <h2 data-statement-heading style="font-size:42px;line-height:1.32;font-weight:700;margin:0 0 40px;letter-spacing:-0.02em;max-width:860px;text-wrap:pretty"><span class="hn-hword" style="color:var(--ink1);transition:color .4s ease">Honest work</span> <span class="hn-hword" style="color:var(--ink3);transition:color .4s ease">on every covered name,</span><br><span class="hn-hword" style="color:var(--ink3);transition:color .4s ease">with the working shown</span> <span class="hn-hword" style="color:var(--ink3);transition:color .4s ease">and the losses left in</span></h2>
      <div style="display:grid;grid-template-columns:300px 1fr;gap:48px;align-items:end">
        <div style="position:relative;height:250px;width:300px;background:var(--panel);border:1.5px solid var(--line);overflow:hidden">
          <div style="position:absolute;top:10px;left:14px;font-size:7px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink3)">The argument, built</div>
