---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config.ts';

const enter = (p: string) => `${site.appUrl}/?plan=${p}`;

/* Three of these now point at REAL URLs rather than anchors on this page. An anchor cannot rank:
   four audiences sharing one URL means one title and one description competing across four
   different searches, so the page ranks for none of them well. Each use-case page targets its own
   commercial-intent query, and this page becomes the hub that links them.

   The astrology segment stays an anchor for now — it has no separate page yet, and shipping a thin
   fourth variant purely for symmetry is the doorway pattern the others are built to avoid. */
const jump = [
  { tag: '01', title: 'New investors', href: '/solutions/psx-research-for-new-investors', icon: 'learn' },
  { tag: '02', title: 'Screener & strategies', href: '/solutions/psx-screener-and-strategies', icon: 'strategies' },
  { tag: '03', title: 'Dividend calendar & yields', href: '/solutions/psx-dividend-calendar-and-yields', icon: 'dividends' },
  { tag: '04', title: 'The astrology-curious', href: '#astro', icon: 'astro' },
  { tag: '05', title: 'Brokers & institutions', href: '/solutions/psx-broker-research-scorecard', icon: 'portfolio' },
  { tag: '06', title: 'Company fair value', href: '/solutions/psx-company-fair-value', icon: 'value' },
  { tag: '07', title: 'Market today', href: '/solutions/psx-market-today', icon: 'clock' },
];

/* Typed rather than inferred: without this the array widens to a union, and `s.cta2` — present on
   three members and absent on the broker one — becomes an editor error on every access. */
type Segment = {
  id: string; icon: string; tag: string; title: string; body: string; points: string[];
  cta: string; href: string; solid: boolean; panelTitle: string; plan: string;
  rows: [string, string, number][];
  cta2?: string; href2?: string;
};

const segments: Segment[] = [
  {
    id: 'retail',
    icon: 'learn',
    tag: '01 · Retail investors',
    title: 'Do your own homework — properly',
    body: 'For the self-directed investor who wants a professional workflow without a professional’s hours. The desk reads the market, values every name and shows the working, so your decisions rest on evidence — not tips.',
    points: [
      'A plain-English daily read of the whole market',
      'Four-way valuations with the maths exposed',
      'A dated, graded scorecard you can check',
    ],
    cta: 'Get started',
    href: enter('investor'),
    solid: true,
    /* SECONDARY LINK — a free page on this site, no account. Each segment gets the one that
       matches what it came here for: the investor gets the sizing calculator, because "how many
       shares" is the question that follows every read; the trader gets the global coverage list;
       the astrology reader gets the tested lens before being asked to cast anything. */
    cta2: 'Size a position free',
    href2: '/tools/position-size-calculator/',
    panelTitle: 'Investor · what you get',
    plan: site.earlyAccess ? 'Free now' : 'Rs 3,000/mo',
    rows: [
      ['Daily desk read', 'Included', 1],
      ['Board + valuations', 'Included', 1],
      ['The scorecard', 'Included', 1],
      ['Watchlist', 'Up to 20', 0],
    ],
  },
  {
    id: 'traders',
    icon: 'strategies',
    tag: '02 · Active traders',
    title: 'Move with the whole desk behind you',
    /* "on demand" removed (WEBSITE_BRIEF §5.2e). It described the desk as a service that answers
       requests. It publishes to a fixed calendar instead, and that distinction is the whole
       difference between a publication and an advisory relationship — not a wording preference. */
    body: 'For traders who want backtested signals and a full analyst debate — published on a schedule, not written on request. The Desk Room argues both sides of every ticker, no verdict handed down; you work out entry, size and exit yourself with the desk\'s own calculator.',
    points: [
      'Backtested-strategy signals + 19-year history',
      'The Desk Room debate & replay on any name',
      'Macro tape, US and global index context, dividends and earnings',
    ],
    cta: 'Get started',
    href: enter('pro'),
    solid: true,
    cta2: 'What the desk covers globally',
    href2: '/global-markets/',
    panelTitle: 'Pro · what you get',
    plan: site.earlyAccess ? 'Free now' : 'Rs 8,000/mo',
    rows: [
      ['Everything in Investor', 'Included', 1],
      ['The Desk Room', 'Full access', 1],
      ['Strategy backtests', 'Unlimited', 1],
      ['Watchlists', 'Unlimited', 1],
    ],
  },
  {
    id: 'astro',
    icon: 'astro',
    tag: '03 · The astrology-curious',
    title: 'Bring your chart. We’ll bring the evidence.',
    body: 'For anyone who reads their transits and wonders whether the market listens. Cast your birth chart in the browser, keep the daily gochara against it, and see the sky the desk computes — sidereal, Lahiri, nine grahas, ninety days ahead. Then see exactly how those claims held up against nineteen years of PSX prices.',
    points: [
      'Your birth chart, cast in the browser — no account to start',
      'The computed sky: nakshatra and pada, 90 days ahead',
      'Every traditional claim written down, then tested and scored',
    ],
    cta: 'Cast your chart free',
    href: `${site.appUrl}/cast`,
    solid: true,
    cta2: 'Read the tested lens first',
    href2: '/financial-astrology/',
    panelTitle: 'Astro · what you get',
    plan: 'Free',
    rows: [
      ['Birth chart & daily transits', 'Included', 1],
      ['The computed sky', '90-day horizon', 1],
      ['Traditional sector claims', 'Published', 1],
      ['Conditions with a proven edge', 'None yet — and we say so', 0],
    ],
  },
  {
    // DELIBERATELY MAKES NO CLAIMS (owner, 2026-07-20) — matches site.config.ts.
    // Every line here used to promise something unbuilt: multi-seat admin, a research API, data
    // feeds, white-label notes, compliance exports. None of that exists. The tier stays listed so
    // institutional readers know it is coming; what it contains is a conversation, not a page.
    id: 'brokers',
    icon: 'portfolio',
    tag: '04 · Brokers & institutions',
    title: 'For desks and institutions',
    body: 'A tier for brokerages and institutions is in build. We would rather talk about what your desk actually needs than publish a feature list we have not shipped yet.',
    points: [],
    cta: 'Talk to us',
    href: '/contact',
    solid: false,
    panelTitle: 'Broker',
    plan: 'In build',
    rows: [],
  },
];

/* The Broker column is intentionally blank throughout. It previously carried ticks for a research
   API, data feeds and white-label exports — none of which are built. A comparison table is the
   worst place to promise vapour, because a tick reads as a shipped fact. */
const caps: [string, string, string, string][] = [
  ['Daily desk read', '✓', '✓', ''],
  ['Board, valuations & scorecards', '✓', '✓', ''],
  ['The Desk Room debates', 'House view', 'Full transcripts', ''],
  ['Strategy backtests', '—', 'Unlimited', ''],
  ['Screener, scanner & scenarios', '—', '✓', ''],
  /* Research tier only. config/markets.json sets signals_enabled:false for the US book, so the
     honest cell says "context" — not a tick, which would read as "the desk trades these". */
  ['US & global index context', 'Context', 'Context', ''],
  ['Your birth chart & daily transits', '✓', '✓', ''],
  ['The computed sky (90-day horizon)', '✓', '✓', ''],
  ['Astro claims, tested & scored', '✓', '✓', ''],
];
---

<Base
  title="PSX research for investors, traders and brokers"
  crumbLeaf="Solutions"
  path="/solutions"
  active="solutions"
  description="Henneth for retail investors, active traders, the astrology-curious and brokers — PSX research in depth, global index context, on a published schedule."
>
  <section class="section-tight ph">
    <div class="wrap">
      <p class="kicker">Solutions</p>
      <h1>Built for how you actually invest</h1>
      <p class="lead ph-lead">
        One research desk, tuned to four ways of working the PSX. Same evidence, same scoring —
        different starting point.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="tilegrid jump">
      {jump.map((j) => (
        <a href={j.href} class="jump-i">
          <span class="jump-ic"><Icon name={j.icon} size={18} /></span>
          <span class="label muted">{j.tag}</span>
          <span class="jump-t">{j.title}</span>
          <span class="jump-a">›</span>
        </a>
      ))}
    </div>
  </section>

  {segments.map((s, i) => (
    <section class="section seg" id={s.id} data-alt={i % 2 === 1}>
      <div class="wrap seg-grid">
        <div>
          {/* s.icon, not jump[i].icon — indexing a parallel array would put the wrong mark on a
              section the moment either list is reordered, and nothing would fail loudly. */}
          <p class="kicker"><Icon name={s.icon} size={14} /> {s.tag}</p>
          <h2>{s.title}</h2>
          <p class="lead">{s.body}</p>
          <ul class="pts">
            {s.points.map((p) => <li>{p}</li>)}
          </ul>
          <div class="cta-row seg-cta">
            <a href={s.href} class:list={['btn', { 'btn-solid': s.solid }]} rel="noopener">{s.cta}</a>
            {s.cta2 && (
              <a href={s.href2} class="seg-2" data-ev="segment_free_link" data-ev-seg={s.id}>
                {s.cta2} <Icon name="arrow" size={12} />
              </a>
            )}
          </div>
        </div>
        <div class="card seg-panel">
          <div class="seg-ph">
            <span class="label">{s.panelTitle}</span>
            <span class="seg-plan">{s.plan}</span>
          </div>
          {s.rows.map(([k, v, good]) => (
            <div class="seg-row">
              <span class="muted">{k}</span>
              <span class:list={[{ up: good === 1 }]}>{v}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section band-panel">
    <div class="wrap">
      <p class="kicker">What each plan includes</p>
      <h2>Capability by plan</h2>
      <div class="captable">
        <table>
          <thead>
            <tr><th>Capability</th><th>Investor</th><th>Pro</th><th>Broker</th></tr>
          </thead>
          <tbody>
            {caps.map(([c, a, b, d]) => (
              <tr><td>{c}</td><td>{a}</td><td>{b}</td><td>{d}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <a href="/plans" class="btn cap-cta">See pricing ›</a>
    </div>
  </section>

  <section class="section band-dark center">
    <div class="wrap">
      <h2>Find your way onto the desk</h2>
      <p class="lead cta-lead">
        Start on the free desk, or talk to us about a broker seat. Research, not advice.
      </p>
      <div class="cta-row">
        <a href="/plans" class="btn">Get started</a>
        <a href="/contact" class="btn btn-ghost">Talk to us about brokers</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ph-lead { max-width: 620px; }
  /* Four columns for four segments. At three it wrapped one item onto a second row and left a
     dead cell beside it, which read as a missing card rather than a deliberate layout. */
  .jump { grid-template-columns: repeat(5, 1fr); }
  .jump-i { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  /* Smaller well than a tile's 34px — this is a nav row, so the mark identifies without
     competing with the label beside it. */
  .jump-ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; flex: none;
    border: 1px solid var(--hair); background: var(--panel-2); color: var(--ink-3);
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .jump-t { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
  .jump-a { margin-left: auto; color: var(--ink-3); transition: transform 0.18s ease; }
  @media (hover: hover) {
    .jump-i:hover { background: var(--panel-2); }
    .jump-i:hover .jump-ic { color: var(--ink-1); border-color: var(--ink-1); }
    .jump-i:hover .jump-a { transform: translateX(3px); }
  }

  .seg[data-alt='true'] { background: var(--panel-2); }
  .seg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .pts { list-style: none; padding: 0; margin: 18px 0 22px; }
  .pts li { font-size: 11.5px; padding: 9px 0 9px 18px; position: relative; border-top: 1px dotted var(--hair); }
  .pts li::before { content: '✓'; position: absolute; left: 0; color: var(--up); font-weight: 700; }

  /* .cta-row is centred for the dark band at the foot of this page; inside a segment it is a
     left-aligned pair. The secondary is a text link, not a second button, so the free page never
     competes visually with the plan CTA it sits beside. */
  .seg-cta { justify-content: flex-start; align-items: center; gap: 18px; }
  .seg-2 {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; font-weight: 700;
    color: var(--ink-3); text-decoration: none; border-bottom: 0;
  }
  .seg-2 :global(.icn) { transition: transform 0.18s ease; }
  @media (hover: hover) {
    .seg-2:hover { color: var(--ink-1); }
    .seg-2:hover :global(.icn) { transform: translateX(3px); }
  }
  /* The 9.5px mono type makes this link ~16px tall — well under the 44px minimum tap
     target. Pad the hit area on touch screens without changing the desktop metrics. */
  @media (pointer: coarse) {
    .seg-2 { min-height: 44px; }
  }

  .seg-panel { padding: 0; }
  .seg-ph { display: flex; justify-content: space-between; padding: 12px 16px; border-bottom: var(--rule); background: var(--panel-2); }
  .seg-plan { font-size: 11px; font-weight: 700; }
  .seg-row { display: flex; justify-content: space-between; font-size: 11px; padding: 11px 16px; border-bottom: 1px dotted var(--hair); }
  .seg-fine { font-size: 9.5px; padding: 10px 16px; margin: 0; }

  .captable { overflow-x: auto; border: var(--rule); background: var(--panel); margin-top: 18px; }
  table { width: 100%; border-collapse: collapse; min-width: 620px; }
  th, td { text-align: left; padding: 12px 14px; font-size: 11px; border-bottom: 1px dotted var(--hair); }
  th { background: var(--ink-1); color: var(--bg); font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase; }
  td:not(:first-child), th:not(:first-child) { text-align: center; }
  tbody tr:last-child td { border-bottom: 0; }
  .cap-cta { margin-top: 18px; }

  .center { text-align: center; }
  .cta-lead { max-width: 520px; margin: 0 auto 20px; color: #c8c8c0; }
  .cta-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1100px) { .jump { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) {
    .seg-grid { grid-template-columns: 1fr; gap: 28px; }
    .jump { grid-template-columns: 1fr; }
  }
  /* .seg-2 is the free-thing-to-try link under each segment — the lowest-commitment call on the
     page and, at 9.5px in a 16px-tall box, the hardest to hit. It gets a 44px row. */
  @media (max-width: 720px) {
    .pts li { font-size: 13px; padding: 11px 0 11px 18px; }
    .seg-plan, .seg-row { font-size: 12.5px; }
    .seg-fine { font-size: 11px; }
    .seg-2 { font-size: 11px; min-height: 44px; }
    /* The capability table scrolls sideways here on purpose, so its header travels off-screen and
       back — which makes it the one thing on the page a reader has to re-read repeatedly. 9.5px
       uppercase was too small to do that with. */
    th { font-size: 11px; letter-spacing: 0.08em; }
  }
</style>
