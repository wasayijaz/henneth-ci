---
import Base from '../layouts/Base.astro';

import Icon from '../components/Icon.astro';

/* Every card below is a screen that exists in the terminal today (the nav list in
   dashboard/index.html). Nothing aspirational — if it is named here, it opens.
   Third element is the sprite id; see IconSprite.astro.

   Fourth and fifth are an OPTIONAL href + link label. Only a handful of cards carry them: the
   ones whose subject also has a free, no-account page on this site. That is the only entry point
   /financial-astrology/ and /tools/position-size-calculator/ have outside the nav, and a feature
   grid is where someone reading about a capability is most likely to want to try it. */
const groups = [
  {
    k: 'Start here',
    ic: 'today',
    items: [
      ['Today', 'The desk’s plain-English daily read — tone, favoured and avoided sectors, and a short watchlist.', 'today'],
      ['Ask', 'Put a question to the desk in plain English and get an answer traced back to the data layer.', 'ask'],
      ['Learn', 'A 14-lesson path from “what is a share” to reading a cash-flow statement, built for a first-time investor.', 'learn'],
      ['Your Chart', 'Cast your birth chart in the browser and keep it — no account needed to start.', 'mychart'],
    ],
  },
  {
    k: 'Read a company',
    ic: 'research',
    items: [
      ['Value', 'Every name valued four ways, with each model’s full working expandable.', 'value'],
      ['Research', 'Filings, results and corporate briefings digested and tagged to the names they move.', 'research'],
      ['The Desk Room', 'Named analysts debate every stock; a Chair issues a house view with explicit dissent.', 'deskroom'],
      ['Compare', 'Put two or more names side by side on the numbers that actually separate them.', 'compare'],
    ],
  },
  {
    k: 'Find something',
    ic: 'screener',
    items: [
      ['Board', 'The whole universe on one screen: heatmap, backtested signals, predictability ranks and a news wire.', 'board'],
      ['Screener', 'Filter the exchange on quality, value, momentum, yield and liquidity.', 'screener'],
      ['Strategies', 'Transparent, rule-based strategies, each backtested across ~19 years of history.', 'strategies'],
      ['Sectors', 'Sector-level debates and dossiers, not just a list of constituents.', 'sectors'],
      ['Scenarios', 'Ask what a rate move, an oil move or a rupee move would do to a name.', 'scenarios'],
      /* NOT a marketplace yet, and the copy must not imply one. Publishing opens once every
         submission can be backtested; today the surface composes and tests. */
      ['Strategy builder', 'Compose a rule set and backtest it on the same history the desk uses. Publishing to other readers opens once every submission can be tested.', 'marketplace'],
    ],
  },
  {
    k: 'Track it',
    ic: 'portfolio',
    items: [
      ['Watchlist', 'The names you care about, with the desk’s read attached to each.', 'watchlist'],
      /* The X-ray computes weighted beta, blended yield, expected dividends, gap vs fair value and
         three rule checks. It does NOT compute correlation — that word was in here and was false. */
      ['Portfolio', 'Your holdings X-rayed: weighted beta, blended yield, expected dividends, the gap to fair value, and the desk’s own rules checked against what you hold.', 'portfolio'],
      ['Practice', 'A virtual Rs 500,000 book, so you can be wrong without paying for it.', 'practice'],
      ['Scores', 'Dated, falsifiable calls graded against what prices actually did — the desk’s and the brokers’.', 'scores'],
    ],
  },
  {
    k: 'Context',
    ic: 'macro',
    items: [
      ['Macro', 'The global tape that moves PSX, the SBP path, the rupee, and a geo-risk radar.', 'macro'],
      ['News', 'The announcement wire, tagged to tickers and scored 1–5 for impact.', 'news'],
      ['Dividends', 'Yield, cover, book-closure dates and how reliably a payer has actually paid.', 'dividends'],
      ['Earnings', 'The results calendar, with what the desk expects and what it would falsify.', 'earnings'],
      ['Global markets', 'Twenty-three US and global symbols — the S&P 500, Nasdaq 100, Dow, Russell, VIX, all eleven SPDR sectors, EEM, EFA, ACWI, TLT, HYG, gold and oil — covered at index and sector level for the context they give PSX. No US stock picks, and the desk does not signal on them.', 'global', '/global-markets/', 'What the desk covers'],
      ['Astro', 'The computed sky, what tradition claims it governs, and what survived testing.', 'astro', '/financial-astrology/', 'Read the public lens'],
      /* The seven that are actually in the terminal. The four this line used to name — position
         size, CGT, dividend yield, break-even — did not exist in it. Position size now exists, but
         on this website, so it is linked rather than claimed. */
      ['Tools', 'Calculators in rupees — compound growth, monthly SIP, inflation, dividend reinvestment, savings goal, mortgage and zakat.', 'tools', '/tools/position-size-calculator/', 'Size a position free'],
    ],
  },
];

/* THE SCHEDULE. Load-bearing, not decoration: a fixed calendar is the difference between a
   publication and an advisory service, and until now no page on the site stated one. Times are
   the real cycle discipline in CLAUDE.md, not marketing rounding. */
const schedule = [
  [
    'Pre-market · daily',
    '08:45 PKT',
    'The full pipeline. Prices and fundamentals refresh, quant and predictability re-run, strategies re-backtest, then the desk writes its daily read.',
  ],
  [
    'Intraday · every 30 min',
    'To 15:30 PKT',
    'Monitoring, not day trading. Open setups are checked against their plans and the announcement wire is scored 1–5. Only an item scored 4 or higher re-triggers the full pipeline.',
  ],
  [
    'Desk Room · weekly rotation',
    'By name',
    'The five analysts debate names on the desk’s own editorial rotation. Nothing is written on request — you read what was published, dated.',
  ],
];

const engine = [
  ['A shared data layer', 'Prices, quant, fundamentals and calendars refresh on a schedule — the whole desk reads one source of truth.', 'datalayer'],
  ['Self-checking systems', 'Automated gates catch bad numbers, broken builds and design drift before anything reaches you.', 'selfcheck'],
  ['Risk, stated honestly', 'Volatility, drawdown in its proper era context, liquidity and dividend reliability.', 'risk'],
  ['Nothing fabricated', 'Where the data layer is silent, the desk says so — no invented figures, ever.', 'nofabricate'],
  ['Long only, no leverage', 'No shorts, no derivatives, no margin. Daily timeframe. The desk never places an order.', 'longonly'],
  ['An auditor with a veto', 'Every setup is independently re-derived. If the two answers disagree, the setup dies — no override.', 'auditor'],
];
---

<Base
  title="PSX Research Terminal Features"
  path="/features"
  active="features"
  description="Every surface of the Henneth desk — plain-English PSX company reads, fair value four ways, backtested strategies, the analyst Desk Room, and US and global index context."
>
  <section class="section-tight ph">
    <div class="wrap">
      <p class="kicker">Features</p>
      <h1>Everything the desk does</h1>
      <p class="lead ph-lead">
        A global-markets research desk that covers the Pakistan Stock Exchange in depth — and
        explains itself, on a schedule, holding itself and the brokers to account.
      </p>
    </div>
  </section>

  {/* The schedule sits directly under the hero, before any feature card. Someone deciding whether
      this is a publication or a service should not have to scroll to find out. */}
  <section class="wrap sched-wrap">
    <p class="kicker grp-k"><Icon name="clock" size={14} /> When it publishes</p>
    <div class="tilegrid sched">
      {schedule.map(([w, t, d]) => (
        <div class="tile">
          <div class="sc-top">
            <h3>{w}</h3>
            <span class="sc-t">{t}</span>
          </div>
          <p class="muted card-d">{d}</p>
        </div>
      ))}
    </div>
    <p class="muted sched-foot">
      Fixed calendar, identical for every reader, open to anyone who subscribes. That is what makes
      this a publication rather than an advisory service — and it is why nothing here is written
      for you, about your holdings, or on request.
    </p>
  </section>

  {groups.map((g) => (
    <section class="wrap grp">
      <p class="kicker grp-k"><Icon name={g.ic} size={14} /> {g.k}</p>
      <div class="tilegrid cards">
        {g.items.map(([t, d, ic, href, ll]) => (
          <div class="tile">
            <span class="tile-i"><Icon name={ic} size={20} /></span>
            <h3>{t}</h3>
            <p class="muted card-d">{d}</p>
            {href && (
              <a class="card-go" href={href} data-ev="feature_link" data-ev-card={t}>
                {ll} <Icon name="arrow" size={12} />
              </a>
            )}
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="kicker">Board</p>
        <h2>The whole market on one screen</h2>
        <p class="lead">
          Breadth, sector tone, backtested rule-based signals and predictability ranks — so you know
          where to look before you open a single chart.
        </p>
      </div>
      <div class="mock">
        <div class="mock-bar"><span class="label">Board · universe</span><span class="mock-tag">Illustration</span></div>
        {/* Symbols only, no figures — safe to cycle tints. */}
        <div class="heat heat--illustrative">
          {['OGDC','PPL','HUBC','FFC','LUCK','MCB','UBL','MEBL','ENGRO','PSO','SYS','TRG','MLCF','NBP','HBL'].map((s, i) => (
            <div class="heat-cell" data-dir={i % 3 === 2 ? -1 : i % 4 === 1 ? 0 : 1}>{s}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section band-panel">
    <div class="wrap two-col rev">
      <div class="mock">
        <div class="mock-bar"><span class="label">Valued four ways</span><span class="mock-tag">Illustration</span></div>
        <div class="mock-body">
          {['Peer P/E', 'Earnings power vs bond yield', 'Graham', 'Dividend discount'].map((m) => (
            <div class="vrow"><span>{m}</span><span class="muted">model</span></div>
          ))}
          <hr class="hair" />
          <p class="mock-note muted">Real figures are computed per stock inside the desk.</p>
        </div>
      </div>
      <div>
        <p class="kicker">Value</p>
        <h2>Four valuations. All the working.</h2>
        <p class="lead">
          Peer multiples, earnings power against the bond yield, Graham, and a dividend-discount
          model. The median is the read — and every step is expandable, so you can check the maths.
        </p>
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap">
      <p class="kicker dr-kicker">The Desk Room</p>
      <h2>Four desks, one chair, nothing hidden</h2>
      <p class="lead dr-lead deskroom-lead">
        A technical desk and a fundamental desk read the same stock separately. A bull and a bear
        argue it out. A Chair weighs it into a house view — and records the dissent rather than
        burying it.
      </p>
      <div class="drgrid">
        {[
          ['Technical desk', 'Price action only. Never touches fundamentals.'],
          ['Fundamental desk', 'Business and valuation only. Never touches charts.'],
          ['Bull vs Bear', 'The strongest honest case each way, each attacking the other’s weakest point.'],
          ['The Chair', 'One house view, a conviction level, and an explicit dissent line.'],
        ].map(([t, d]) => (
          <div class="drcell">
            <div class="label">{t}</div>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* THE ASTRO SECTION.
      Every figure here is read from the desk's own files and none of it claims an edge:
      astro.json (sidereal, Lahiri ayanamsa, nine grahas, 90-day horizon) and
      astro_backtest.json (2,589 hypotheses, 0 survivors after correction).
      astro_map.json states the rule this copy obeys: "Astro NEVER generates or gates a trade
      setup... It is a lens the desk reports and scores, nothing more." Keep it that way. */}
  <section class="section astro-band">
    <div class="wrap">
      <p class="kicker astro-k">The sky</p>
      <h2>We compute the sky. Then we try to prove it doesn’t work.</h2>
      <p class="lead astro-lead">
        Most people either dismiss financial astrology or sell it. The desk does neither: it
        computes the positions properly, writes down exactly what tradition claims they govern,
        and then tests those claims against nineteen years of PSX prices — publishing the result
        either way.
      </p>

      <div class="tilegrid astro-grid">
        <div class="tile">
          <span class="tile-i"><Icon name="astro" size={20} /></span>
          <h3>Computed, not looked up</h3>
          <p class="muted card-d">
            Sidereal zodiac, Lahiri (Chitrapaksha) ayanamsa, the nine classical grahas, mean node.
            Positions to the degree, with nakshatra and pada — a 90-day forward horizon of
            ingresses, stations and combustions, each stamped in PKT.
          </p>
        </div>
        <div class="tile">
          <span class="tile-i"><Icon name="list" size={20} /></span>
          <h3>Claims, written down first</h3>
          <p class="muted card-d">
            Each graha is mapped to the PSX sectors tradition assigns it, keyed to the exchange’s
            own sector names. Recorded <em>before</em> testing so the mapping cannot be quietly
            rewritten to fit the result.
          </p>
        </div>
        <div class="tile">
          <span class="tile-i"><Icon name="auditor" size={20} /></span>
          <h3>Tested like any strategy</h3>
          <p class="muted card-d">
            Circular-shift permutation on the condition mask, stock by stock — never averaged into
            sectors, which would hide a stock-specific effect. Multiplicity corrected. Same bar as
            the 52 rule-based strategies.
          </p>
        </div>
        <div class="tile">
          <span class="tile-i"><Icon name="mychart" size={20} /></span>
          <h3>Your own chart</h3>
          <p class="muted card-d">
            Cast your birth chart in the browser — nothing leaves your device to do it — and keep
            the daily transits against it. No account needed to start.
          </p>
        </div>
      </div>

      {/* The scoreboard. This is the differentiator: a published null result. */}
      <div class="astro-score">
        <div class="as-row">
          <span class="as-n pixel">2,589</span>
          <span class="as-l muted">hypotheses tested</span>
        </div>
        <div class="as-row">
          <span class="as-n pixel">101</span>
          <span class="as-l muted">subjects, stock by stock</span>
        </div>
        <div class="as-row">
          <span class="as-n pixel">4,893</span>
          <span class="as-l muted">trading days, 2007–2026</span>
        </div>
        <div class="as-row as-zero">
          <span class="as-n pixel">0</span>
          <span class="as-l">survived correction</span>
        </div>
      </div>

      <p class="astro-verdict">
        <b>So the desk says so, in the product.</b> No astro condition has shown a demonstrated
        edge on PSX. The lens never generates a trade setup, never gates one, and never touches the
        Strategist, the Risk Officer or the Auditor. It is reported and scored like everything else
        here — and if a condition ever does survive, you will see the same evidence we did.
      </p>
      <div class="cta-row astro-cta">
        <a href="/financial-astrology/" class="btn" data-ev="astro_page_open">Read the public astro lens</a>
        <a href="/research" class="btn btn-ghost">See how the desk tests things</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">Under the hood</p>
      <h2>Serious machinery, quietly</h2>
      <div class="tilegrid engine">
        {engine.map(([t, d, ic]) => (
          <div class="tile">
            <span class="tile-i"><Icon name={ic} size={20} /></span>
            <h3>{t}</h3>
            <p class="muted card-d">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-dark center">
    <div class="wrap">
      <h2>Put the whole desk behind your next trade</h2>
      <p class="lead cta-lead">Start on the free desk. No card, no charge.</p>
      <div class="cta-row">
        <a href="/plans" class="btn">Get started</a>
        <a href="/research" class="btn btn-ghost">How the desk reasons</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ph-lead { max-width: 640px; }
  /* minmax(0,·) not 1fr: a bare 1fr floors at min-content, so one long unbreakable label
     ("Strategy builder", "Global markets") silently widens its column and the row goes uneven. */
  .cards { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .card-d { font-size: 11px; margin: 8px 0 0; }

  /* The free-page link. margin-top:auto pins it to the tile floor (.tile is a flex column), so
     the three linked cards line up with each other despite different copy lengths. */
  .card-go {
    display: inline-flex; align-items: center; gap: 5px;
    margin-top: auto; padding-top: 12px;
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; font-weight: 700;
    color: var(--ink-1); text-decoration: none;
    border-bottom: 0;
  }
  .card-go :global(.icn) { transition: transform 0.18s ease; }
  @media (hover: hover) {
    .card-go:hover { color: var(--up); }
    .card-go:hover :global(.icn) { transform: translateX(3px); }
  }

  /* THE SCHEDULE STRIP */
  .sched-wrap { margin-bottom: 40px; }
  .sched { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .sc-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .sc-top h3 { margin: 0; }
  /* The time is the fact on this card, so it gets the mono treatment the desk reserves for
     figures — it must not read as another line of prose. */
  .sc-t {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em;
    color: var(--ink-3); white-space: nowrap;
  }
  .sched-foot { font-size: 11px; margin: 16px 0 0; max-width: 74ch; line-height: 1.7; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; }
  .mock-bar { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: var(--rule); background: var(--panel-2); }
  .mock-tag { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .mock-body { padding: 14px; }
  .mock-note { font-size: 9.5px; margin: 10px 0 0; }
  .heat { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.5px; background: var(--line); }
  .heat-cell { background: var(--panel); padding: 14px 6px; text-align: center; font-size: 10px; font-weight: 700; }
  .heat-cell[data-dir='1'] { background: var(--up-soft); color: var(--up); }
  .heat-cell[data-dir='-1'] { background: var(--dn-soft); color: var(--dn); }
  .vrow { display: flex; justify-content: space-between; font-size: 11px; padding: 9px 0; border-bottom: 1px dotted var(--hair); }

  .dr-kicker { color: #8f8f88; }
  .dr-lead, .deskroom-lead { color: #c8c8c0; max-width: 680px; }
  .drgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px; background: #3a3a37; border: 1.5px solid #3a3a37; margin-top: 24px; }
  .drcell { background: #101314; padding: 16px; }
  .drcell p { font-size: 11px; color: #c8c8c0; margin: 8px 0 0; }

  .engine { grid-template-columns: repeat(3, 1fr); margin-top: 18px; }

  .grp { margin-bottom: 34px; }
  .grp-k { margin-bottom: 12px; }

  /* THE SKY BAND. Near-black like the Desk Room band — the one place on the site where a
     starfield reads as anything other than decoration. */
  .astro-band { background: var(--ink-1); color: var(--bg); position: relative; overflow: hidden; }
  .astro-k { color: #8f8f88; }
  .astro-band h2 { max-width: 760px; }
  .astro-lead { max-width: 720px; color: #c8c8c0; margin-bottom: 26px; }
  .astro-grid { grid-template-columns: repeat(4, 1fr); background: #2c2f30; border-color: #3a3a37; }
  .astro-grid > * { background: #101314; }
  .astro-grid h3 { color: var(--bg); }
  .astro-grid .card-d { color: #a9a9a2; }

  /* The scoreboard. The zero is the point, so it is the only coloured figure. */
  .astro-score {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5px;
    background: #3a3a37; border: 1.5px solid #3a3a37; margin-top: 24px;
  }
  .as-row { background: #101314; padding: 18px; display: flex; flex-direction: column; gap: 7px; }
  .as-n { font-size: 30px; line-height: 1; color: var(--bg); font-variant-numeric: tabular-nums; }
  .as-l { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .as-zero .as-n { color: #55a16b; }
  .as-zero .as-l { color: #55a16b; }

  .astro-verdict { font-size: 12px; line-height: 1.8; max-width: 760px; margin: 24px 0 20px; color: #c8c8c0; }
  .astro-verdict b { color: var(--bg); }
  /* .astro-band is its own dark section, not .band-dark, so it does not inherit the global
     dark-band button inversion — the two buttons are re-stated here. Solid one goes to the free
     public astro page, ghost one to the method; the free page is the primary action. */
  .astro-cta { justify-content: flex-start; margin-top: 22px; }
  .astro-cta .btn { background: var(--bg); color: var(--ink-1); border-color: var(--bg); }
  .astro-cta .btn:hover { background: #fff; }
  .astro-cta .btn-ghost { background: transparent; color: var(--bg); border-color: #3a3a37; }
  .astro-cta .btn-ghost:hover { background: var(--bg); color: var(--ink-1); border-color: var(--bg); }

  /* A slow drift across the band — the sky moving, at a pace you notice only if you stay.
     Pointer-events none so it can never intercept a click on the CTA beneath it. */
  .astro-band::before {
    content: ''; position: absolute; inset: -50% -10% auto -10%; height: 200%;
    pointer-events: none; opacity: 0.5;
    background-image:
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px),
      radial-gradient(circle, #6f6f88 1px, transparent 1.6px),
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px),
      radial-gradient(circle, #55a16b 1px, transparent 1.6px),
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px);
    background-repeat: no-repeat;
    background-position: 8% 12%, 82% 20%, 41% 66%, 92% 74%, 22% 84%;
    animation: skyDrift 90s linear infinite;
  }
  @keyframes skyDrift { to { transform: translateX(6%) translateY(-3%); } }
  @media (prefers-reduced-motion: reduce) { .astro-band::before { animation: none; } }
  .center { text-align: center; }
  .cta-lead { max-width: 520px; margin: 0 auto 20px; color: #c8c8c0; }
  .cta-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1000px) { .cards, .drgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 1000px) { .astro-grid { grid-template-columns: repeat(2, 1fr); } .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .engine { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; gap: 28px; } .two-col.rev > :first-child { order: 2; } .astro-score { grid-template-columns: repeat(2, 1fr); } .sched { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cards, .drgrid, .astro-grid, .engine { grid-template-columns: 1fr; } .heat { grid-template-columns: repeat(3, 1fr); } .as-n { font-size: 24px; } }
</style>
