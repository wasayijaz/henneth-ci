---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import { site } from '../site.config.ts';

/* THE HERO BOARD IS REAL DATA, READ FROM state/ AT BUILD TIME.

   It used to be a hand-written illustration with no figures, carrying this note: "symbols are
   real listed codes, but NO figures are shown, because inventing price moves next to a real
   company is a false claim." That constraint was right and still binds — CLAUDE.md Rule 2 says
   no price may ever come from memory. The resolution is not to relax it but to satisfy it: the
   marketing site builds from the same repo as the desk, so the panel can show a genuine snapshot
   of the same data layer the product runs on, stamped with the session date it came from.

   That turns the hero from a mockup into the site's first proof-point — the "every number is
   sourced" claim demonstrated rather than asserted.

   It refreshes on each deploy, not live. The date stamp in the panel is therefore load-bearing:
   it is what keeps a stale build honest instead of quietly implying real-time prices.

   Every read falls back to the figure-free illustration. A missing or malformed state file must
   degrade the hero, never fail the build — the marketing site has to be deployable even when the
   desk's data layer is mid-refresh or absent (a standalone site checkout has no state/ at all). */
const STATE = path.resolve(process.cwd(), '..', 'state');
function readState<T>(file: string, fallback: T): T {
  try {
    return JSON.parse(fs.readFileSync(path.join(STATE, file), 'utf-8')) as T;
  } catch {
    return fallback;
  }
}

const quant: Record<string, any> = readState<any>('quant.json', {}).tickers ?? {};
const universe: Record<string, any> = readState<any>('universe.json', {}).symbols ?? {};
const stratMap: Record<string, any[]> = readState<any>('strategy_map.json', {}).tickers ?? {};
const macro: any = readState<any>('macro.json', {});

// The board shows the heaviest core names — the ones a PSX reader recognises on sight.
const coreByWeight = Object.values(universe)
  .filter((u: any) => u?.tier === 'core' && quant[u.symbol]?.ret_1d != null)
  .sort((a: any, b: any) => (b.weight_pct ?? 0) - (a.weight_pct ?? 0));

const board = coreByWeight.slice(0, 15).map((u: any) => ({
  sym: u.symbol,
  pct: quant[u.symbol].ret_1d as number,
}));

/* Breadth over the WHOLE covered universe, not just the 15 on screen — a breadth number computed
   from the same names it is displayed beside would be circular and would read far too kind on a
   day when the heavyweights happened to hold up. */
const withRet = Object.keys(quant).filter((s) => quant[s]?.ret_1d != null);
const breadth = withRet.length
  ? Math.round((withRet.filter((s) => quant[s].ret_1d > 0).length / withRet.length) * 100)
  : null;

// The desk's actual macro call, not an invented mood word.
const regime: string = macro?.regime ?? '';
const asOf: string = board.length ? quant[board[0].sym]?.date ?? '' : '';

/* Signals: real proven-strategy pairs, ranked by the same net-expectancy the desk ranks them by,
   one per ticker so four different companies show rather than four strategies on one name. */
const signals = Object.entries(stratMap)
  .filter(([sym]) => quant[sym]?.close != null && universe[sym]?.name)
  .map(([sym, list]) => ({ sym, top: [...list].sort((a, b) => b.net_expectancy_pct - a.net_expectancy_pct)[0] }))
  .sort((a, b) => b.top.net_expectancy_pct - a.top.net_expectancy_pct)
  .slice(0, 4)
  .map(({ sym, top }) => ({
    sym,
    // The registered name is long ("Fauji Fertilizer Company Limited"); the panel has one line.
    name: String(universe[sym].name).replace(/\s+(Limited|Ltd\.?|Company Limited)$/i, '').toUpperCase(),
    tag: String(top.category).toUpperCase(),
    close: quant[sym].close as number,
    pct: quant[sym].ret_1d as number,
  }));

// Degraded mode: no state/ available, so fall back to the original figure-free illustration
// rather than rendering an empty panel or, worse, zeros that look like real flat prices.
const haveLiveBoard = board.length >= 15 && signals.length === 4;
const fallbackHeat: [string, number][] = [
  ['OGDC', 1], ['PPL', 1], ['HUBC', 0], ['FFC', 1], ['LUCK', -1],
  ['MCB', 1], ['UBL', 1], ['MEBL', 0], ['ENGRO', -1], ['PSO', 1],
  ['SYS', -1], ['TRG', -1], ['MLCF', 1], ['NBP', 1], ['HBL', 0],
];
const dir = (p: number) => (p > 0 ? 1 : p < 0 ? -1 : 0);
const fmtPct = (p: number) => `${p > 0 ? '+' : ''}${p.toFixed(1)}%`;

const stats = [
  ['550+', 'Listed names covered'],
  ['70', 'Tested strategies'],
  ['19 yrs', 'Of price history'],
  ['4', 'Valuation models'],
];

const steps = [
  ['01', 'Pick any listed name', 'Search the whole exchange. Land on a page built to answer your first three questions before you scroll.'],
  ['02', 'The desk does the homework', 'Valued four ways, scored for quality and risk, tested against 19 years of history, and debated by the analyst desk.'],
  ['03', 'You decide', 'The desk never places orders and never tells you to buy. You get the read; the decision stays yours.'],
];

const principles = [
  ['Research, not advice', 'No “buy”, no “strong buy”, no promises. Every page says so, because the distinction is the product.'],
  ['Every number is sourced', 'Nothing is quoted from memory. If the data layer doesn’t hold it, the desk says “unknown” rather than guessing.'],
  ['Losses are shown', 'The scorecard grades the desk’s own calls, misses included. A record you can check is the only kind worth having.'],
];
---

<Base path="/" active="">
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">PSX Research Terminal · Now in early access</p>
        <h1>A whole research desk<br />for every PSX stock<span class="h1-dot">.</span></h1>
        <p class="lead hero-lead">
          Every PSX-listed name — researched, valued four ways, and debated by an AI analyst desk.
          Then every dated call is graded against what prices actually did. You get the read. You
          place the trade.
        </p>
        <p class="hero-sub muted">
          The desk does the homework in public and keeps its own scorecard. It never places orders.
        </p>
        <div class="hero-cta">
          <a href="/plans" class="btn btn-solid btn-lg">Get started</a>
          <a href="/research" class="btn btn-lg">See the track record</a>
        </div>
        <div class="hero-fine">
          <span>Free in early access</span><span>·</span>
          <span>No card required</span><span>·</span>
          <span>Research, not advice</span>
        </div>
      </div>

      <!-- The board panel. Real desk data when state/ is readable at build time, the original
           figure-free illustration when it is not. -->
      <div class="mock hero-mock">
        <div class="mock-bar">
          <span class="label">Board · Live universe</span>
          <span class="mock-pills">
            {haveLiveBoard && regime && <span class="pill-chip">Regime: {regime}</span>}
            {haveLiveBoard && breadth != null && <span class="pill-chip">Breadth {breadth}%</span>}
            {!haveLiveBoard && <span class="mock-tag">Illustration</span>}
          </span>
        </div>

        {haveLiveBoard ? (
          <div class="heat">
            {board.map((b) => (
              <div class="heat-cell" data-dir={dir(b.pct)}>
                <span class="hc-sym">{b.sym}</span>
                <span class="hc-pct">{fmtPct(b.pct)}</span>
              </div>
            ))}
          </div>
        ) : (
          <div class="heat">
            {fallbackHeat.map(([sym, d]) => (
              <div class="heat-cell" data-dir={d}><span class="hc-sym">{sym}</span></div>
            ))}
          </div>
        )}

        <div class="mock-sec">
          <div class="label">Proven-strategy signals</div>
          {haveLiveBoard ? (
            signals.map((s) => (
              <div class="sig sig-row">
                <span class="sig-id">
                  <b>{s.sym}</b>
                  <em>{s.name}</em>
                </span>
                <span class="sig-tag">{s.tag}</span>
                <span class="sig-px" data-dir={dir(s.pct)}>
                  {s.close.toFixed(2)}
                  <i>{fmtPct(s.pct)}</i>
                </span>
              </div>
            ))
          ) : (
            <>
              <div class="sig"><span>Golden cross</span><span class="muted">trend</span></div>
              <div class="sig"><span>52-week high break</span><span class="muted">breakout</span></div>
              <div class="sig"><span>50-day reclaim</span><span class="muted">momentum</span></div>
            </>
          )}
        </div>

        {/* The date stamp is the honesty guard: this rebuilds on deploy, not live, and without
            it a stale build would quietly imply real-time prices. */}
        {haveLiveBoard && asOf && (
          <div class="mock-foot">
            <span>Real desk data · session {asOf}</span>
            <span class="mock-foot-r">Rebuilt each deploy · not live</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ================= TRUST BAR ================= -->
  <section class="band-panel trust">
    <div class="wrap">
      <div class="tilegrid trust-grid">
        {stats.map(([n, l]) => (
          <div>
            <div class="pixel trust-n">{n}</div>
            <div class="label muted trust-l">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">How the desk works</p>
      <h2>Pick a stock. The desk does the homework. You decide.</h2>
      <div class="tilegrid steps">
        {steps.map(([n, t, d]) => (
          <div>
            <div class="step-n label">{n}</div>
            <h3>{t}</h3>
            <p class="muted step-d">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 01 BOARD ================= -->
  <section class="section band-panel">
    <div class="wrap two-col">
      <div>
        <p class="kicker">01 · Board</p>
        <h2>The whole market on one screen</h2>
        <p class="lead">
          A live universe heatmap, proven rule-based signals, predictability ranks, and a rolling
          news wire. See where breadth is, which sectors are favoured, and what screens well today —
          before you open a single chart.
        </p>
        <a href="/features" class="btn">Explore the board</a>
      </div>
      <div class="mock">
        <div class="mock-bar">
          <span class="label">Predictability ranks</span>
          <span class="mock-tag">19 yrs backtested</span>
        </div>
        <div class="mock-body">
          {[82, 71, 64, 55, 47].map((w, i) => (
            <div class="rank">
              <span class="rank-k">RANK {i + 1}</span>
              <div class="rank-bar"><span style={`width:${w}%`}></span></div>
            </div>
          ))}
          <p class="mock-note muted">Illustration of the ranking layout.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 02 VALUE ================= -->
  <section class="section">
    <div class="wrap two-col rev">
      <div class="mock">
        <div class="mock-bar">
          <span class="label">Valued four ways</span>
          <span class="mock-tag">Illustration</span>
        </div>
        <div class="mock-body">
          {['Peer P/E', 'Earnings power vs bond yield', 'Graham', 'Dividend discount'].map((m) => (
            <div class="vrow"><span>{m}</span><span class="muted">model</span></div>
          ))}
          <hr class="hair" />
          <div class="vband">
            <div class="label muted">Consensus fair value</div>
            <div class="pixel vband-v">— · —</div>
            <p class="mock-note muted">Real figures appear in the desk, computed per stock.</p>
          </div>
        </div>
      </div>
      <div>
        <p class="kicker">02 · Value</p>
        <h2>Four valuations. All the working.</h2>
        <p class="lead">
          Every stock valued by peer P/E, earnings-power vs the bond yield, Graham, and a
          dividend-discount model — with each model’s full working expandable, so you can check the
          maths, not just trust a number.
        </p>
        <a href="/features" class="btn">See the models</a>
      </div>
    </div>
  </section>

  <!-- ================= 03 DESK ROOM ================= -->
  <section class="section band-dark deskroom">
    <div class="wrap two-col">
      <div>
        <p class="kicker dr-kicker">03 · The Desk Room</p>
        <h2>Watch an AI analyst desk argue it out</h2>
        <p class="lead dr-lead">
          On every ticker, named analyst personas — a technical desk, a fundamental desk, a bull and
          a bear — debate the stock. Then a Chair synthesises a house view with an explicit dissent.
          Nothing is hidden; you see who argued what.
        </p>
        <button class="btn" id="drPlay">▶ Watch the desk analyse</button>
        <p class="dr-hint muted">Replay stages the debate in sequence — hit play</p>
      </div>

      <div class="dr-card">
        <div class="dr-bar">
          <span class="label">Desk Room</span>
          <span class="muted">4 desks · 1 chair</span>
        </div>
        <div class="dr-body" id="drBody">
          <div class="dr-block" data-i="0">
            <div class="label">Technical desk</div>
            <p>Trend intact; reclaiming the 50-day on rising volume.</p>
          </div>
          <div class="dr-block" data-i="1">
            <div class="label">Fundamental desk</div>
            <p>Cheap on earnings power. Growth is the open question.</p>
          </div>
          <div class="dr-block" data-i="2">
            <div class="label up">Bull</div>
            <p>Value plus dividend cover carries it through the cycle.</p>
          </div>
          <div class="dr-block" data-i="3">
            <div class="label dn">Bear</div>
            <p>Fair value leans on an aggressive growth input.</p>
          </div>
          <div class="dr-block dr-chair" data-i="4">
            <div class="dr-chair-h">
              <span class="label">Chair’s house view</span><span class="muted">Conviction: Med</span>
            </div>
            <p>
              Constructive setup, but priced for a clean quarter. The desk watches for the payout
              signal before adding conviction.
            </p>
            <p class="dr-dissent"><b>Dissent —</b> the bear’s cyclical-peak case is not resolved.</p>
          </div>
        </div>
        <p class="mock-note muted dr-illus">Illustration of a session. Real debates run per stock.</p>
      </div>
    </div>
  </section>

  <!-- ================= 04 SCORES (method, not numbers) ================= -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">04 · Scores</p>
        <h2>The desk grades itself in public</h2>
        <p class="lead">
          Every call carries a date and a falsifiable expectation. When the outcome window closes,
          it’s scored against what prices actually did — the desk’s calls and the brokers’ alike. No
          cherry-picking, no quiet deletions.
        </p>
      </div>
      <div class="tilegrid score-how">
        <div>
          <div class="label">1 · Dated</div>
          <p class="muted">Every view is stamped with the date it was made and the window it must play out in.</p>
        </div>
        <div>
          <div class="label">2 · Falsifiable</div>
          <p class="muted">It states what would prove it wrong — so it can actually be graded, not argued about.</p>
        </div>
        <div>
          <div class="label">3 · Scored</div>
          <p class="muted">When the window closes it’s marked against real prices, and the misses stay on the record.</p>
        </div>
        <div>
          <div class="label">4 · Brokers too</div>
          <p class="muted">Public broker calls are captured and graded on the same bar. Audited, never trusted.</p>
        </div>
      </div>
      <p class="score-note muted">
        The public scorecard opens once enough calls have resolved to mean something. Until then we
        show the method, not a number — a track record you can’t check isn’t a track record.
      </p>
    </div>
  </section>

  <!-- ================= PRINCIPLES ================= -->
  <section class="section band-panel">
    <div class="wrap">
      <div class="tilegrid principles">
        {principles.map(([t, d]) => (
          <div>
            <h3>{t}</h3>
            <p class="muted">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PRICING TEASER ================= -->
  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="kicker">Plans</p>
        <h2>{site.earlyAccess ? 'Free while we get it right' : 'One desk. Two ways in.'}</h2>
        <p class="lead">
          {site.earlyAccess
            ? 'The whole desk is open during early access — no card, no trial timer. Use it properly and tell us what needs fixing.'
            : `Investor and Pro, each with a ${site.trialDays}-day trial — plus a Broker tier for desks and institutions.`}
        </p>
        <a href="/plans" class="btn btn-solid">{site.earlyAccess ? 'Why it’s free ›' : 'See full pricing ›'}</a>
      </div>
      <div class="tease">
        {site.plans.map((p) => (
          <a href={p.href || '/plans'} class="tease-row">
            <span class="tease-n">{p.name}{p.featured && <em> · most popular</em>}</span>
            <span class="tease-p">
              {p.soon
                ? <>Coming soon</>
                : site.earlyAccess
                  ? <>Free</>
                  : <>{site.billing.currency} {p.priceMonthly.toLocaleString('en-PK')}<i>/mo</i></>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= FINAL CTA ================= -->
  <section class="section band-dark final">
    <div class="wrap center">
      <h2>Put the whole desk<br />behind your next trade</h2>
      <p class="lead dr-lead final-lead">
        The desk does the homework and keeps its own score — you decide what to do with it.
      </p>
      <div class="final-cta">
        <a href="/plans" class="btn">Get started</a>
        <a href="/contact" class="btn btn-ghost">Talk to us about brokers</a>
      </div>
      <p class="final-fine muted">Research · not advice · The desk never places orders</p>
    </div>
  </section>
</Base>

<style>
  .hero { padding: clamp(40px, 6vw, 72px) 0 clamp(40px, 5vw, 64px); }
  /* The accent full stop — the one spot of brand green in the headline. */
  .h1-dot { color: var(--up); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 44px; align-items: center; }
  .hero-lead { max-width: 520px; }
  .hero-sub { font-size: 11.5px; max-width: 480px; }
  .hero-cta { display: flex; gap: 10px; margin: 22px 0 14px; flex-wrap: wrap; }
  .hero-fine {
    display: flex; gap: 8px; flex-wrap: wrap;
    font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3);
  }

  .mock-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-bottom: var(--rule); background: var(--panel-2);
  }
  .mock-tag { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .mock-body { padding: 14px; }
  .mock-note { font-size: 9.5px; margin: 10px 0 0; }

  .mock-pills { display: flex; gap: 6px; align-items: center; }
  .pill-chip {
    font-size: 8.5px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;
    border: 1px solid var(--hair); padding: 3px 7px; color: var(--ink-2); white-space: nowrap;
  }

  /* Cells are left-aligned with the ticker over its move — the reference's layout, and the one
     that survives real data: centred text made the varying-width percentages jitter column to
     column. `tabular-nums` holds the decimal points in a straight line down the grid. */
  .heat { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.5px; background: var(--line); }
  .heat-cell {
    background: var(--panel); padding: 10px 9px; display: flex; flex-direction: column; gap: 3px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
  }
  .hc-sym { font-size: 9.5px; letter-spacing: 0.08em; }
  .hc-pct { font-size: 10.5px; font-variant-numeric: tabular-nums; letter-spacing: 0; }
  .heat-cell[data-dir='1'] { background: var(--up-soft); color: var(--up); }
  .heat-cell[data-dir='-1'] { background: var(--dn-soft); color: var(--dn); }
  .heat-cell[data-dir='0'] { color: var(--ink-2); }

  .mock-sec { padding: 14px; border-top: var(--rule); }
  .sig {
    display: flex; justify-content: space-between; font-size: 11px;
    padding: 8px 0; border-bottom: 1px dotted var(--hair);
  }
  /* Three columns: identity grows, tag and price stay put, so a long company name truncates
     instead of shoving the price out of the panel. */
  .sig-row { align-items: center; gap: 10px; }
  .sig-id { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .sig-id b { font-size: 11px; letter-spacing: 0.06em; }
  .sig-id em {
    font-style: normal; font-size: 8.5px; letter-spacing: 0.08em; color: var(--ink-3);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .sig-tag {
    font-size: 8.5px; letter-spacing: 0.1em; font-weight: 700; color: var(--ink-2);
    border: 1px solid var(--hair); padding: 3px 6px; white-space: nowrap; flex: none;
  }
  .sig-px {
    font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums;
    text-align: right; flex: none; white-space: nowrap;
  }
  .sig-px[data-dir='1'] { color: var(--up); }
  .sig-px[data-dir='-1'] { color: var(--dn); }
  /* Inline with the price, as in the reference — stacked, the move read as a second data point
     instead of a qualifier on the number above it. */
  .sig-px i { font-style: normal; font-size: 9px; font-weight: 500; margin-left: 5px; }

  .mock-foot {
    display: flex; justify-content: space-between; gap: 10px; padding: 9px 14px;
    border-top: var(--rule); background: var(--panel-2);
    font-size: 8.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3);
  }
  .mock-foot-r { text-align: right; }

  .trust { padding: 0; }
  .trust-grid { grid-template-columns: repeat(4, 1fr); border-left: 0; border-right: 0; }
  .trust-n { font-size: 32px; }
  .trust-l { margin-top: 8px; }

  .steps { grid-template-columns: repeat(3, 1fr); margin-top: 28px; }
  .step-n { color: var(--ink-3); margin-bottom: 10px; }
  .step-d { font-size: 11.5px; margin: 0; }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; align-items: center; }
  .sec-head { max-width: 640px; margin-bottom: 26px; }

  .rank { display: flex; align-items: center; gap: 12px; padding: 9px 0; }
  .rank-k { font-size: 9px; letter-spacing: 0.1em; color: var(--ink-3); min-width: 58px; }
  .rank-bar { flex: 1; height: 9px; border: 1px solid var(--ink-1); }
  .rank-bar span { display: block; height: 100%; background: var(--ink-1); }

  .vrow { display: flex; justify-content: space-between; font-size: 11px; padding: 9px 0; border-bottom: 1px dotted var(--hair); }
  .vband { text-align: center; padding: 6px 0 2px; }
  .vband-v { font-size: 26px; margin: 8px 0; letter-spacing: 0.06em; }

  .deskroom .lead, .dr-lead { color: #c8c8c0; }
  .dr-kicker { color: #8f8f88; }
  .dr-hint { font-size: 9.5px; margin-top: 12px; color: #8f8f88; }
  .dr-card { border: 1.5px solid #3a3a37; background: #101314; }
  .dr-bar { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid #3a3a37; font-size: 9.5px; }
  .dr-body { padding: 14px; }
  .dr-block { border: 1px solid #2c2f30; padding: 12px; margin-bottom: 10px; opacity: 1; }
  .dr-block p { font-size: 11px; margin: 6px 0 0; color: #c8c8c0; }
  .dr-block.is-hidden { opacity: 0; transform: translateY(10px); }
  .dr-block.is-in { animation: rpUp 0.42s ease both; }
  .dr-chair { border-color: var(--bg); }
  .dr-chair-h { display: flex; justify-content: space-between; }
  .dr-dissent { color: #9a9a92 !important; }
  .dr-illus { padding: 0 14px 12px; color: #7a7a72; }
  @keyframes rpUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .score-how { grid-template-columns: repeat(4, 1fr); }
  .score-how p { font-size: 11px; margin: 8px 0 0; }
  .score-note { font-size: 10.5px; margin-top: 18px; max-width: 720px; }

  .principles { grid-template-columns: repeat(3, 1fr); }
  .principles p { font-size: 11.5px; margin: 8px 0 0; }

  .tease { border: var(--rule); background: var(--panel); }
  .tease-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px; text-decoration: none; border-bottom: 1px dotted var(--hair);
  }
  .tease-row:last-child { border-bottom: 0; }
  .tease-row:hover { background: var(--panel-2); }
  .tease-n { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .tease-n em { font-style: normal; color: var(--ink-3); font-weight: 400; }
  .tease-p { font-family: var(--font-mono); font-size: 20px; font-weight: 800; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .tease-p i { font-style: normal; font-family: var(--font-mono); font-size: 10px; color: var(--ink-3); }

  .center { text-align: center; }
  .final-lead { max-width: 560px; margin: 0 auto 22px; }
  .final-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .final-fine { font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 20px; color: #7a7a72; }

  @media (max-width: 920px) {
    .hero-grid, .two-col { grid-template-columns: 1fr; gap: 32px; }
    .two-col.rev > :first-child { order: 2; }
    .trust-grid, .score-how { grid-template-columns: repeat(2, 1fr); }
    .steps, .principles { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .heat { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  // Staged reveal of the debate, matching the handoff's ~450ms cadence.
  const play = document.getElementById('drPlay');
  const blocks = Array.from(document.querySelectorAll('.dr-block')) as HTMLElement[];
  play?.addEventListener('click', () => {
    blocks.forEach((b) => { b.classList.add('is-hidden'); b.classList.remove('is-in'); });
    blocks.forEach((b, i) => {
      setTimeout(() => {
        b.classList.remove('is-hidden');
        b.classList.add('is-in');
      }, i * 450);
    });
  });
</script>
