---
import ctx from '../data/public/context.json';
import coverage from '../data/public/coverage.json';
import changelogData from '../data/public/changelog.json';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config.ts';

/* Global coverage is COUNTED, never typed. Same reasoning as global-markets.astro: the number comes
   from config/markets.json via the generated slice, so adding a symbol to the desk updates the
   homepage claim in the same commit. A hard-coded "23" would be a factual claim with no owner. */
const usGroups: Record<string, { symbol: string; name: string }[]> =
  (coverage as any)?.markets?.US?.groups ?? {};
const globalCount = Object.values(usGroups).reduce((n, g) => n + g.length, 0);
const globalGroups: [string, string][] = [
  ['Indices', 'indices'],
  ['US sector ETFs', 'sectors'],
  ['Global & EM baskets', 'global'],
  ['Rates & commodities', 'rates_commodity'],
];

/* THE HERO BOARD IS REAL DATA — from the committed public extract.

   It used to be a hand-written illustration with no figures, carrying this note: "symbols are
   real listed codes, but NO figures are shown, because inventing price moves next to a real
   company is a false claim." That constraint was right and still binds — CLAUDE.md Rule 2 says
   no price may ever come from memory. The resolution is not to relax it but to satisfy it: the
   panel shows a genuine snapshot of the same data layer the product runs on, stamped with the
   session date it came from. That makes the hero the site's first proof-point — the "every
   number is sourced" claim demonstrated rather than asserted.

   NO LONGER READS `../state/`  (changed 2026-07-21)
   This used to walk up out of `site/` with fs.readFileSync, which forced Vercel's "Include source
   files outside the Root Directory" on for the marketing project — pulling the whole 93 MB data
   layer into the marketing build, one careless route away from being served. It now imports the
   narrow allow-listed extract written by `scripts/build_public_slice.py`, so the Astro build
   reads nothing above its own root.

   Refreshes on each deploy, not live. The date stamp in the panel is therefore load-bearing: it
   is what keeps a stale build honest instead of quietly implying real-time prices.

   Still degrades to the figure-free illustration if the extract is absent or short — a fresh
   checkout without the generated file must build, not fail. */
const board: { sym: string; pct: number }[] = (ctx as any)?.board ?? [];
const breadth: number | null = (ctx as any)?.breadth_pct ?? null;
const regime: string = (ctx as any)?.macro?.regime ?? '';
const asOf: string = (ctx as any)?.as_of ?? '';

/* Signals: names that currently carry a setup which cleared the desk's bar.
   Ordered by index weight, NOT by the backtest's own ranking — see the note in
   build_public_slice.py. The generic category stays; the strategy name, its win rate and its
   expectancy never leave the gate. */
const signals: { sym: string; name: string; tag: string; close: number; pct: number }[] =
  (ctx as any)?.signals ?? [];

// Degraded mode: no state/ available, so fall back to the original figure-free illustration
// rather than rendering an empty panel or, worse, zeros that look like real flat prices.
const haveLiveBoard = board.length >= 15 && signals.length === 4;
const fallbackHeat: [string, number][] = [
  ['OGDC', 1], ['PPL', 1], ['HUBC', 0], ['FFC', 1], ['LUCK', -1],
  ['MCB', 1], ['UBL', 1], ['MEBL', 0], ['ENGRO', -1], ['PSO', 1],
  ['SYS', -1], ['TRG', -1], ['MLCF', 1], ['NBP', 1], ['HBL', 0],
];
const dir = (p: number) => (p > 0 ? 1 : p < 0 ? -1 : 0);
const fmtPct = (p: number) => `${p > 0 ? '+' : ''}${p.toFixed(1)}%`;

/* Six, not four. The global row had to appear here — the trust bar is the first place a visitor
   checks the scale of the thing, and coverage that only shows up three sections down reads as an
   afterthought. Six divides cleanly by the 3-column desktop grid AND the 2-column tablet one, so
   no orphan cell is left showing the grid's line colour. */
const stats = [
  ['550+', 'PSX names covered'],
  [String(globalCount), 'Global symbols for context'],
  ['70', 'Backtested strategies'],
  ['19 yrs', 'Of price history'],
  ['4', 'Valuation models'],
  ['2,589', 'Astro hypotheses tested'],
];

/* Fourth element on each row is the sprite id — see IconSprite.astro. */
const steps = [
  ['01', 'Pick any listed name', 'Search the whole exchange. Land on a page built to answer your first three questions before you scroll.', 'screener'],
  ['02', 'The desk does the homework', 'Valued four ways, scored for quality and risk, tested against 19 years of history, and debated by the analyst desk.', 'deskroom'],
  ['03', 'You decide', 'The desk never places orders and never tells you to buy. You get the read; the decision stays yours.', 'longonly'],
];

/* Latest updates — mirrors state/changelog.json via the allow-listed marketing slice (Rule 2:
   nothing published reads state/ directly). One release exists today, so this is a single
   spotlight card, not a forced 3-tile grid — the "older releases" strip is ready for when more
   dated entries accumulate, rather than something built and then hidden. */
const releases: { date: string; version: string; title: string; notes: string[] }[] =
  (changelogData as any)?.releases ?? [];
const latestRelease = releases[0];
const olderReleases = releases.slice(1, 4);

const principles = [
  ['Research, not advice', 'No “buy”, no “strong buy”, no promises. Every page says so, because the distinction is the product.', 'nofabricate'],
  ['Every number is sourced', 'Nothing is quoted from memory. If the data layer doesn’t hold it, the desk says “unknown” rather than guessing.', 'datalayer'],
  ['Losses are shown', 'The scorecard grades the desk’s own calls, misses included. A record you can check is the only kind worth having.', 'scores'],
];
---

<Base path="/" active="">
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">PSX Research Terminal · Global context · Now in early access</p>
        {/* The astro line is IN the headline, not buried in the lead — it is the thing no other
            PSX desk does. The claim is deliberately about testing, never about predicting. */}
        <h1>
          A whole research desk<br />for every PSX stock<span class="h1-dot">.</span><br />
          <span class="h1-sky">And the sky above it<span class="h1-dot">.</span></span>
        </h1>
        <p class="hero-astro">
          <span class="ha-dot" aria-hidden="true"></span>
          Vedic astro lens — computed, tested against 19 years, and published even when it fails
        </p>
        <p class="lead hero-lead">
          Every PSX-listed name — researched, valued four ways, and debated by an AI analyst desk,
          read against the global tape that moves Karachi second-hand. We even compute the sky and
          test what tradition claims it governs. Then every dated call, astrological ones included,
          is graded against what prices actually did.
        </p>
        <p class="hero-sub muted">
          The desk does the homework in public and keeps its own scorecard — including the tests
          that failed. It never places orders.
        </p>
        <div class="hero-cta">
          <a href="/plans" class="btn btn-solid btn-lg">Get started</a>
          <a href="/research" class="btn btn-lg">See the track record</a>
        </div>
        <div class="hero-fine">
          <span>Free in early access</span><span>·</span>
          <span>No card required</span><span>·</span>
          <span>Research, not advice</span>
        </div>
      </div>

      <!-- The board panel. Real desk data when state/ is readable at build time, the original
           figure-free illustration when it is not. -->
      <div class="mock hero-mock">
        <div class="mock-bar">
          <span class="label">Board · Live universe</span>
          <span class="mock-pills">
            {haveLiveBoard && regime && <span class="pill-chip">Regime: {regime}</span>}
            {haveLiveBoard && breadth != null && <span class="pill-chip">Breadth {breadth}%</span>}
            {!haveLiveBoard && <span class="mock-tag">Illustration</span>}
          </span>
        </div>

        {/* MOTION CLASS IS LOAD-BEARING, not decoration:
            --live        real session figures -> tints FIXED, only the refresh wash animates
            --illustrative no figures at all   -> tints free to cycle
            Swapping the first for the second would animate a real company's cell from green to
            red while its printed percentage says otherwise. See the motion block in global.css. */}
        {haveLiveBoard ? (
          <div class="heat heat--live">
            {/* slice(0,15), not map over the whole board: .heat is repeat(5,1fr) drawing its rules
                with the gap, so any count that is not a multiple of 5 leaves the final row painting
                the line colour as solid blocks. The gate is >= 15, so the slice can never starve. */}
            {board.slice(0, 15).map((b) => (
              <div class="heat-cell" data-dir={dir(b.pct)}>
                <span class="hc-sym">{b.sym}</span>
                <span class="hc-pct">{fmtPct(b.pct)}</span>
              </div>
            ))}
          </div>
        ) : (
          <div class="heat heat--illustrative">
            {fallbackHeat.map(([sym, d]) => (
              <div class="heat-cell" data-dir={d}><span class="hc-sym">{sym}</span></div>
            ))}
          </div>
        )}

        <div class="mock-sec">
          <div class="label">Backtested-strategy signals</div>
          {haveLiveBoard ? (
            signals.map((s) => (
              <div class="sig sig-row">
                <span class="sig-id">
                  <b>{s.sym}</b>
                  <em>{s.name}</em>
                </span>
                <span class="sig-tag">{s.tag}</span>
                <span class="sig-px" data-dir={dir(s.pct)}>
                  {s.close.toFixed(2)}
                  <i>{fmtPct(s.pct)}</i>
                </span>
              </div>
            ))
          ) : (
            <>
              <div class="sig"><span>Golden cross</span><span class="muted">trend</span></div>
              <div class="sig"><span>52-week high break</span><span class="muted">breakout</span></div>
              <div class="sig"><span>50-day reclaim</span><span class="muted">momentum</span></div>
            </>
          )}
        </div>

        {/* The date stamp is the honesty guard: this rebuilds on deploy, not live, and without
            it a stale build would quietly imply real-time prices. */}
        {haveLiveBoard && asOf && (
          <div class="mock-foot">
            <span>Real desk data · session {asOf}</span>
            <span class="mock-foot-r">Rebuilt each deploy · not live</span>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ================= TRUST BAR ================= -->
  <section class="band-panel trust">
    <div class="wrap">
      <div class="tilegrid trust-grid">
        {stats.map(([n, l]) => (
          <div>
            <div class="pixel trust-n">{n}</div>
            <div class="label muted trust-l">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= HOW IT WORKS ================= -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">How the desk works</p>
      <h2>Pick a stock. The desk does the homework. You decide.</h2>
      <div class="tilegrid steps">
        {steps.map(([n, t, d, ic]) => (
          <div class="tile">
            <span class="tile-i"><Icon name={ic} size={20} /></span>
            <div class="step-n label">{n}</div>
            <h3>{t}</h3>
            <p class="muted step-d">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 01 BOARD ================= -->
  <section class="section band-panel">
    <div class="wrap two-col">
      <div>
        <p class="kicker">01 · Board</p>
        <h2>The whole market on one screen</h2>
        <p class="lead">
          A live universe heatmap, backtested rule-based signals, predictability ranks, and a rolling
          news wire. See where breadth is, which sectors are favoured, and what screens well today —
          before you open a single chart.
        </p>
        <a href="/features" class="btn">Explore the board</a>
      </div>
      <div class="mock">
        <div class="mock-bar">
          <span class="label">Predictability ranks</span>
          <span class="mock-tag">19 yrs backtested</span>
        </div>
        <div class="mock-body">
          {[82, 71, 64, 55, 47].map((w, i) => (
            <div class="rank">
              <span class="rank-k">RANK {i + 1}</span>
              <div class="rank-bar"><span style={`width:${w}%`}></span></div>
            </div>
          ))}
          <p class="mock-note muted">Illustration of the ranking layout.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 02 VALUE ================= -->
  <section class="section">
    <div class="wrap two-col rev">
      <div class="mock">
        <div class="mock-bar">
          <span class="label">Valued four ways</span>
          <span class="mock-tag">Illustration</span>
        </div>
        <div class="mock-body">
          {['Peer P/E', 'Earnings power vs bond yield', 'Graham', 'Dividend discount'].map((m) => (
            <div class="vrow"><span>{m}</span><span class="muted">model</span></div>
          ))}
          <hr class="hair" />
          <div class="vband">
            <div class="label muted">Consensus fair value</div>
            <div class="pixel vband-v">— · —</div>
            <p class="mock-note muted">Real figures appear in the desk, computed per stock.</p>
          </div>
        </div>
      </div>
      <div>
        <p class="kicker">02 · Value</p>
        <h2>Four valuations. All the working.</h2>
        <p class="lead">
          Every stock valued by peer P/E, earnings-power vs the bond yield, Graham, and a
          dividend-discount model — with each model’s full working expandable, so you can check the
          maths, not just trust a number.
        </p>
        <a href="/features" class="btn">See the models</a>
      </div>
    </div>
  </section>

  <!-- ================= 03 DESK ROOM ================= -->
  <section class="section band-dark deskroom">
    <div class="wrap two-col">
      <div>
        <p class="kicker dr-kicker">03 · The Desk Room</p>
        <h2>Watch an AI analyst desk argue it out</h2>
        <p class="lead dr-lead">
          On every ticker, named analyst personas — a technical desk, a fundamental desk, a bull and
          a bear — debate the stock, hard. No verdict, no house view, no target: nothing is hidden,
          you see who argued what and call it yourself.
        </p>
        <button class="btn" id="drPlay">▶ Watch the desk analyse</button>
        <p class="dr-hint muted" id="drHint">Replay stages the debate in sequence — hit play</p>
      </div>

      <div class="dr-card">
        <div class="dr-bar">
          <span class="label">Desk Room<span class="dr-live" id="drLive"></span></span>
          <span class="muted">4 desks · no verdict</span>
        </div>
        <div class="dr-body" id="drBody">
          <div class="dr-block" data-i="0">
            <div class="label">Technical desk</div>
            <p>Trend intact; reclaiming the 50-day on rising volume.</p>
          </div>
          <div class="dr-block" data-i="1">
            <div class="label">Fundamental desk</div>
            <p>Cheap on earnings power. Growth is the open question.</p>
          </div>
          <div class="dr-block" data-i="2">
            <div class="label up">Bull</div>
            <p>Value plus dividend cover carries it through the cycle.</p>
          </div>
          <div class="dr-block" data-i="3">
            <div class="label dn">Bear</div>
            <p>Fair value leans on an aggressive growth input.</p>
          </div>
        </div>
        <p class="mock-note muted dr-illus">Illustration of a session. Real debates run per stock.</p>
      </div>
    </div>
  </section>

  {/* ================= 04 THE WORLD =================
      The counts come from coverage.json, so this block cannot drift from what the pipeline covers.
      It states the limit in the same breath as the claim: index and sector level, context only, no
      signals. config/markets.json sets signals_enabled:false for the US book and this section is
      the public face of that flag — describing it as a track record would be false. */}
  <section class="section">
    <div class="wrap two-col rev">
      <div class="mock">
        <div class="mock-bar">
          <span class="label">Global coverage</span>
          <span class="mock-tag">{globalCount} symbols · end of day</span>
        </div>
        <div class="mock-body">
          {globalGroups.map(([label, key]) => (
            <div class="vrow">
              <span>{label}</span>
              <span class="muted">{(usGroups[key] ?? []).length}</span>
            </div>
          ))}
          <hr class="hair" />
          <div class="vrow gw-row">
            <span>Signals generated on these</span>
            <span class="pixel gw-zero">0</span>
          </div>
          <p class="mock-note muted">
            Context for the PSX book. The desk’s risk rules are calibrated on PSX behaviour, so a
            global symbol never produces a setup.
          </p>
        </div>
      </div>
      <div>
        <p class="kicker"><Icon name="global" size={14} /> 04 · The world</p>
        <h2>Karachi does not trade in isolation</h2>
        <p class="lead">
          The tape that moves PSX is not listed on it. The desk tracks {globalCount} global symbols —
          the broad indices, the eleven US sector ETFs, the EM and developed baskets a foreign
          allocator rotates between, and the rates, credit, gold and oil that set Pakistan’s import
          bill — and reads them against its own PSX sector work.
        </p>
        <a href="/global-markets/" class="btn" data-ev="home_section_link" data-ev-section="global">
          What the desk covers ›
        </a>
      </div>
    </div>
  </section>

  <!-- ================= 05 SCORES (method, not numbers) ================= -->
  <section class="section band-panel">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">05 · Scores</p>
        <h2>The desk grades itself in public</h2>
        <p class="lead">
          Every call carries a date and a falsifiable expectation. When the outcome window closes,
          it’s scored against what prices actually did — the desk’s calls and the brokers’ alike. No
          cherry-picking, no quiet deletions.
        </p>
      </div>
      <div class="tilegrid score-how">
        <div>
          <div class="label">1 · Dated</div>
          <p class="muted">Every view is stamped with the date it was made and the window it must play out in.</p>
        </div>
        <div>
          <div class="label">2 · Falsifiable</div>
          <p class="muted">It states what would prove it wrong — so it can actually be graded, not argued about.</p>
        </div>
        <div>
          <div class="label">3 · Scored</div>
          <p class="muted">When the window closes it’s marked against real prices, and the misses stay on the record.</p>
        </div>
        <div>
          <div class="label">4 · Brokers too</div>
          <p class="muted">Public broker calls are captured and graded on the same bar. Audited, never trusted.</p>
        </div>
      </div>
      <p class="score-note muted">
        The public scorecard opens once enough calls have resolved to mean something. Until then we
        show the method, not a number — a track record you can’t check isn’t a track record.
      </p>
    </div>
  </section>

  {/* ================= THE SKY =================
      Figures read from state/astro.json and state/astro_backtest.json. The null result IS the
      pitch — no edge is claimed anywhere in this block, per astro_map.json's own discipline
      ("a lens the desk reports and scores, nothing more"). */}
  <section class="section band-dark sky">
    <div class="wrap two-col">
      <div>
        <p class="kicker dr-kicker">06 · The sky</p>
        <h2>The only desk that tests its own astrology</h2>
        <p class="lead dr-lead">
          Sidereal positions, Lahiri ayanamsa, the nine classical grahas — computed to the degree,
          ninety days ahead. What tradition claims each one governs is written down <em>first</em>,
          then tested against nineteen years of PSX prices on the same bar as every other strategy
          here.
        </p>
        <p class="sky-verdict">
          So far: <b>2,589 hypotheses tested, none survived correction.</b> We publish that, because
          a lens you refuse to test isn’t research — it’s a horoscope with a Bloomberg terminal.
        </p>
        <div class="sky-cta">
          {/* Points at the dedicated page, not /features. That page carries the full method, the
              multiplicity correction and the null result — and it is the one the homepage should
              pass authority to, since it is what an "is astrology real for markets" search lands on. */}
          <a href="/financial-astrology/" class="btn" data-ev="home_section_link" data-ev-section="astro">
            Read the tested lens ›
          </a>
          <a href={site.appUrl} class="btn btn-ghost" rel="noopener">Cast your chart free</a>
        </div>
      </div>

      <div class="sky-card">
        <div class="dr-bar">
          <span class="label">Astro · computed</span>
          <span class="muted">sidereal · Lahiri</span>
        </div>
        <div class="sky-body">
          <div class="sky-row"><span class="muted">Zodiac</span><span>Sidereal (Lahiri)</span></div>
          <div class="sky-row"><span class="muted">Bodies</span><span>9 classical grahas</span></div>
          <div class="sky-row"><span class="muted">Horizon</span><span>90 days ahead</span></div>
          <div class="sky-row"><span class="muted">Granularity</span><span>Nakshatra &amp; pada</span></div>
          <div class="sky-rule"></div>
          <div class="sky-row sky-null"><span>Conditions with a proven edge</span><span class="pixel">0</span></div>
          <p class="sky-fine muted">
            Published, not buried. The lens never generates or gates a trade setup.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ================= 07 LATEST =================
      Real release data, not copy — see changelogData above. Single spotlight card because the
      changelog holds one dated release today; a forced 3-up grid would invent structure the data
      doesn't have. */}
  <section class="section updates">
    <div class="wrap">
      <div class="sec-head">
        <p class="kicker">07 · Latest</p>
        <h2>The desk ships in the open</h2>
        <p class="lead">Every dated release, in plain language — what changed, and why, no changelog jargon.</p>
      </div>

      {latestRelease && (
        <div class="upd-card">
          <div class="upd-bar">
            <span class="upd-v">{latestRelease.version}</span>
            <span class="muted">{latestRelease.date}</span>
          </div>
          <div class="upd-body">
            <h3>{latestRelease.title}</h3>
            <ul class="upd-notes">
              {latestRelease.notes.slice(0, 5).map((n) => <li>{n}</li>)}
            </ul>
          </div>
        </div>
      )}

      {olderReleases.length > 0 && (
        <div class="upd-older">
          {olderReleases.map((r) => (
            <div class="upd-old-row">
              <span class="upd-old-v">{r.version}</span>
              <span class="upd-old-t">{r.title}</span>
              <span class="muted">{r.date}</span>
            </div>
          ))}
        </div>
      )}

      <a
        href={site.appUrl}
        class="seg-2 upd-link"
        rel="noopener"
        data-ev="home_section_link"
        data-ev-section="updates"
      >See what shipped, inside the desk <Icon name="arrow" size={12} /></a>
    </div>
  </section>

  <!-- ================= PRINCIPLES ================= -->
  <section class="section band-panel">
    <div class="wrap">
      {/* Headed, because a bare tile strip floating between two banded sections reads as leftover
          layout rather than as a section with something to say. */}
      <div class="sec-head">
        <p class="kicker"><Icon name="risk" size={14} /> How the desk works</p>
        <h2>Rules it cannot talk itself out of</h2>
      </div>
      <div class="tilegrid principles">
        {principles.map(([t, d, ic]) => (
          <div class="tile">
            <span class="tile-i"><Icon name={ic} size={20} /></span>
            <h3>{t}</h3>
            <p class="muted">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ================= THE SIZING PROOF =================
      "Research, not advice" is a claim every desk makes. This is the one place it cost something,
      so it is the one worth showing: the share count came out of the published setup and went into
      a free calculator the reader drives. The formula shown here is CLAUDE.md Rule 4 verbatim —
      if that rule ever changes, this block and the calculator must change with it. */}
  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="kicker"><Icon name="risk" size={14} /> Research, not advice</p>
        <h2>We deleted our own share count</h2>
        <p class="lead">
          Setups used to carry a number of shares. It was honest arithmetic — and it was arithmetic
          on <em>our</em> capital and <em>our</em> risk budget, printed next to a ticker where it read
          like an instruction. So it came out.
        </p>
        <p class="psz-body muted">
          The formula stayed, in the open. It is now a calculator you drive: your capital, your risk
          per trade, your stop. Same rule the desk sizes by, no account needed, nothing sent anywhere.
        </p>
        <a
          href="/tools/position-size-calculator/"
          class="btn btn-solid"
          data-ev="home_section_link"
          data-ev-section="position_size"
        >Size a position free ›</a>
      </div>

      <div class="mock">
