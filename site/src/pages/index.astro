<script>
  /* THE DESK ROOM SESSION.
     The old version just faded five blocks in on a timer. This runs it as a debate: each desk
     takes the spotlight while the others dim, the panel header shows a live counter, and the
     button reports state instead of sitting there re-clickable mid-run.

     Timers are tracked and cleared on re-entry — without that, a second click part-way through
     leaves the first run's callbacks firing into the second, and the spotlight jumps around. */
  const play = document.getElementById('drPlay');
  const hint = document.getElementById('drHint');
  const live = document.getElementById('drLive');
  const card = document.querySelector('.dr-card') as HTMLElement | null;
  const body = document.getElementById('drBody');
  const blocks = Array.from(document.querySelectorAll('.dr-block')) as HTMLElement[];
  const NAMES = ['Technical desk', 'Fundamental desk', 'Bull', 'Bear'];
  const BEAT = 900;                       // slow enough to actually read a line before the next
  let timers: number[] = [];

  function endSession() {
    body?.classList.remove('is-replaying');
    card?.classList.remove('is-live');
    blocks.forEach((b) => b.classList.remove('is-speaking'));
    if (play) { play.textContent = '▶ Replay the session'; (play as HTMLButtonElement).disabled = false; }
    if (hint) hint.textContent = 'That is one session. The desk runs this on every ticker.';
  }

  play?.addEventListener('click', () => {
    (window as any).posthog?.capture('desk_room_demo_played');
    timers.forEach(clearTimeout);
    timers = [];
    body?.classList.add('is-replaying');
    card?.classList.add('is-live');
    (play as HTMLButtonElement).disabled = true;
    play.textContent = 'Session running…';
    blocks.forEach((b) => { b.classList.add('is-hidden'); b.classList.remove('is-in', 'is-speaking'); });

    blocks.forEach((b, i) => {
      timers.push(
        window.setTimeout(() => {
          blocks.forEach((x) => x.classList.remove('is-speaking'));
          b.classList.remove('is-hidden');
          b.classList.add('is-in', 'is-speaking');
          if (live) live.textContent = `${NAMES[i]} — ${i + 1} of ${blocks.length}`;
          if (hint) hint.textContent = i === blocks.length - 1
            ? 'That is the debate — no verdict handed down.'
            : `${NAMES[i]} is making its case…`;
        }, i * BEAT)
      );
    });
    // Bear's block is the last word, so the session holds on it before releasing the spotlight.
    timers.push(window.setTimeout(endSession, blocks.length * BEAT + 1400));
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.hero-cta a').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('hero_cta_clicked', {
          cta_label: el.textContent.trim(),
          cta_destination: el.getAttribute('href')
        });
      });
    });
  });
</script>
