---
import Base from '../layouts/Base.astro';
import PlansPaid from '../components/PlansPaid.astro';
import { site } from '../site.config.ts';

const { currency, monthsFreeOnAnnual } = site.billing;
const D = site.trialDays;
const early = site.earlyAccess;
const mail = `mailto:${site.contactEmail}?subject=Feedback%20on%20Henneth`;

// The desk is members-only, so every CTA lands on its sign-up screen with the chosen plan
// carried across. `?plan=` is INTENT, not entitlement — it only decides which onboarding the
// visitor gets. The actual plan comes from the database; anything the URL can set, a visitor
// can forge. `auth=signup` opens the create-account form directly rather than making someone
// who just clicked "Get started" hunt for it, with a log-in link alongside for returning users.
const enter = (appPlan: string | null) =>
  appPlan ? `${site.appUrl}/?plan=${appPlan}&auth=signup` : `${site.appUrl}/?auth=signup`;

const why = [
  [
    'The record isn’t old enough to sell',
    'The desk grades its own calls in public. Most of them haven’t reached their outcome date yet — so there is nothing proven to charge for. Asking for money before that would be asking for trust we haven’t earned.',
  ],
  [
    'We’d rather find the holes now',
    'Every stock page, every valuation, every debate is new. Real investors will find the confusing bits and the wrong bits far faster than we will. That feedback is worth more to us right now than revenue.',
  ],
  [
    'New and experienced investors see different things',
    'If you’re starting out, you’ll show us where the desk assumes knowledge it shouldn’t. If you’ve traded PSX for years, you’ll catch where a number or a read is off. We want both in here.',
  ],
  [
    'No card, no clock, no catch',
    'There’s no payment set up, so there’s nothing to cancel and nothing to forget about. When paid plans do open, the people who used it early will hear first — and keep a founding price.',
  ],
];

const faqs = [
  ['So this is genuinely free?', 'Yes. The whole desk is open during early access. No card is collected, no trial timer runs, and nothing switches itself on later without you choosing it.'],
  ['What’s the catch?', 'There isn’t one — but be clear-eyed about the stage. This is a young product. Some things will be rough, and the public track record is still filling up. That’s exactly why we want you in it now.'],
  ['Is this financial advice?', 'No. Henneth is an educational research and analytics tool. It never gives personalised advice, never says buy or sell, and never places orders. You make your own decisions.'],
  ['What happens when you start charging?', 'We’ll tell you well before anything changes, and you’ll never be charged automatically. Early users get first word and a founding price.'],
  ['Where does the data come from?', 'Prices come from the exchange’s published end-of-day data, with a long price history used for backtests, and fundamentals from public filings. Every figure traces to that data layer — nothing is quoted from memory.'],
  ['Do you show your losses?', 'Yes. Every dated call is scored against what prices actually did, and the misses stay on the record. A track record that only shows wins isn’t one.'],
  ['How do I send feedback?', `Email ${site.contactEmail}. Anything — a number that looks wrong, a page that confused you, a feature you expected and couldn’t find. It all gets read.`],
];

/* FAQPage schema is built FROM the same array the page renders below, not typed a second time.
   Google requires the marked-up answer to be the visible one, and "is this free / what's the catch
   / is this advice" is exactly the query set this page should own. Only emitted in early access —
   the paid variant (PlansPaid) renders different questions, so marking these up there would
   describe copy that isn't on the page. */
const faqLd = early ? faqs.map(([q, a]) => ({ q, a })) : undefined;
---

<Base
  title={early ? 'Plans — free during early access' : 'Plans'}
  path="/plans"
  active="plans"
  faq={faqLd}
  description={
    early
      ? 'Henneth is free during early access. The whole research desk is open — come in, use it, and tell us what needs fixing.'
      : 'Henneth plans — Investor and Pro, each with a 14-day trial, plus a Broker tier for desks and institutions.'
  }
>
  {
    early ? (
      <>
        {/* ============ EARLY ACCESS ============ */}
        <section class="section-tight ph">
          <div class="wrap center">
            <span class="badge ea-badge"><span class="dot" />Early access</span>
            <h1>Right now, all of it is free</h1>
            <p class="lead ph-lead">
              Every part of the desk is open — the company reads, the valuations, the tested
              strategies and the analyst debates. No card, no trial timer, no plan to pick.
            </p>
            <div class="ph-cta">
              <a href={enter('pro')} class="btn btn-solid btn-lg" rel="noopener">Open the desk</a>
              <a href={mail} class="btn btn-lg">Send feedback</a>
            </div>
            <p class="ph-fine">Use it properly, then tell us what’s wrong with it.</p>
          </div>
        </section>

        {/* What you get — the tiers, unpriced */}
        <section class="section-tight">
          <div class="wrap">
            <div class="tiers">
              {site.plans.map((p) => (
                <div class="tier" data-featured={p.featured} data-soon={p.soon}>
                  {p.soon && <div class="ribbon" data-soon="true">In build</div>}
                  <div class="tier-in">
                    <h3 class="tier-n">{p.name}</h3>
                    <div class="tier-price">
                      <span class="amt">{p.soon ? '—' : 'Free'}</span>
                    </div>
                    <p class="tier-billed">
                      {p.soon ? 'not open yet' : 'open during early access'}
                    </p>
                    <p class="tier-blurb">{p.blurb}</p>
                    {p.soon ? (
                      <button class="btn tier-cta" disabled>Coming soon</button>
                    ) : (
                      <a href={enter(p.appPlan)} class="btn tier-cta" rel="noopener">Get started</a>
                    )}
                    <ul class="tier-feats">
                      {p.features.map((f) => <li>{f}</li>)}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
            <p class="tiers-note">
              These are the plans we expect to run later. Everything outside the Broker tier is
              switched on for everyone today.
            </p>
          </div>
        </section>

        {/* Why it's free */}
        <section class="section band-panel">
          <div class="wrap">
            <p class="kicker">Why it’s free</p>
            <h2>We haven’t earned the right to charge yet</h2>
            <div class="tilegrid why">
              {why.map(([t, d]) => (
                <div>
                  <h3>{t}</h3>
                  <p class="muted why-d">{d}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        {/* Feedback */}
        <section class="section band-dark center">
          <div class="wrap">
            <p class="kicker dr-kicker">Tell us what you think</p>
            <h2>The feedback is the point</h2>
            <p class="lead fb-lead">
              Whether this is your first year on the PSX or your fifteenth — if something is
              confusing, wrong, or missing, we want to hear it. Every email gets read.
            </p>
            <a href={mail} class="btn btn-lg">{site.contactEmail}</a>
            <p class="fb-fine muted">Research · not advice · The desk never places orders</p>
          </div>
        </section>

        {/* FAQ */}
        <section class="section">
          <div class="wrap faq-wrap">
            <p class="kicker">Questions</p>
            <h2>Before you start</h2>
            <div class="faq">
              {faqs.map(([q, a]) => (
                <details class="fq">
                  <summary><span>{q}</span><i>+</i></summary>
                  <p class="muted">{a}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      </>
    ) : (
      <PlansPaid />
    )
  }
</Base>

<style>
  .center { text-align: center; }
  .ea-badge { margin-bottom: 18px; }
  .ph-lead { max-width: 640px; margin: 0 auto 24px; }
  .ph-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .ph-fine {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-3); margin-top: 16px;
  }

  .tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px; background: var(--line); border: var(--rule); }
  .tier { background: var(--panel); position: relative; }
  .tier[data-featured='true'] { background: var(--ink-1); color: var(--bg); }
  .tier[data-soon='true'] { background: var(--panel-2); }
  .tier-in { padding: 26px 20px; display: flex; flex-direction: column; height: 100%; }
  .ribbon {
    position: absolute; top: 0; right: 0; background: var(--ink-3); color: #fff;
    font-size: 8.5px; letter-spacing: 0.12em; text-transform: uppercase;
    font-weight: 700; padding: 5px 10px;
  }
  .tier-n { font-size: 14px; margin-bottom: 16px; }
  .tier-price { display: flex; align-items: baseline; gap: 5px; }
  .amt {
    font-family: var(--font-mono); font-size: 34px; font-weight: 800;
    letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1;
  }
  .tier[data-soon='true'] .amt { color: var(--ink-3); }
  .tier-billed {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ink-3); margin: 8px 0 0;
  }
  .tier[data-featured='true'] .tier-billed { color: #9a9a92; }
  .tier-blurb { font-size: 11.5px; margin: 16px 0 18px; flex: 1; color: var(--ink-2); }
  .tier[data-featured='true'] .tier-blurb { color: #c8c8c0; }
  .tier-cta { justify-content: center; width: 100%; }
  .tier[data-featured='true'] .tier-cta { background: var(--bg); color: var(--ink-1); border-color: var(--bg); }
  .tier[data-featured='true'] .tier-cta:hover { background: #fff; }
  .tier-feats { list-style: none; padding: 0; margin: 22px 0 0; }
  .tier-feats li {
    font-size: 11px; padding: 8px 0 8px 18px; position: relative;
    border-top: 1px dotted var(--hair); color: var(--ink-2);
  }
  .tier[data-featured='true'] .tier-feats li { border-color: #2f2f2c; color: #c8c8c0; }
  .tier-feats li::before { content: '✓'; position: absolute; left: 0; color: var(--up); font-weight: 700; }
  .tier[data-soon='true'] .tier-feats li::before { color: var(--ink-3); }
  .tiers-note {
    font-size: 10.5px; color: var(--ink-3); margin: 16px 0 0; max-width: 640px;
  }

  .why { grid-template-columns: repeat(2, 1fr); margin-top: 20px; }
  .why h3 { font-size: 12px; }
  .why-d { font-size: 11.5px; margin: 8px 0 0; }

  .dr-kicker { color: #8f8f88; }
  .fb-lead { max-width: 620px; margin: 0 auto 24px; color: #c8c8c0; }
  .fb-fine { font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 22px; color: #8f8f88; }

  .faq-wrap { max-width: 800px; }
  .faq { margin-top: 20px; border-top: var(--rule); }
  .fq { border-bottom: var(--rule); }
  .fq summary {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 0; cursor: pointer; list-style: none;
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
  }
  .fq summary::-webkit-details-marker { display: none; }
  .fq summary i { font-style: normal; font-size: 18px; transition: transform 0.2s ease; }
  .fq[open] summary i { transform: rotate(45deg); }
  .fq p { font-size: 11.5px; padding: 0 0 16px; margin: 0; max-width: 680px; }

  @media (max-width: 900px) { .tiers, .why { grid-template-columns: 1fr; } }
  /* The one page whose only job is to be read and acted on. Everything that argues for a plan —
     blurb, feature list, the note under the tiers, the FAQ answers — was 11.5px or under. The
     ribbon stays at 8.5px: it is a corner flag, not a sentence, and growing it eats the tier's
     top-right corner. */
  @media (max-width: 720px) {
    .ph-fine { font-size: 11px; letter-spacing: 0.09em; }
    .tier-billed { font-size: 11px; }
    .tier-blurb { font-size: 13px; }
    .tier-feats li { font-size: 12.5px; padding: 11px 0 11px 18px; }
    .tiers-note { font-size: 12px; }
    .why-d, .fq p { font-size: 13px; }
    .fb-fine { font-size: 11px; letter-spacing: 0.09em; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    /* plan_started — capture which plan a visitor clicked through on */
    document.querySelectorAll('.tier-cta:not([disabled])').forEach(function (el) {
      el.addEventListener('click', function () {
        var tier = el.closest('.tier');
        var planName = tier ? (tier.querySelector('.tier-n') || {}).textContent || '' : '';
        window.posthog?.capture('plan_started', { plan_name: planName.trim() });
      });
    });

    /* faq_expanded — fires when a FAQ item is opened */
    document.querySelectorAll('.fq').forEach(function (el) {
      el.addEventListener('toggle', function () {
        if (el.open) {
          var question = (el.querySelector('summary span') || {}).textContent || '';
          window.posthog?.capture('faq_expanded', { question: question.trim() });
        }
      });
    });
  });
</script>
