---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site.config.ts';
import { getCollection, render } from 'astro:content';

// The route the blog index has been linking at since it was written. Without this file every
// `/blog/<slug>/` href on that page 404s, so no post can be published at all — which is why the
// content engine has been blocked regardless of how much was written.
//
// `[...slug]` (rest, not `[slug]`) so a post can live in a subfolder later — `valuation/pe-ratio`
// — without needing a second route file. The glob loader already puts the folder in `entry.id`.
export async function getStaticPaths() {
  // Drafts are excluded here AND in the index, so a draft is unreachable rather than merely
  // unlisted. An unlisted-but-live URL is the failure mode that leaks half-written posts to
  // anyone who guesses the slug — and to Google, which does not need to guess.
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
// `headings` is what makes a real table of contents possible — Astro extracts it from the
// rendered markdown, so it can never drift out of sync with the body the way a hand-written
// contents list does.
const { Content, headings } = await render(post);

const path = `/blog/${post.id}/`;
const url = new URL(path, site.url).href;
const published = post.data.pubDate;
const updated = post.data.updatedDate ?? post.data.pubDate;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-PK', { year: 'numeric', month: 'long', day: 'numeric' });

/* Computed, never a frontmatter field: a writer cannot forget it, and it re-derives on every
   edit. 200 wpm is the conventional prose rate. */
const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const mins = Math.max(1, Math.round(words / 200));

// h2 only. A TOC that lists every h3 stops being a map and becomes a second copy of the article.
const toc = headings.filter((h) => h.depth === 2);

const CLUSTER_ICON: Record<string, string> = {
  Valuation: 'value',
  'Market structure': 'board',
  Method: 'method',
  Sectors: 'sectors',
  Astro: 'astro',
  Macro: 'macro',
};
const iconFor = (c?: string) => CLUSTER_ICON[c ?? ''] ?? 'method';

/* Related = same cluster, newest first, current post excluded. Falls back to the newest posts
   overall so the rail is never empty on the first post in a cluster — a dead-end at the bottom of
   an article is a wasted internal link, and internal links are most of what this page is for. */
const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const others = all.filter((p) => p.id !== post.id);
const sameCluster = others.filter((p) => p.data.cluster && p.data.cluster === post.data.cluster);
const related = (sameCluster.length ? sameCluster : others).slice(0, 3);

const shareText = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(url);

// Article — the schema Google reads for the article rich result and for Discover eligibility.
// `dateModified` is what earns the "Updated" treatment, so it is emitted even when it equals
// `datePublished`; the alternative is looking permanently stale on an evergreen explainer.
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: updated.toISOString(),
  image: new URL('/og.jpg', site.url).href,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', site.url).href },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isAccessibleForFree: true,
};

/* No BreadcrumbList here — Base derives the Home > Blog > Post trail from `path`, and the leaf
   already resolves to `title`, which is the post title. */
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={path}
  active="blog"
  ogType="article"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
    <meta property="article:published_time" content={published.toISOString()} />
    <meta property="article:modified_time" content={updated.toISOString()} />
  </Fragment>

  {/* Reading progress. Fixed to the very top, above the sticky nav, and driven by scroll — the
      cheapest possible signal of "how much of this is left", which is the question every reader
      of a long explainer is silently asking. */}
  <div class="rp-bar" aria-hidden="true"><span id="rpFill"></span></div>

  <section class="section-tight ph">
    <div class="wrap">
      <p class="kicker"><Icon name={iconFor(post.data.cluster)} size={14} /> {post.data.cluster || 'Method'}</p>
      <h1 class="post-h1">{post.data.title}</h1>
      <p class="lead post-lead">{post.data.description}</p>
      <p class="post-meta muted">
        <time datetime={published.toISOString()}>{fmt(published)}</time>
        {post.data.updatedDate && <span> · Updated {fmt(post.data.updatedDate)}</span>}
        <span> · {mins} min read</span>
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap post-grid">
      <article class="prose">
        <Content />

        <div class="share">
          <span class="share-l">Share</span>
          <a class="share-a" href={`https://x.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
             target="_blank" rel="noopener noreferrer" data-ev="share_click" data-ev-net="x">X</a>
          <a class="share-a" href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
             target="_blank" rel="noopener noreferrer" data-ev="share_click" data-ev-net="whatsapp">WhatsApp</a>
          <a class="share-a" href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
             target="_blank" rel="noopener noreferrer" data-ev="share_click" data-ev-net="linkedin">LinkedIn</a>
          <button class="share-a" id="copyLink" data-ev="share_click" data-ev-net="copy">Copy link</button>
        </div>

        <p class="post-back"><a href="/blog/">← All writing</a></p>
      </article>

      {/* Sticky rail. Hidden below 1000px rather than stacked — a TOC that scrolls past above the
          article it indexes is decoration, not navigation. */}
      {toc.length > 2 && (
        <aside class="toc" aria-label="On this page">
          <p class="toc-h"><Icon name="list" size={13} /> On this page</p>
          <nav>
            {toc.map((h) => (
              <a class="toc-a" href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <p class="kicker"><Icon name="research" size={14} /> Keep reading</p>
        <div class="tilegrid rel">
          {related.map((p) => (
            <a class="post tile" href={`/blog/${p.id}/`}>
              <span class="tile-i"><Icon name={iconFor(p.data.cluster)} size={20} /></span>
              <span class="label muted rel-cl">{p.data.cluster}</span>
              <h3>{p.data.title}</h3>
              <p class="muted rel-d">{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section band-dark">
    <div class="wrap post-cta">
      <div>
        <p class="kicker dr-kicker">The desk</p>
        <h2>Read any PSX company this way</h2>
        <p class="lead post-cta-lead">
          Henneth does this for every listed company — in plain English, from real filings.
          Research, not advice.
        </p>
      </div>
      <a class="btn" href={`${site.appUrl}/?auth=signup`} rel="noopener">Get started</a>
    </div>
  </section>
</Base>

<style>
  .ph { padding-bottom: 0; }
  .post-h1 { max-width: 20ch; }
  .post-lead { max-width: 60ch; }
  .post-meta { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 16px; }

  /* The MDX body. Scoped styles do not reach <Content />'s markup, so this uses :global()
     inside .prose — narrow enough not to leak into the rest of the page. */
  /* BREAKOUT GRID. Prose and figures want different widths and the old `max-width: 68ch` on the
     container forced them to share one: text was correctly ~68ch, but so was every <figure>, which
     squeezed a four-column Snapshot into ~131px cells and left ~440px of dead space between the
     article and the TOC rail.

     The first track holds the readable measure and figures span both, so an explainer's tables and
     timelines get the full column while body text keeps its line length. The measure track is
     FIRST rather than centred so body text stays flush left with the H1 and standfirst above it —
     centring it inside the wide column left the header and the body on two different left edges.
     `min(68ch, 100%)` rather than a bare 68ch so the track cannot overflow a narrow viewport. */
  .prose { display: grid; grid-template-columns: min(68ch, 100%) minmax(0, 1fr); }
  .prose > :global(*) { grid-column: 1; }
  .prose > :global(figure) { grid-column: 1 / -1; margin-inline: 0; }
  .prose :global(h2) { margin: 40px 0 12px; font-size: 16px; }
  .prose :global(h3) { margin: 28px 0 10px; font-size: 13px; }
  .prose :global(p) { margin: 0 0 16px; font-size: 13px; line-height: 1.75; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 20px; font-size: 13px; line-height: 1.75; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(blockquote) { margin: 24px 0; padding: 12px 18px; border-left: 1.5px solid var(--ink-1); background: var(--panel-2); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 11.5px; background: var(--panel-2); padding: 2px 5px; }
  .prose :global(pre) { padding: 16px; background: var(--panel-2); overflow-x: auto; margin: 0 0 16px; }
  .prose :global(pre code) { background: none; padding: 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 0 0 16px; font-size: 12px; }
  .prose :global(th), .prose :global(td) { border: var(--rule); padding: 8px 10px; text-align: left; }
  .prose :global(th) { background: var(--panel-2); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; }
  .prose :global(img) { max-width: 100%; height: auto; }
  .prose :global(hr) { border: 0; border-top: var(--rule); margin: 32px 0; }

  /* Reading progress. z-index above the sticky nav (60) so it is never covered. */
  .rp-bar { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 70; background: transparent; }
  .rp-bar span { display: block; height: 100%; width: 0; background: var(--up); transition: width 0.08s linear; }

  /* Article + sticky TOC rail. minmax(0,1fr) not 1fr: a wide <pre> or table inside .prose would
     otherwise force the column past its track and push the rail off screen. */
  .post-grid { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 48px; align-items: start; }
  .toc { position: sticky; top: 78px; border-left: var(--rule); padding-left: 16px; }
  .toc-h {
    display: flex; align-items: center; gap: 6px; margin: 0 0 10px;
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-3);
  }
  .toc nav { display: flex; flex-direction: column; gap: 9px; }
  .toc-a {
    font-size: 11px; line-height: 1.5; color: var(--ink-2); text-decoration: none;
    border-left: 1.5px solid transparent; padding-left: 10px; margin-left: -12px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .toc-a:hover { color: var(--ink-1); }
  .toc-a.on { color: var(--ink-1); border-left-color: var(--up); font-weight: 700; }

  /* Anchor offset so a TOC jump does not land the heading under the sticky nav. */
  .prose :global(h2) { scroll-margin-top: 86px; }

  .share { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 40px; padding-top: 20px; border-top: var(--rule); }
  .share-l { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); margin-right: 2px; }
  .share-a {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase;
    font-weight: 700; padding: 7px 11px; border: 1px solid var(--hair); background: var(--panel);
    color: var(--ink-1); text-decoration: none; cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .share-a:hover { border-color: var(--ink-1); background: var(--panel-2); }

  .rel { grid-template-columns: repeat(3, 1fr); margin-top: 14px; }
  .rel-cl { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; }
  .rel-d { font-size: 11px; margin: 6px 0 0; line-height: 1.6; }
  .post { text-decoration: none; }
  .post h3 { font-size: 13px; margin: 6px 0 0; line-height: 1.45; }

  .post-back { margin-top: 28px; font-size: 12px; }

  .post-cta { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
  .dr-kicker { color: #8f8f88; }
  .post-cta-lead { color: #c8c8c0; margin: 0; max-width: 52ch; }

  @media (max-width: 1000px) {
    /* The rail is dropped, not stacked. A contents list that scrolls past above the article it
       indexes is decoration; the progress bar still gives position on small screens. */
    .post-grid { grid-template-columns: 1fr; gap: 0; }
    .toc { display: none; }
  }
  @media (max-width: 900px) {
    .post-cta { grid-template-columns: 1fr; }
    .rel { grid-template-columns: 1fr; }
  }
</style>

<script>
  /* Reading progress + active TOC heading.
     Both are passive listeners and both no-op when their element is absent, so this same script
     is safe on a post with no TOC (fewer than three h2s) — see the render condition. */
  const fill = document.getElementById('rpFill') as HTMLElement | null;
  const article = document.querySelector('.prose') as HTMLElement | null;
  const links = Array.from(document.querySelectorAll('.toc-a')) as HTMLAnchorElement[];
  const heads = links
    .map((a) => document.getElementById(a.dataset.toc || ''))
    .filter(Boolean) as HTMLElement[];

  let ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      ticking = false;
      if (fill && article) {
        const start = article.offsetTop;
        /* Denominator is the article's own scrollable span, not the whole document: with the CTA
           and related-posts sections below, page height would peg the bar at ~70% at the end of
           the actual reading. */
        const span = Math.max(1, article.offsetHeight - window.innerHeight * 0.4);
        const done = Math.min(1, Math.max(0, (window.scrollY - start) / span));
        fill.style.width = (done * 100).toFixed(1) + '%';
      }
      if (heads.length) {
        /* The heading nearest the top BUT already past it — plain "first visible" marks the next
           section active while you are still reading the previous one. */
        let idx = 0;
        heads.forEach((h, i) => { if (h.getBoundingClientRect().top <= 120) idx = i; });
        links.forEach((a, i) => a.classList.toggle('on', i === idx));
      }
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScroll();

  const copy = document.getElementById('copyLink');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      const prev = copy.textContent;
      copy.textContent = 'Copied ✓';
      setTimeout(() => { copy.textContent = prev; }, 1600);
    } catch {
      /* Clipboard is permission-gated and blocked outright in some in-app browsers. Say so rather
         than silently appearing to have worked. */
      copy.textContent = 'Press Ctrl+C';
    }
  });
</script>
