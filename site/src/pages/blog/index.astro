---
import Base from '../../layouts/Base.astro';
import Waitlist from '../../components/Waitlist.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog" path="/blog" description="Plain-English guides to the Pakistan Stock Exchange — how to read a company, understand a sector, and invest with your eyes open.">
  <section class="section-tight page-hero">
    <div class="wrap center">
      <p class="eyebrow">Blog</p>
      <h1>The market, explained.</h1>
      <p class="lead">
        Plain-English guides to reading PSX companies, sectors and the numbers that matter.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      {
        posts.length === 0 ? (
          <div class="empty center">
            <div class="card empty-card">
              <span class="pill"><span class="dot" />Coming soon</span>
              <h2>Guides are on the way.</h2>
              <p class="muted">
                We’re writing clear, honest explainers on how to read PSX companies and sectors —
                the kind of thing we wish existed when we started. Join the list and we’ll tell you
                when the first ones land.
              </p>
              <div class="empty-wl"><Waitlist source="blog" compact /></div>
            </div>
          </div>
        ) : (
          <div class="grid posts">
            {posts.map((p) => (
              <a class="card post" href={`/blog/${p.id}/`}>
                {p.data.cluster && <span class="post-cluster mono">{p.data.cluster}</span>}
                <h3>{p.data.title}</h3>
                <p class="muted">{p.data.description}</p>
                <time class="post-date muted" datetime={p.data.pubDate.toISOString()}>
                  {p.data.pubDate.toLocaleDateString('en-PK', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  .empty-card { max-width: 560px; margin: 0 auto; }
  .empty-card .pill { margin-bottom: 16px; }
  .empty-wl { margin-top: 28px; display: flex; justify-content: center; }
  .posts { grid-template-columns: repeat(3, 1fr); }
  .post { text-decoration: none; color: var(--ink); transition: transform 0.14s ease, box-shadow 0.18s ease; }
  .post:hover { text-decoration: none; transform: translateY(-3px); box-shadow: var(--shadow); }
  .post-cluster { font-size: 0.7rem; color: var(--primary-ink); text-transform: uppercase; letter-spacing: 0.1em; }
  .post h3 { margin: 10px 0 8px; font-size: 1.14rem; }
  .post-date { font-size: 0.82rem; display: block; margin-top: 14px; }
  @media (max-width: 860px) { .posts { grid-template-columns: 1fr; } }
</style>
