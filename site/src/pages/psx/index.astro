---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../site.config.ts';
import data from '../../data/public/tickers.json';

/* THE /psx/ HUB — Layer 1 (docs/ORGANIC_GROWTH_PLAN.md).
 *
 * Two jobs. For a reader it is the way into the covered companies. For search it is the pillar
 * that passes authority down to each ticker page and gives every one of them a parent — the
 * breadcrumb on [ticker].astro points here, so without this file all 19 pages would link to a
 * 404, which is exactly the kind of thing that suppresses a new programmatic layer.
 *
 * Grouped by sector rather than listed flat: a flat A-Z of eventually ~450 names is a directory,
 * while sector groupings are how someone actually looks for a company, and they pre-shape the
 * sector hub pages that phase 2 adds.
 */

type Ticker = {
  symbol: string; name: string; sector: string; indices: string[];
  liquidity: string | null; div_yield: string | null; as_of: string | null;
};

const ALL = (data as any).tickers as Record<string, Ticker>;
const list = Object.values(ALL);

const bySector = new Map<string, Ticker[]>();
for (const t of list) {
  if (!bySector.has(t.sector)) bySector.set(t.sector, []);
  bySector.get(t.sector)!.push(t);
}
const sectors = [...bySector.entries()].sort((a, b) => a[0].localeCompare(b[0]));

const asOf = list.find((t) => t.as_of)?.as_of ?? null;
const fmtDate = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-PK', { year: 'numeric', month: 'short', day: 'numeric' });

const SECTOR_ICON: Record<string, string> = {
  'Commercial Banks': 'portfolio',
  Cement: 'sectors',
  Fertilizer: 'sectors',
  'Oil & Gas Exploration Companies': 'macro',
  'Oil & Gas Marketing Companies': 'macro',
  'Power Generation & Distribution': 'macro',
  'Technology & Communication': 'tools',
  'Automobile Assembler': 'sectors',
  Tobacco: 'sectors',
  'Food & Personal Care Products': 'sectors',
};
const iconFor = (s: string) => SECTOR_ICON[s] ?? 'sectors';

const description =
  `Pakistan Stock Exchange companies Henneth covers, grouped by sector — dividend records, ` +
  `index membership and model fair value. Research, not advice.`;

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'PSX companies covered by Henneth',
  numberOfItems: list.length,
  itemListElement: list.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${t.name} (${t.symbol})`,
    url: new URL(`/psx/${t.symbol.toLowerCase()}/`, site.url).href,
  })),
};

/* No BreadcrumbList here — Base derives it from `path`, and two of them on one page is a conflict
   Google resolves by ignoring the trail. */
---

<Base title="PSX companies" description={description} path="/psx/" active="">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
  </Fragment>

  <section class="section-tight ph">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><b>PSX companies</b>
      </nav>
      <p class="kicker">Companies</p>
      <h1>Every company, read the same way</h1>
      <p class="lead ph-lead">
        The Pakistan Stock Exchange, company by company — what the business is, what it has
        actually paid out, and how the desk's valuation models sit against today's price. The same
        method applied to every name, so two companies can be compared rather than argued about.
      </p>
      {asOf && (
        <p class="asof muted">
          <Icon name="clock" size={13} /> Figures as of the {fmtDate(asOf)} session ·
          {' '}{list.length} companies live · more added in batches
        </p>
      )}
    </div>
  </section>

  {sectors.map(([sector, rows]) => (
    <section class="wrap grp">
      <p class="kicker grp-k"><Icon name={iconFor(sector)} size={14} /> {sector}</p>
      <div class="tilegrid cos">
        {rows.map((t) => (
          <a class="co tile" href={`/psx/${t.symbol.toLowerCase()}/`}>
            <span class="co-sym">{t.symbol}</span>
            <span class="co-name">{t.name}</span>
            <span class="co-meta muted">
              {t.div_yield ? `${t.div_yield} yield` : 'no payout record'}
              {t.liquidity ? ` · ${t.liquidity} liquidity` : ''}
            </span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="section band-dark">
    <div class="wrap psx-cta">
      <div>
        <p class="kicker dr-kicker">The desk</p>
        <h2>These pages are the summary. The desk is the working.</h2>
        <p class="lead psx-cta-lead">
          Fair value four ways with the maths shown, strategies tested on ~19 years of each stock's
          own history, and an analyst room that argues both sides before the chair calls it.
        </p>
      </div>
      <a class="btn" href={`${site.appUrl}/?auth=signup`} rel="noopener"
         data-ev="desk_click" data-ev-from="psx_index">Open the desk</a>
    </div>
  </section>
</Base>

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 18px; }
  .crumbs a { color: var(--ink-3); text-decoration: none; }
  .crumbs a:hover { color: var(--ink-1); }
  .ph-lead { max-width: 64ch; }
  .asof { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 16px; display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

  .grp { margin-bottom: 30px; }
  .grp-k { margin-bottom: 12px; }
  .cos { grid-template-columns: repeat(4, 1fr); }
  .co { text-decoration: none; gap: 4px; }
  .co-sym { font-family: var(--font-mono); font-size: 13px; font-weight: 800; letter-spacing: 0.06em; }
  .co-name { font-size: 11.5px; line-height: 1.45; color: var(--ink-2); flex: 1; }
  .co-meta { font-size: 9.5px; letter-spacing: 0.05em; text-transform: uppercase; margin-top: 4px; }

  .psx-cta { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: center; }
  .dr-kicker { color: #8f8f88; }
  .psx-cta-lead { color: #c8c8c0; margin: 0; max-width: 56ch; }

  @media (max-width: 1000px) { .cos { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) { .psx-cta { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .cos { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    /* The directory is a list of company names, and the name is the whole reason to tap the row.
       At 11.5px over a 9.5px sector line it read as caption text on a phone. Both go up, and the
       breadcrumb gets a row tall enough to be a target rather than a word. */
    .crumbs { font-size: 11px; }
    .crumbs a { display: inline-flex; align-items: center; min-height: 44px; }
    .asof { font-size: 11px; }
    .co-name { font-size: 13px; }
    .co-meta { font-size: 11px; }
  }
</style>
