---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" path="/404" noindex={true}>
  <section class="section center">
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>That page moved on</h1>
      <p class="lead nf">The page you are after isn't here — but the desk is.</p>
      <div class="nf-cta">
        <a href="/" class="btn btn-solid">Back home</a>
        <a href="/plans" class="btn">See the plans</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .center { text-align: center; }
  .nf { max-width: 420px; margin: 0 auto 22px; }
  .nf-cta { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
</style>
