---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

/* Last element on each row is the sprite id — see IconSprite.astro. */
const pipeline = [
  ['01', 'Research', 'Filings, broker notes and the news log are read and summarised per name — sources, never memory.', 'research'],
  ['02', 'Value', 'Four independent models run: peer P/E, earnings power, Graham and DDM, each with full working.', 'value'],
  ['03', 'Backtest', 'Any rule or signal is tested across ~19 years of PSX history before it earns a place.', 'auditor'],
  ['04', 'Debate', 'The Desk Room argues both sides; a Chair issues a house view with an explicit dissent.', 'deskroom'],
  ['05', 'Score', 'The call is dated with a falsifiable expectation, then graded against the outcome.', 'scores'],
];

const philosophy = [
  ['Multiple lenses, no black box', 'No single model decides. Four methods triangulate a fair-value band; where they disagree, the disagreement itself is the signal.', 'value'],
  ['Anchored to the risk-free rate', 'Earnings power is judged against the prevailing bond yield, so a stock is never called cheap in a vacuum.', 'macro'],
  ['Evidence over narrative', 'A compelling story is not a reason. Every claim ties back to a filing, a price series, or a tested rule.', 'research'],
  ['Unknown stays unknown', 'If a number isn’t in the data layer, the desk renders it as unknown rather than guessing a plausible figure.', 'nofabricate'],
  ['No lookahead, ever', 'A signal at a given bar may use only data available at that bar’s close. Fills come from the next open — never a price the rule could not have seen.', 'clock'],
  ['Costs assumed per stock', 'Friction is estimated name by name from the spread, because a flat cost assumption flatters exactly the thin stocks that momentum rules pick.', 'tradecost'],
  ['Frozen once live', 'A strategy that has published a backtest cannot be edited. Changing a rule means a new version with a fresh record — so old results can never be quietly invalidated.', 'selfcheck'],
  ['Even the sky gets tested', 'The astrology lens is held to the same bar as every rule here: written down first, permutation-tested, multiplicity-corrected, and published whatever it shows.', 'astro'],
];

/* Figures below are read from state/astro_backtest.json. Update them from that file, never by
   hand — the whole point of this section is that the number is the measured one. */
const astroFacts = [
  ['2,589', 'hypotheses tested'],
  ['101', 'subjects, tested stock by stock'],
  ['4,893', 'trading days (2007–2026)'],
  ['143', 'raw hits at p ≤ .05'],
  ['129.5', 'expected by chance alone'],
  ['0', 'survived multiplicity correction'],
];

const principles = [
  ['01', 'Research, not advice', 'The desk never says buy or sell, never promises a return. It briefs; you decide.'],
  ['02', 'Numbers only from the data layer', 'No price, date or dividend is quoted from memory. Sources back every figure.'],
  ['03', 'Every call is dated and falsifiable', 'A view without a date and a disproof condition is an opinion, not research.'],
  ['04', 'The desk grades itself in public', 'Its own calls sit on the same leaderboard as brokers’ — hits and misses both.'],
  ['05', 'It never places orders', 'Execution is manual and yours. The desk has no path to your brokerage.'],
];
---

<Base
  title="Research"
  path="/research"
  active="research"
  description="How the Henneth desk reasons: the pipeline every PSX ticker runs through, the valuation philosophy, and the rules the desk holds itself to."
>
  <section class="section-tight ph">
    <div class="wrap">
      <p class="kicker">Research · How the desk reasons</p>
      <h1>The reasoning is the product</h1>
      <p class="lead ph-lead">
        The desk never hands you a number without the working behind it. This is how a call is
        built — the pipeline every ticker runs through, the philosophy behind each valuation, and
        the rules the desk holds itself to.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="tilegrid pipe">
      {pipeline.map(([n, t, d, ic]) => (
        <div class="tile">
          <span class="tile-i"><Icon name={ic} size={20} /></span>
          <div class="label muted">{n}</div>
          <h3>{t}</h3>
          <p class="muted pipe-d">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">How the desk values a stock</p>
      <h2>Four lenses, and the honesty to disagree</h2>
      <div class="tilegrid phil">
        {philosophy.map(([t, d, ic]) => (
          <div class="tile">
            <span class="tile-i"><Icon name={ic} size={20} /></span>
            <h3>{t}</h3>
            <p class="muted phil-d">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sample note: TEMPLATE, deliberately without a real company or figures.
       A dated price expectation on a named stock would be a call, not a sample. -->
  <section class="section band-panel">
    <div class="wrap note-grid">
      <div>
        <p class="kicker">Sample research note</p>
        <h2>A call you can check, line by line</h2>
        <p class="lead">
          Every note states its expectation and a date, cites the evidence, and lists what would
          prove it wrong. When the window closes, it is graded — automatically, in public.
        </p>
        <ul class="pts">
          <li>A dated expectation, stated up front</li>
          <li>The evidence the call rests on</li>
          <li>The condition that would prove it wrong</li>
        </ul>
      </div>

      <div class="mock note">
        <div class="mock-bar">
          <span class="label">Note · structure</span>
          <span class="mock-tag">Template</span>
        </div>
        <div class="note-b">
          <div class="note-h">
            <span class="label">The expectation</span>
            <span class="badge"><span class="dot"></span>Dated</span>
          </div>
          <p class="note-p">
            The desk expects &lt;name&gt; to &lt;stated move&gt; within &lt;window&gt;, if
            &lt;condition&gt; confirms.
          </p>
          <hr class="hair" />
          <div class="label">Evidence</div>
          {['Consensus fair value', 'Earnings power vs 12M yield', 'Predictability rank'].map((k) => (
            <div class="note-row"><span class="muted">{k}</span><span class="muted">—</span></div>
          ))}
          <hr class="hair" />
          <div class="falsified">
            <div class="label dn">Falsified if</div>
            <p class="note-p">
              Price closes below &lt;level&gt; for &lt;n&gt; sessions, or the quarter misses on
              margins.
            </p>
          </div>
          <p class="mock-note muted">
            Structure of a real note. Live notes carry the actual name, figures and dates — computed
            from the data layer, never written by hand.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* THE WORKED EXAMPLE. Every other page describes the method; this shows it producing a result
      the desk did not want. That is the strongest evidence the method is real. */}
  <section class="section band-dark astro-proof">
    <div class="wrap">
      <p class="kicker dr-kicker">The method, applied to its hardest case</p>
      <h2>We tested astrology. It failed. Here is the result anyway.</h2>
      <p class="lead dr-lead astro-p-lead">
        The astrology lens is the easiest thing on this desk to sell and the easiest to fake, which
        makes it the honest test of whether any of the rules above are real. So it ran the full
        gauntlet: traditional claims recorded first, then a circular-shift permutation test on the
        condition mask — preserving both the autocorrelation of returns and the block shape of the
        astro windows — stock by stock, never averaged into sectors where a single name’s effect
        could hide.
      </p>

      <div class="astro-facts">
        {astroFacts.map(([n, l], i) => (
          <div class:list={['af', { 'af-zero': i === astroFacts.length - 1 }]}>
            <span class="af-n pixel">{n}</span>
            <span class="af-l">{l}</span>
          </div>
        ))}
      </div>

      <p class="astro-p-note">
        143 raw hits against 129.5 expected by chance is not a signal — it is what noise looks like.
        Nothing survived Bonferroni, nothing survived FDR, and nothing replicated.
        <b> The desk publishes this rather than hiding it</b>, and the lens is barred from
        generating or gating a single trade setup. If a condition ever does survive, the evidence
        will be published on exactly the same terms.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker">The rules</p>
      <h2>The rules the desk holds itself to</h2>
      <div class="rules">
        {principles.map(([n, t, d]) => (
          <div class="rule">
            <span class="rule-n pixel">{n}</span>
            <div>
              <h3>{t}</h3>
              <p class="muted rule-d">{d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-dark center">
    <div class="wrap">
      <h2>See the reasoning on any PSX name</h2>
      <p class="lead cta-lead">Start free and read a full research note, working and all.</p>
      <div class="cta-row">
        <a href="/plans" class="btn">Get started</a>
        <a href="/features" class="btn btn-ghost">See the features</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .ph-lead { max-width: 680px; }
  .pipe { grid-template-columns: repeat(5, 1fr); }
  .pipe-d, .phil-d { font-size: 11px; margin: 8px 0 0; }
  .phil { grid-template-columns: repeat(2, 1fr); margin-top: 20px; }

  .note-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .pts { list-style: none; padding: 0; margin: 18px 0 0; }
  .pts li { font-size: 11.5px; padding: 9px 0 9px 18px; position: relative; border-top: 1px dotted var(--hair); }
  .pts li::before { content: '✓'; position: absolute; left: 0; color: var(--up); font-weight: 700; }

  .mock-bar { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: var(--rule); background: var(--panel-2); }
  .mock-tag { font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .note-b { padding: 16px; }
  .note-h { display: flex; justify-content: space-between; align-items: center; }
  .note-p { font-size: 11.5px; margin: 10px 0; }
  .note-row { display: flex; justify-content: space-between; font-size: 11px; padding: 8px 0; border-bottom: 1px dotted var(--hair); }
  .falsified { border-left: 2px solid var(--dn); padding-left: 12px; }
  .mock-note { font-size: 9.5px; margin: 14px 0 0; }

  /* THE NULL-RESULT BAND. The zero is the only coloured figure on the page — it is the finding. */
  .astro-proof { position: relative; overflow: hidden; }
  .astro-proof > * { position: relative; z-index: 1; }
  .astro-proof h2 { max-width: 780px; }
  .astro-p-lead { max-width: 780px; }
  .astro-facts {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5px;
    background: #3a3a37; border: 1.5px solid #3a3a37; margin: 26px 0 22px;
  }
  .af { background: #101314; padding: 18px; display: flex; flex-direction: column; gap: 7px; }
  .af-n { font-size: 28px; line-height: 1; color: var(--bg); font-variant-numeric: tabular-nums; }
  .af-l { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #8f8f88; }
  .af-zero .af-n, .af-zero .af-l { color: #55a16b; }
  .astro-p-note { font-size: 12px; line-height: 1.8; color: #c8c8c0; max-width: 780px; }
  .astro-p-note b { color: var(--bg); }

  .astro-proof::before {
    content: ''; position: absolute; inset: -40% -12% auto -12%; height: 180%;
    pointer-events: none; opacity: 0.4; z-index: 0;
    background-image:
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px),
      radial-gradient(circle, #6f6f88 1px, transparent 1.6px),
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px),
      radial-gradient(circle, #55a16b 1px, transparent 1.6px),
      radial-gradient(circle, #5a5a55 1px, transparent 1.6px);
    background-repeat: no-repeat;
    background-position: 9% 16%, 71% 11%, 38% 61%, 88% 71%, 24% 86%;
    animation: skyDrift 90s linear infinite;
  }
  @keyframes skyDrift { to { transform: translate3d(5%, -3%, 0); } }
  @media (prefers-reduced-motion: reduce) { .astro-proof::before { animation: none; } }

  .rules { margin-top: 20px; border-top: var(--rule); }
  .rule { display: flex; gap: 20px; padding: 20px 0; border-bottom: var(--rule); }
  .rule-n { font-size: 26px; color: var(--ink-3); min-width: 46px; }
  .rule-d { font-size: 11.5px; margin: 6px 0 0; max-width: 720px; }

  .center { text-align: center; }
  .cta-lead { max-width: 520px; margin: 0 auto 20px; color: #c8c8c0; }
  .cta-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1000px) { .pipe { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 900px) { .note-grid, .phil { grid-template-columns: 1fr; gap: 28px; } .astro-facts { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .astro-facts { grid-template-columns: 1fr; } }
</style>
