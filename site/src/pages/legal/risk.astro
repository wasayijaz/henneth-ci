---
import Base from '../../layouts/Base.astro';
import { site } from '../../site.config.ts';
---

<Base title="Risk Disclosure" path="/legal/risk" noindex={true} description="PSX Desk Risk Disclosure.">
  <section class="section-tight">
    <div class="wrap legal">
      <p class="eyebrow">Legal</p>
      <h1>Risk Disclosure</h1>
      <div class="legal-notice">
        <strong>Draft — pending legal review.</strong> This page is a placeholder. The final
        disclosure will be reviewed by a Pakistan-licensed lawyer before any paid plan opens.
      </div>

      <h2>Investing carries risk</h2>
      <p>
        Investing in equities on the Pakistan Stock Exchange carries risk, including the partial or
        total loss of your capital. Prices can fall as well as rise, and can move sharply.
      </p>

      <h2>Not advice</h2>
      <p>
        {site.name} provides educational research and analytics only. It does not provide personalised
        investment advice, and nothing here should be taken as a recommendation to buy, sell or hold
        any security.
      </p>

      <h2>Past performance</h2>
      <p>
        Any historical figures, backtests or scored track records shown on {site.name} describe the
        past. Past performance does not predict or guarantee future results, and the desk’s own scored
        record includes losses.
      </p>

      <h2>Data</h2>
      <p>
        Market data may be delayed and may contain errors. Always confirm prices and corporate actions
        with your broker before acting.
      </p>

      <h2>Your responsibility</h2>
      <p>
        All investment decisions are yours alone. Consider taking independent, licensed financial
        advice suited to your circumstances.
      </p>

      <p class="legal-contact muted">
        Questions: <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 720px; margin: 0 auto; }
  .legal h2 { margin-top: 32px; font-size: 1.35rem; }
  .legal-notice {
    background: var(--accent-tint);
    border: 1px solid #e8cf9a;
    border-radius: var(--radius-sm);
    padding: 16px 18px;
    margin: 20px 0 8px;
    font-size: 0.92rem;
    color: #7a5a12;
  }
  .legal-contact { margin-top: 36px; font-size: 0.9rem; }
</style>
