---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.ts';
---
<Base title="Contact" path="/contact" description="Contact Henneth — broker and institutional enquiries, press, feedback.">
  <section class="section-tight">
    <div class="wrap ct">
      <p class="kicker">Contact</p>
      <h1>Talk to us</h1>
      <p class="lead ct-lead">
        Broker and institutional enquiries, press, or feedback on the desk — this reaches us
        directly.
      </p>
      <div class="tilegrid ct-grid">
        <a class="ct-i" href={`mailto:${site.contactEmail}?subject=Broker%20plan`}>
          <span class="label muted">Brokers &amp; institutions</span>
          <span class="ct-v">{site.contactEmail}</span>
          <span class="muted ct-d">Multi-seat access, API and white-label research.</span>
        </a>
        <a class="ct-i" href={`mailto:${site.contactEmail}`}>
          <span class="label muted">Everything else</span>
          <span class="ct-v">{site.contactEmail}</span>
          <span class="muted ct-d">Questions, press, feedback, or a bug you found.</span>
        </a>
        <a class="ct-i" href={site.social.x} rel="noopener">
          <span class="label muted">On X</span>
          <span class="ct-v">@MWasayI</span>
          <span class="muted ct-d">Day-to-day notes on the market and the build.</span>
        </a>
      </div>
      <p class="muted ct-fine">For anything involving your account or data, please email us directly.</p>
    </div>
  </section>
</Base>
<style>
  .ct { max-width: 900px; }
  .ct-lead { max-width: 560px; }
  .ct-grid { grid-template-columns: repeat(3, 1fr); margin-top: 24px; }
  .ct-i { display: flex; flex-direction: column; gap: 8px; text-decoration: none; }
  .ct-i:hover { background: var(--panel-2); }
  .ct-v { font-size: 13px; font-weight: 700; }
  .ct-d { font-size: 10.5px; }
  .ct-fine { font-size: 10.5px; margin-top: 20px; }
  @media (max-width: 860px) { .ct-grid { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var types = ['broker', 'general', 'social'];
    document.querySelectorAll('.ct-i').forEach(function (el, i) {
      el.addEventListener('click', function () {
        window.posthog?.capture('contact_link_clicked', {
          contact_type: types[i] || 'general'
        });
      });
    });
  });
</script>
